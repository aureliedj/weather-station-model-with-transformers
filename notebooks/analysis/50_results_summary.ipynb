    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 5. σₑ comparison: MAE (Huber) vs Probabilistic MAE (NLL)\\n\",\n",
    "    \"\\n\",\n",
    "    \"σₑ = std(ŷ − y), computed per station then reported as pooled and median.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"s5\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-09-01T21:51:33.624659Z\",\n",
    "     \"start_time\": \"2026-09-01T21:51:32.451359Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# ── σₑ per-station, then pooled and median ──\\n\",\n",
    "    \"KEY_LEADS_5 = [(1, \\\"+30m\\\"), (6, \\\"+3h\\\"), (12, \\\"+6h\\\")]\\n\",\n",
    "    \"\\n\",\n",
    "    \"def station_sd(a, ki, vi):\\n\",\n",
    "    \"    cnt = a[\\\"mod_all_cnt\\\"][ki, :, vi]\\n\",\n",
    "    \"    sgn = a[\\\"mod_all_signed_phys\\\"][ki, :, vi]\\n\",\n",
    "    \"    sq  = a[\\\"mod_all_sumsq_phys\\\"][ki, :, vi]\\n\",\n",
    "    \"    n = np.maximum(cnt, 1)\\n\",\n",
    "    \"    sd = np.sqrt(np.maximum(sq / n - (sgn / n)**2, 0))\\n\",\n",
    "    \"    return np.where(cnt > 0, sd, np.nan)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Per-station σₑ — MEDIAN across stations\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 65)\\n\",\n",
    "    \"for vi, v in enumerate(VARS):\\n\",\n",
    "    \"    print(f\\\"\\\\n  {v} [{C.UNITS[v]}]:\\\")\\n\",\n",
    "    \"    print(f\\\"  {'Model':25s}\\\" + \\\"\\\".join(f\\\"  {lbl:>10s}\\\" for _, lbl in KEY_LEADS_5))\\n\",\n",
    "    \"    for r in [\\\"v27\\\", \\\"v30-nll\\\"]:\\n\",\n",
    "    \"        label = C.MODELS[r][0]\\n\",\n",
    "    \"        vals = [f\\\"{np.nanmedian(station_sd(AGG0[r], ki, vi)):10.4f}\\\" for ki, _ in KEY_LEADS_5]\\n\",\n",
    "    \"        print(f\\\"  {label:25s}\\\" + \\\"\\\".join(f\\\"  {v}\\\" for v in vals))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Plot\\n\",\n",
    "    \"fig, axes = plt.subplots(1, NV, figsize=(4.5 * NV, 3.5))\\n\",\n",
    "    \"leads_min = GRID * 10 / 60\\n\",\n",
    "    \"for vi, (ax, v) in enumerate(zip(axes, VARS)):\\n\",\n",
    "    \"    for r, ls in [(\\\"v27\\\", \\\"-\\\"), (\\\"v30-nll\\\", \\\"--\\\")]:\\n\",\n",
    "    \"        label = C.MODELS[r][0]; col = C.MODELS[r][1]\\n\",\n",
    "    \"        sd_med = [np.nanmedian(station_sd(AGG0[r], ki, vi)) for ki in range(K)]\\n\",\n",
    "    \"        ax.plot(leads_min, sd_med, color=col, linestyle=ls, label=label, linewidth=1.5)\\n\",\n",
    "    \"    ax.set_title(f\\\"{v} [{C.UNITS[v]}]\\\", fontsize=10)\\n\",\n",
    "    \"    ax.set_xlabel(\\\"Lead time (h)\\\")\\n\",\n",
    "    \"    if vi == 0: ax.set_ylabel(\\\"median σₑ\\\")\\n\",\n",
    "    \"    ax.grid(alpha=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"axes[-1].legend(fontsize=9)\\n\",\n",
    "    \"fig.suptitle(\\\"Error spread vs lead time: median over stations of the per-station error SD σₑ = std(ŷ−y)\\\\n\\\"\\n\",\n",
    "    \"             \\\"MAE Transformer (Huber loss) vs Probabilistic MAE (Gaussian NLL), MR=0\\\", fontsize=12, y=1.04)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"C.save_fig(fig, \\\"summary_sd_huber_vs_nll\\\")\\n\",\n",
    "    \"plt.show(); plt.close(fig)\"\n",
    "   ],\n",
