    "    \"    print(header)\\n\",\n",
    "    \"    for dname, dvals in descriptors.items():\\n\",\n",
    "    \"        row = f\\\"  {dname:20s}\\\"\\n\",\n",
    "    \"        for vi in range(NV):\\n\",\n",
    "    \"            cnt = AGG0[r][\\\"mod_all_cnt\\\"][ki, :, vi]\\n\",\n",
    "    \"            s   = AGG0[r][\\\"mod_all_sum_phys\\\"][ki, :, vi]\\n\",\n",
    "    \"            mae = np.where(cnt > 0, s / np.maximum(cnt, 1), np.nan)\\n\",\n",
    "    \"            valid = ~np.isnan(mae) & ~np.isnan(dvals)\\n\",\n",
    "    \"            if np.sum(valid) > 10:\\n\",\n",
    "    \"                corr = np.corrcoef(dvals[valid], mae[valid])[0, 1]\\n\",\n",
    "    \"                row += f\\\"  {corr:+12.3f}\\\"\\n\",\n",
    "    \"            else:\\n\",\n",
    "    \"                row += f\\\"  {'n/a':>12s}\\\"\\n\",\n",
    "    \"        print(row)\"\n",
