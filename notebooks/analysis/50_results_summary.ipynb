    "    \"\\n\",\n",
    "    \"# ── Correlation table ──\\n\",\n",
    "    \"descriptors = {\\n\",\n",
    "    \"    \\\"3rd-NN dist (km)\\\": nn3 / 1000,\\n\",\n",
