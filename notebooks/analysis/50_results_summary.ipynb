    "     \"start_time\": \"2026-09-01T21:51:27.641098Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"rows = []\\n\",\n",
    "    \"for r in ORDER:\\n\",\n",
    "    \"    a = AGG0[r]; label = C.MODELS[r][0]\\n\",\n",
    "    \"    for vi, v in enumerate(VARS):\\n\",\n",
    "    \"        cnt = a[\\\"mod_all_cnt\\\"][:, :, vi]\\n\",\n",
    "    \"        s   = a[\\\"mod_all_sum_phys\\\"][:, :, vi]\\n\",\n",
    "    \"        m0 = cnt[0] > 0\\n\",\n",
    "    \"        mae0 = np.sum(s[0, m0]) / np.sum(cnt[0, m0])\\n\",\n",
    "    \"        mfc = cnt[1:] > 0\\n\",\n",
    "    \"        mae_fc = np.sum(s[1:][mfc]) / np.sum(cnt[1:][mfc])\\n\",\n",
    "    \"        mall = cnt > 0\\n\",\n",
    "    \"        mae_all = np.sum(s[mall]) / np.sum(cnt[mall])\\n\",\n",
    "    \"        rows.append(dict(model=label, variable=v, unit=C.UNITS[v],\\n\",\n",
    "    \"                         mae_d0=mae0, mae_fc=mae_fc, mae_all=mae_all))\\n\",\n",
    "    \"\\n\",\n",
    "    \"df1 = pd.DataFrame(rows)\\n\",\n",
    "    \"for c in [\\\"mae_d0\\\", \\\"mae_fc\\\", \\\"mae_all\\\"]:\\n\",\n",
    "    \"    df1[c] = df1[c].map(lambda x: f\\\"{x:.4f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Overall MAE at MR=0.0 (physical units)\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
