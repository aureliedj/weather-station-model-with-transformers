    "    \"ki = REF_KI\\n\",\n",
    "    \"print(f\\\"\\\\nPearson r(descriptor, station MAE) at +3h, MR=0.0:\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 90)\\n\",\n",
    "    \"for r in [\\\"v31\\\", \\\"v27\\\", \\\"v32-blind\\\"]:\\n\",\n",
