    "    \"    ax.grid(alpha=.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"axes[0].set_ylabel(\\\"MAE [phys]\\\", fontsize=9)\\n\",\n",
    "    \"axes[-1].legend(fontsize=5.5, loc=\\\"upper left\\\", ncol=1)\\n\",\n",
    "    \"fig.suptitle(\\\"MAE Transformer MAE vs lead time — stations with ≥2 neighbours\\\\n\\\"\\n\",\n",
    "    \"             \\\"Solid: MR=0.0 | Dashed: MR=0.5\\\", fontsize=12)\\n\",\n",
    "    \"C.save_fig(fig, \\\"46_mae_by_nn_cluster\\\")\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"plt.close(fig)\\n\"\n",
    "   ],\n",
