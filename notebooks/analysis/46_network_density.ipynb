    "     \"end_time\": \"2026-09-02T10:37:09.128785Z\",\n",
    "     \"start_time\": \"2026-09-02T10:37:09.101549Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# ── Summary: correlation table for all predictor × metric combos ────────────\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"SA × N INTERACTION (MR=0.0): SA gain vs density predictors\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"df_sa = pd.DataFrame(sa_corr_table)\\n\",\n",
    "    \"if len(df_sa) > 0:\\n\",\n",
    "    \"    pivot = df_sa.pivot(index=\\\"predictor\\\", columns=\\\"variable\\\", values=\\\"r\\\")\\n\",\n",
