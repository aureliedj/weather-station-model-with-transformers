    "    \"        ax = axes[pi, vi]\\n\",\n",
    "    \"        g = sa_gain[:, vi]\\n\",\n",
    "    \"        valid = np.isfinite(g) & np.isfinite(px)\\n\",\n",
    "    \"        ax.scatter(px[valid], g[valid], s=15, alpha=0.5,\\n\",\n",
    "    \"                   color=\\\"#D9663D\\\", edgecolors=\\\"0.4\\\", linewidths=0.3)\\n\",\n",
    "    \"        ax.axhline(0, ls=\\\":\\\", color=\\\"k\\\", lw=0.7, alpha=0.5)\\n\",\n",
    "    \"        if valid.sum() > 5 and px[valid].std() > 0:\\n\",\n",
    "    \"            sl, ic, r, p, _ = linregress(px[valid], g[valid])\\n\",\n",
    "    \"            xfit = np.linspace(px[valid].min(), px[valid].max(), 50)\\n\",\n",
    "    \"            ax.plot(xfit, sl * xfit + ic, \\\"k--\\\", lw=1.2, alpha=0.7)\\n\",\n",
    "    \"            pstr = f\\\"p={p:.1e}\\\" if p < 0.001 else f\\\"p={p:.3f}\\\"\\n\",\n",
    "    \"            ax.text(0.95, 0.95, f\\\"r={r:.2f}\\\\n{pstr}\\\",\\n\",\n",
    "    \"                    transform=ax.transAxes, fontsize=7, ha=\\\"right\\\",\\n\",\n",
    "    \"                    va=\\\"top\\\", bbox=dict(boxstyle=\\\"round,pad=0.2\\\",\\n\",\n",
    "    \"                    fc=\\\"white\\\", alpha=0.7))\\n\",\n",
    "    \"            sa_corr_table.append({\\\"predictor\\\": pname, \\\"variable\\\": v,\\n\",\n",
    "    \"                                  \\\"r\\\": r, \\\"p\\\": p, \\\"n\\\": int(valid.sum())})\\n\",\n",
    "    \"        if pi == 0:\\n\",\n",
    "    \"            ax.set_title(f\\\"{v}  [{C.UNITS[v]}]\\\", fontsize=10)\\n\",\n",
    "    \"        ax.grid(alpha=.3)\\n\",\n",
    "    \"        if vi == 0:\\n\",\n",
    "    \"            ax.set_ylabel(f\\\"SA gain\\\\n{pname}\\\", fontsize=8)\\n\",\n",
    "    \"        if pi == len(predictors) - 1:\\n\",\n",
    "    \"            ax.set_xlabel(pname, fontsize=8)\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig.suptitle(f\\\"Spatial-attention gain (MAE_blind − MAE_dense) vs \\\"\\n\",\n",
    "    \"             f\\\"network density metrics at {LEAD[REF_KI]} (MR=0.0)\\\",\\n\",\n",
    "    \"             fontsize=12)\\n\",\n",
    "    \"# ── Sync y-axis per variable column across rows ──\\n\",\n",
    "    \"for vi in range(NV):\\n\",\n",
    "    \"    col_axes = [axes[ri, vi] for ri in range(len(predictors))]\\n\",\n",
    "    \"    lo = min(ax.get_ylim()[0] for ax in col_axes)\\n\",\n",
    "    \"    hi = max(ax.get_ylim()[1] for ax in col_axes)\\n\",\n",
    "    \"    for ax in col_axes:\\n\",\n",
    "    \"        ax.set_ylim(lo, hi)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Sync wind components ──\\n\",\n",
    "    \"wu_i, wv_i = VARS.index(\\\"wind_u\\\"), VARS.index(\\\"wind_v\\\")\\n\",\n",
    "    \"lo = min(axes[0, wu_i].get_ylim()[0], axes[0, wv_i].get_ylim()[0])\\n\",\n",
    "    \"hi = max(axes[0, wu_i].get_ylim()[1], axes[0, wv_i].get_ylim()[1])\\n\",\n",
    "    \"for ri in range(axes.shape[0]):\\n\",\n",
    "    \"    axes[ri, wu_i].set_ylim(lo, hi)\\n\",\n",
    "    \"    axes[ri, wv_i].set_ylim(lo, hi)\\n\",\n",
    "    \"C.save_fig(fig, \\\"46_sa_gain_vs_density\\\")\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"plt.close(fig)\\n\",\n",
    "    \"\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
