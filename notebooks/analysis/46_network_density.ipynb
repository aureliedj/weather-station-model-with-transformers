    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"compute_dmae\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-09-02T10:37:05.124437Z\",\n",
    "     \"start_time\": \"2026-09-02T10:36:50.896349Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# ── Compute ΔMAE: local masking vs random control ───────────────────────────\\n\",\n",
    "    \"#\\n\",\n",
    "    \"# ΔMAE = pooled_MAE(HIGH) − pooled_MAE(LOW)\\n\",\n",
    "    \"# where HIGH = (window, station) pairs with > 50% of R-km neighbours masked,\\n\",\n",
    "    \"#       LOW  = pairs with ≤ 50% masked.\\n\",\n",
    "    \"# Only pairs where the target is VISIBLE are included, isolating the effect\\n\",\n",
    "    \"# of local context removal from self-masking.\\n\",\n",
    "    \"#\\n\",\n",
    "    \"# Random control: same statistic with randomly chosen pseudo-neighbours\\n\",\n",
    "    \"# (same degree per station). Repeated N_TRIALS times.\\n\",\n",
    "    \"\\n\",\n",
    "    \"THRESHOLD = 0.5\\n\",\n",
    "    \"N_TRIALS = 50\\n\",\n",
    "    \"rng = np.random.default_rng(42)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Local ΔMAE ──────────────────────────────────────────────────────────────\\n\",\n",
    "    \"dmae_local = {}  # (R, vi, tc_key) -> ΔMAE\\n\",\n",
    "    \"\\n\",\n",
    "    \"for R in RADII_KM:\\n\",\n",
    "    \"    lmc = local_masked_count[R]                          # (Mw, N)\\n\",\n",
    "    \"    n_loc = N_LOCAL[R].astype(np.float32)                # (N,)\\n\",\n",
    "    \"    has_nbr = n_loc > 0                                  # (N,)\\n\",\n",
    "    \"    frac = np.where(has_nbr[None, :],\\n\",\n",
    "    \"                    lmc / np.maximum(n_loc[None, :], 1), -1)  # (Mw, N)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for vi in range(NV):\\n\",\n",
    "    \"        vv = visible_bool & val5[:, :, vi]               # (Mw, N) visible AND valid\\n\",\n",
    "    \"        vv_use = vv.copy()\\n\",\n",
    "    \"        vv_use[:, ~has_nbr] = False                      # exclude isolated stations\\n\",\n",
    "    \"        hi = vv_use & (frac > THRESHOLD)\\n\",\n",
    "    \"        lo = vv_use & (frac <= THRESHOLD)\\n\",\n",
    "    \"        e = err5[:, :, vi]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for tc_key in [\\\"all\\\"] + list(TC_IDX):\\n\",\n",
    "    \"            if tc_key == \\\"all\\\":\\n\",\n",
    "    \"                tc_mask = np.ones(N, dtype=bool)\\n\",\n",
    "    \"            else:\\n\",\n",
    "    \"                tc_mask = np.zeros(N, dtype=bool)\\n\",\n",
    "    \"                tc_mask[TC_IDX[tc_key]] = True\\n\",\n",
    "    \"\\n\",\n",
    "    \"            tc_b = tc_mask[None, :].astype(e.dtype)  # (1, N)\\n\",\n",
    "    \"            s_hi = (e * hi * tc_b).sum()\\n\",\n",
    "    \"            c_hi = (hi & tc_mask[None, :]).sum()\\n\",\n",
    "    \"            s_lo = (e * lo * tc_b).sum()\\n\",\n",
    "    \"            c_lo = (lo & tc_mask[None, :]).sum()\\n\",\n",
    "    \"            if c_hi > 50 and c_lo > 50:\\n\",\n",
    "    \"                dmae_local[(R, vi, tc_key)] = s_hi / c_hi - s_lo / c_lo\\n\",\n",
    "    \"            else:\\n\",\n",
    "    \"                dmae_local[(R, vi, tc_key)] = np.nan\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Local ΔMAE computed.\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Random control ΔMAE ─────────────────────────────────────────────────────\\n\",\n",
    "    \"dmae_rand = {}  # (R, vi) -> (mean, std)\\n\",\n",
    "    \"\\n\",\n",
    "    \"for R in RADII_KM:\\n\",\n",
    "    \"    n_loc = N_LOCAL[R]\\n\",\n",
    "    \"    has_nbr = n_loc > 0\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Pre-compute valid-visible masks per variable\\n\",\n",
    "    \"    VV = {}\\n\",\n",
    "    \"    for vi in range(NV):\\n\",\n",
    "    \"        vv = (visible_bool & val5[:, :, vi]).copy()\\n\",\n",
    "    \"        vv[:, ~has_nbr] = False\\n\",\n",
    "    \"        VV[vi] = vv\\n\",\n",
    "    \"\\n\",\n",
    "    \"    trial_vals = {vi: [] for vi in range(NV)}\\n\",\n",
    "    \"    for trial in range(N_TRIALS):\\n\",\n",
    "    \"        # Build random pseudo-adjacency with same degree per station\\n\",\n",
    "    \"        pseudo_adj = np.zeros((N, N), dtype=np.float32)\\n\",\n",
    "    \"        for i in range(N):\\n\",\n",
    "    \"            ni = int(n_loc[i])\\n\",\n",
    "    \"            if ni == 0:\\n\",\n",
    "    \"                continue\\n\",\n",
    "    \"            others = np.delete(np.arange(N), i)\\n\",\n",
    "    \"            chosen = rng.choice(others, size=min(ni, len(others)), replace=False)\\n\",\n",
    "    \"            pseudo_adj[i, chosen] = 1.0\\n\",\n",
    "    \"\\n\",\n",
    "    \"        pseudo_lmc = masked_bool.astype(np.float32) @ pseudo_adj.T   # (Mw, N)\\n\",\n",
    "    \"        pfrac = np.where(has_nbr[None, :],\\n\",\n",
    "    \"                         pseudo_lmc / np.maximum(n_loc[None, :].astype(np.float32), 1),\\n\",\n",
    "    \"                         -1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for vi in range(NV):\\n\",\n",
    "    \"            vv = VV[vi]\\n\",\n",
    "    \"            hi = vv & (pfrac > THRESHOLD)\\n\",\n",
    "    \"            lo = vv & (pfrac <= THRESHOLD)\\n\",\n",
    "    \"            e = err5[:, :, vi]\\n\",\n",
    "    \"            s_hi, c_hi = (e * hi).sum(), hi.sum()\\n\",\n",
    "    \"            s_lo, c_lo = (e * lo).sum(), lo.sum()\\n\",\n",
    "    \"            if c_hi > 50 and c_lo > 50:\\n\",\n",
    "    \"                trial_vals[vi].append(s_hi / c_hi - s_lo / c_lo)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for vi in range(NV):\\n\",\n",
    "    \"        if trial_vals[vi]:\\n\",\n",
    "    \"            dmae_rand[(R, vi)] = (np.mean(trial_vals[vi]),\\n\",\n",
    "    \"                                  np.std(trial_vals[vi]))\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            dmae_rand[(R, vi)] = (np.nan, np.nan)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(f\\\"  R={R} km: random control done ({N_TRIALS} trials)\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"All ΔMAE computations complete.\\\")\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"main_fig\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-09-02T10:37:05.637352Z\",\n",
    "     \"start_time\": \"2026-09-02T10:37:05.334921Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# ── Main figure: ΔMAE vs masking radius ─────────────────────────────────────\\n\",\n",
    "    \"# X-axis: radius (5, 10, 25, 50, 100 km)\\n\",\n",
    "    \"# Y-axis: ΔMAE = MAE(high local masking) − MAE(low local masking)\\n\",\n",
    "    \"# Lines: terrain classes only. Dashed: random control with ±1σ band.\\n\",\n",
    "    \"fig, axes = plt.subplots(1, NV, figsize=(17, 4.0))\\n\",\n",
    "    \"x = np.arange(len(RADII_KM))\\n\",\n",
    "    \"\\n\",\n",
    "    \"for vi, (ax, v) in enumerate(zip(axes, VARS)):\\n\",\n",
    "    \"    # By terrain class\\n\",\n",
    "    \"    for tc in C.TCLASSES:\\n\",\n",
    "    \"        y_tc = [dmae_local.get((R, vi, tc), np.nan) for R in RADII_KM]\\n\",\n",
    "    \"        ax.plot(x, y_tc, \\\"s--\\\", lw=1.3, ms=5,\\n\",\n",
    "    \"                color=TC_COLORS[tc], label=tc)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Random control with ±1σ band\\n\",\n",
    "    \"    y_rand = np.array([dmae_rand.get((R, vi), (np.nan, 0))[0]\\n\",\n",
    "    \"                       for R in RADII_KM])\\n\",\n",
    "    \"    y_std  = np.array([dmae_rand.get((R, vi), (np.nan, 0))[1]\\n\",\n",
    "    \"                       for R in RADII_KM])\\n\",\n",
    "    \"    ax.plot(x, y_rand, \\\"D:\\\", lw=1.5, ms=5, color=\\\"0.5\\\",\\n\",\n",
    "    \"            label=\\\"Random control\\\")\\n\",\n",
    "    \"    ax.fill_between(x, y_rand - y_std, y_rand + y_std,\\n\",\n",
    "    \"                    color=\\\"0.5\\\", alpha=0.15)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ax.axhline(0, ls=\\\":\\\", color=\\\"k\\\", lw=0.6, alpha=0.5)\\n\",\n",
    "    \"    ax.set_xticks(x)\\n\",\n",
    "    \"    ax.set_xticklabels([str(R) for R in RADII_KM])\\n\",\n",
    "    \"    ax.set_xlabel(\\\"Radius [km]\\\", fontsize=9)\\n\",\n",
    "    \"    ax.set_title(f\\\"{v}  [{C.UNITS[v]}]\\\", fontsize=10)\\n\",\n",
    "    \"    ax.grid(alpha=.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"axes[0].set_ylabel(f\\\"ΔMAE at {LEAD[REF_KI]}\\\\n(high − low local masking)\\\")\\n\",\n",
    "    \"axes[-1].legend(fontsize=5.5, loc=\\\"upper left\\\")\\n\",\n",
    "    \"fig.suptitle(f\\\"Local-masking test, MAE Transformer at MR=0.5, {LEAD[REF_KI]}, visible stations only: MAE(>50% of R-km neighbours masked) − MAE(≤50%)\\\\n\\\"\\n\",\n",
    "    \"             \\\"by terrain class; grey = same statistic with random pseudo-neighbours (mean ±1σ, 50 draws)\\\", y=1.06, fontsize=12)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"C.save_fig(fig, \\\"46_local_masking_dmae\\\")\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"plt.close(fig)\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"masking_ext_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### Extended masking analysis: all 10 radii\\n\",\n",
    "    \"\\n\",\n",
    "    \"Same local-masking ΔMAE computation as above, extended to all 10\\n\",\n",
    "    \"analysis radii. Fewer random-control trials (20) to keep runtime\\n\",\n",
    "    \"manageable. The ΔMAE-vs-radius curve reveals the spatial scale at\\n\",\n",
    "    \"which local context matters most.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"dose_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Dose-response: MAE vs local masking fraction\\n\",\n",
    "    \"\\n\",\n",
    "    \"At R = 50 km, bin (window, station) pairs by the fraction of local\\n\",\n",
    "    \"neighbours masked and plot the pooled MAE in each bin. A monotonic\\n\",\n",
    "    \"increase confirms a causal dose-response relationship between local\\n\",\n",
    "    \"context removal and forecast degradation.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"dose_fig\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-09-02T10:37:05.993041Z\",\n",
    "     \"start_time\": \"2026-09-02T10:37:05.642843Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# ── Dose-response at R=50 km ────────────────────────────────────────────────\\nR_DOSE = 50\\nlmc = local_masked_count[R_DOSE]\\nn_loc = N_LOCAL[R_DOSE].astype(np.float32)\\nhas_nbr = n_loc > 0\\nfrac = np.where(has_nbr[None, :], lmc / np.maximum(n_loc[None, :], 1),\\n                np.nan)  # (Mw, N)\\n\\nFRAC_BINS = np.linspace(0, 1, 6)  # 5 equal bins\\nBIN_LABELS = [f\\\"{FRAC_BINS[i]:.1f}–{FRAC_BINS[i+1]:.1f}\\\"\\n              for i in range(len(FRAC_BINS) - 1)]\\n\\nfig, axes = plt.subplots(1, NV, figsize=(17, 3.5))\\nfor vi, (ax, v) in enumerate(zip(axes, VARS)):\\n    vv = (visible_bool & val5[:, :, vi]).copy()\\n    vv[:, ~has_nbr] = False\\n    e = err5[:, :, vi]\\n\\n    bin_mae = []\\n    for bi in range(len(FRAC_BINS) - 1):\\n        lo_b, hi_b = FRAC_BINS[bi], FRAC_BINS[bi + 1]\\n        if bi < len(FRAC_BINS) - 2:\\n            sel = vv & (frac >= lo_b) & (frac < hi_b)\\n        else:\\n            sel = vv & (frac >= lo_b) & (frac <= hi_b)\\n        if sel.sum() > 0:\\n            bin_mae.append((e * sel).sum() / sel.sum())\\n        else:\\n            bin_mae.append(np.nan)\\n\\n    ax.bar(range(len(BIN_LABELS)), bin_mae, color=\\\"#3A7CA5\\\",\\n           edgecolor=\\\"k\\\", lw=0.5)\\n    ax.set_xticks(range(len(BIN_LABELS)))\\n    ax.set_xticklabels(BIN_LABELS, fontsize=7, rotation=30, ha=\\\"right\\\")\\n    ax.set_title(f\\\"{v}  [{C.UNITS[v]}]\\\", fontsize=10)\\n    ax.grid(alpha=.3, axis=\\\"y\\\")\\n\\naxes[0].set_ylabel(f\\\"MAE at {LEAD[REF_KI]}\\\")\\nfig.suptitle(f\\\"Dose-response: MAE vs fraction of local neighbours masked \\\"\\n             f\\\"(R={R_DOSE} km, v27 MR=0.5)\\\", y=1.04)\\nplt.tight_layout()\\nC.save_fig(fig, \\\"46_dose_response\\\")\\nplt.show()\\nplt.close(fig)\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"agg_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## ΔMAE analysis: MR=0.0 vs MR=0.5 by network density\\n\",\n",
    "    \"\\n\",\n",
    "    \"For each station, compute ΔMAE = MAE(MR=0.5) − MAE(MR=0.0) using\\n\",\n",
    "    \"per-station aggregated statistics. All 155 stations have valid MAE at\\n\",\n",
    "    \"both mask ratios (at MR=0.5, each station is visible in ~50% of\\n\",\n",
    "    \"windows). Neighbour counts at R = 10, 25, 50, 75 km are used to\\n\",\n",
    "    \"assess how ΔMAE scales with local network density.\\n\",\n",
    "    \"\\n\",\n",
    "    \"A second view bins stations by neighbour-count categories and\\n\",\n",
    "    \"compares absolute MAE at MR=0.0 and MR=0.5 side by side.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"agg_impact\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-09-02T10:37:07.248992Z\",\n",
    "     \"start_time\": \"2026-09-02T10:37:05.994196Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# ── Per-station ΔMAE = MAE(MR=0.5) − MAE(MR=0.0) ──────────────────────────\\n\",\n",
    "    \"AGG5 = C.load_agg(\\\"v27\\\", \\\"mr0.50\\\")\\n\",\n",
    "    \"a0 = AGG[\\\"v27\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"COMPARE_RADII = [10, 25, 50, 75]\\n\",\n",
    "    \"NN_COMP = {R: (DIST <= R).sum(axis=1) for R in COMPARE_RADII}\\n\",\n",
    "    \"\\n\",\n",
    "    \"mae_mr0 = np.where(a0[\\\"mod_all_cnt\\\"][REF_KI] > 0,\\n\",\n",
    "    \"                   a0[\\\"mod_all_sum_phys\\\"][REF_KI] /\\n\",\n",
    "    \"                   np.maximum(a0[\\\"mod_all_cnt\\\"][REF_KI], 1),\\n\",\n",
    "    \"                   np.nan)  # (N, NV)\\n\",\n",
    "    \"mae_mr5 = np.where(AGG5[\\\"mod_all_cnt\\\"][REF_KI] > 0,\\n\",\n",
    "    \"                   AGG5[\\\"mod_all_sum_phys\\\"][REF_KI] /\\n\",\n",
    "    \"                   np.maximum(AGG5[\\\"mod_all_cnt\\\"][REF_KI], 1),\\n\",\n",
    "    \"                   np.nan)  # (N, NV)\\n\",\n",
    "    \"delta_mae = mae_mr5 - mae_mr0  # (N, NV) — positive = masking hurts\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Summary table\\n\",\n",
    "    \"for vi, v in enumerate(VARS):\\n\",\n",
    "    \"    d = delta_mae[:, vi]\\n\",\n",
    "    \"    valid = np.isfinite(d)\\n\",\n",
    "    \"    print(f\\\"{v}: median ΔMAE = {np.nanmedian(d):.4f}, \\\"\\n\",\n",
    "    \"          f\\\"mean = {np.nanmean(d):.4f}, \\\"\\n\",\n",
    "    \"          f\\\"positive: {(d[valid] > 0).sum()}/{valid.sum()} stations\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── ΔMAE vs neighbour count — scatter with regression ────────────────────\\n\",\n",
    "    \"fig, axes = plt.subplots(len(COMPARE_RADII), NV,\\n\",\n",
    "    \"                         figsize=(17, 3.5 * len(COMPARE_RADII)),\\n\",\n",
    "    \"                         squeeze=False, constrained_layout=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"for ri, R in enumerate(COMPARE_RADII):\\n\",\n",
    "    \"    nn = NN_COMP[R]\\n\",\n",
    "    \"    for vi, v in enumerate(VARS):\\n\",\n",
    "    \"        ax = axes[ri, vi]\\n\",\n",
    "    \"        d = delta_mae[:, vi]\\n\",\n",
    "    \"        valid = np.isfinite(d)\\n\",\n",
    "    \"        ax.scatter(nn[valid], d[valid], s=20, alpha=0.55,\\n\",\n",
    "    \"                   c=nn[valid], cmap=\\\"viridis\\\", edgecolors=\\\"0.4\\\",\\n\",\n",
    "    \"                   linewidths=0.3)\\n\",\n",
    "    \"        ax.axhline(0, ls=\\\":\\\", color=\\\"k\\\", lw=0.7, alpha=0.5)\\n\",\n",
    "    \"        if valid.sum() > 5 and nn[valid].std() > 0:\\n\",\n",
    "    \"            sl, ic, r, p, _ = linregress(nn[valid], d[valid])\\n\",\n",
    "    \"            xfit = np.linspace(nn.min(), nn.max(), 50)\\n\",\n",
    "    \"            ax.plot(xfit, sl * xfit + ic, \\\"k--\\\", lw=1.2, alpha=0.7)\\n\",\n",
    "    \"            pstr = f\\\"p={p:.1e}\\\" if p < 0.001 else f\\\"p={p:.3f}\\\"\\n\",\n",
