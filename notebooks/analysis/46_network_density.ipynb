    "    \"if len(df_mr) > 0:\\n\",\n",
    "    \"    pivot_mr = df_mr.pivot(index=\\\"predictor\\\", columns=\\\"variable\\\", values=\\\"r\\\")\\n\",\n",
    "    \"    row_order_mr = [p for p, _ in all_preds if p in pivot_mr.index]\\n\",\n",
    "    \"    pivot_mr = pivot_mr.loc[row_order_mr]\\n\",\n",
    "    \"    print(pivot_mr.round(3).to_string())\\n\",\n",
    "    \"    C.save_table(pivot_mr.reset_index(), \\\"46_dmae_correlations\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\nInterpretation guide:\\\")\\n\",\n",
    "    \"print(\\\"  SA gain vs N: positive r → SA helps more in dense areas (Story A)\\\")\\n\",\n",
    "    \"print(\\\"  SA gain vs d_NN: negative r → SA helps more for isolated stations (Story C)\\\")\\n\",\n",
    "    \"print(\\\"  ΔMAE vs N: positive r → denser stations lose more from masking\\\")\\n\",\n",
    "    \"print(\\\"  ΔMAE vs W_i: positive r → same, with distance-weighted measure\\\")\\n\"\n",
    "   ],\n",
