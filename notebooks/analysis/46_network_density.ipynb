    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"nn_scatter_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Multi-radius neighbour-count analysis\\n\",\n",
    "    \"\\n\",\n",
    "    \"For each station, count neighbours within 10 radii (10–95 km).\\n\",\n",
    "    \"Scatter plots show per-station MAE and σₑ vs neighbour count with\\n\",\n",
    "    \"regression lines. A compact Pearson r heatmap (radius × variable)\\n\",\n",
    "    \"summarises the strength of correlation across all radii.\\n\",\n",
    "    \"\\n\",\n",
    "    \"The masking experiment above uses the publication subset\\n\",\n",
    "    \"(10, 25, 50, 100 km); the full 10-radius set is for exploratory\\n\",\n",
    "    \"analysis and identifying the most informative radii.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"nn_multi_radii\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-09-02T10:37:13.385571Z\",\n",
    "     \"start_time\": \"2026-09-02T10:37:13.362346Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# ── Per-station MAE and σₑ for v27 at REF_KI ────────────────────────────────\\n\",\n",
    "    \"a27 = AGG[\\\"v27\\\"]\\n\",\n",
    "    \"cnt_27 = a27[\\\"mod_all_cnt\\\"][REF_KI, :, :]         # (N, NV)\\n\",\n",
    "    \"sum_27 = a27[\\\"mod_all_sum_phys\\\"][REF_KI, :, :]     # (N, NV)\\n\",\n",
    "    \"sq_27  = a27[\\\"mod_all_sumsq_phys\\\"][REF_KI, :, :]   # (N, NV)\\n\",\n",
    "    \"sgn_27 = a27[\\\"mod_all_signed_phys\\\"][REF_KI, :, :]  # (N, NV)\\n\",\n",
    "    \"\\n\",\n",
    "    \"mae_27 = np.where(cnt_27 > 0, sum_27 / np.maximum(cnt_27, 1), np.nan)  # (N, NV)\\n\",\n",
    "    \"n27 = np.maximum(cnt_27, 1)\\n\",\n",
    "    \"sd_27  = np.sqrt(np.maximum(sq_27 / n27 - (sgn_27 / n27)**2, 0))       # (N, NV)\\n\",\n",
    "    \"sd_27  = np.where(cnt_27 > 0, sd_27, np.nan)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Pearson and Spearman correlations: (radius × variable) ──────────────────\\n\",\n",
    "    \"corr_pearson_mae = np.full((len(NN_RADII), NV), np.nan)\\n\",\n",
    "    \"corr_spearman_mae = np.full((len(NN_RADII), NV), np.nan)\\n\",\n",
    "    \"corr_pearson_sd  = np.full((len(NN_RADII), NV), np.nan)\\n\",\n",
    "    \"corr_spearman_sd = np.full((len(NN_RADII), NV), np.nan)\\n\",\n",
    "    \"sample_sizes = np.zeros((len(NN_RADII), NV), dtype=int)\\n\",\n",
    "    \"\\n\",\n",
    "    \"for ri, R in enumerate(NN_RADII):\\n\",\n",
    "    \"    nn = NN_COUNT[R]\\n\",\n",
    "    \"    for vi in range(NV):\\n\",\n",
    "    \"        valid = np.isfinite(mae_27[:, vi]) & (nn > 0)\\n\",\n",
    "    \"        sample_sizes[ri, vi] = valid.sum()\\n\",\n",
    "    \"        if valid.sum() > 5:\\n\",\n",
    "    \"            corr_pearson_mae[ri, vi], _ = pearsonr(nn[valid], mae_27[valid, vi])\\n\",\n",
    "    \"            corr_spearman_mae[ri, vi], _ = spearmanr(nn[valid], mae_27[valid, vi])\\n\",\n",
    "    \"            corr_pearson_sd[ri, vi], _ = pearsonr(nn[valid], sd_27[valid, vi])\\n\",\n",
    "    \"            corr_spearman_sd[ri, vi], _ = spearmanr(nn[valid], sd_27[valid, vi])\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Correlations computed.\\\")\\n\",\n",
    "    \"print(f\\\"Sample sizes (min across radii×var): {sample_sizes.min()}\\\")\\n\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"corr_heatmap_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### Correlation heatmaps: Pearson r (radius × variable)\\n\",\n",
    "    \"\\n\",\n",
    "    \"Compact summary of how strongly neighbour count correlates with MAE\\n\",\n",
    "    \"and σₑ across all 10 radii. Spearman ρ computed as robustness check\\n\",\n",
    "    \"and printed below.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"corr_heatmap_plot\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-09-02T10:37:13.658808Z\",\n",
    "     \"start_time\": \"2026-09-02T10:37:13.386920Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# ── Pearson r heatmaps: MAE and σₑ vs NN count ──────────────────────────────\\nfig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5), constrained_layout=True)\\n\\nfor ax, mat, title, cmap in [\\n    (ax1, corr_pearson_mae, \\\"Pearson r: MAE vs NN count\\\", \\\"RdBu_r\\\"),\\n    (ax2, corr_pearson_sd,  \\\"Pearson r: σₑ vs NN count\\\", \\\"RdBu_r\\\"),\\n]:\\n    vabs = max(np.nanmax(np.abs(mat)), 0.01)\\n    im = ax.imshow(mat, aspect=\\\"auto\\\", cmap=cmap, vmin=-vabs, vmax=vabs)\\n    ax.set_xticks(range(NV))\\n    ax.set_xticklabels(VARS, fontsize=8, rotation=30, ha=\\\"right\\\")\\n    ax.set_yticks(range(len(NN_RADII)))\\n    ax.set_yticklabels([f\\\"{R} km\\\" for R in NN_RADII], fontsize=8)\\n    ax.set_ylabel(\\\"Radius\\\", fontsize=9)\\n    ax.set_title(title, fontsize=10)\\n    # Annotate each cell with r value\\n    for ri in range(len(NN_RADII)):\\n        for vi in range(NV):\\n            val = mat[ri, vi]\\n            if np.isfinite(val):\\n                color = \\\"white\\\" if abs(val) > vabs * 0.6 else \\\"black\\\"\\n                ax.text(vi, ri, f\\\"{val:.2f}\\\", ha=\\\"center\\\", va=\\\"center\\\",\\n                        fontsize=6.5, color=color)\\n    fig.colorbar(im, ax=ax, fraction=0.04, pad=0.02)\\n\\nfig.suptitle(f\\\"Correlation between neighbour count and forecast error \\\"\\n             f\\\"metrics at {LEAD[REF_KI]} (v27, MR=0)\\\", fontsize=12)\\nC.save_fig(fig, \\\"46_corr_heatmap\\\")\\nplt.show()\\nplt.close(fig)\\n\\n# ── Spearman robustness check (printed, not plotted) ────────────────────────\\nprint(\\\"\\\\nSpearman ρ (MAE vs NN count):\\\")\\ndf_sp = pd.DataFrame(corr_spearman_mae, index=[f\\\"{R} km\\\" for R in NN_RADII],\\n                     columns=VARS)\\nprint(df_sp.round(3).to_string())\\n\\nprint(\\\"\\\\nSpearman ρ (σₑ vs NN count):\\\")\\ndf_sp_sd = pd.DataFrame(corr_spearman_sd, index=[f\\\"{R} km\\\" for R in NN_RADII],\\n                        columns=VARS)\\nprint(df_sp_sd.round(3).to_string())\\n\\n# Save tables\\nC.save_table(pd.DataFrame(corr_pearson_mae,\\n    index=[f\\\"{R} km\\\" for R in NN_RADII], columns=VARS\\n).reset_index().rename(columns={\\\"index\\\": \\\"radius\\\"}), \\\"46_pearson_r_mae\\\")\\n\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"interp\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Interpretation\\n\",\n",
    "    \"\\n\",\n",
    "    \"The **local masking experiment** exploits the natural variation in\\n\",\n",
    "    \"MR=0.5's random masking to estimate the causal effect of local spatial\\n\",\n",
    "    \"context on forecast quality.\\n\",\n",
    "    \"\\n\",\n",
    "    \"**ΔMAE vs radius**: at each radius R, the MAE increase when more than\\n\",\n",
    "    \"half of a target station's R-km neighbours are masked (vs fewer than\\n\",\n",
    "    \"half). A positive ΔMAE indicates that local context genuinely helps\\n\",\n",
    "    \"the model. The terrain-class breakdown reveals whether stations in\\n\",\n",
    "    \"complex terrain (valleys, ridges) are more sensitive to local masking.\\n\",\n",
    "    \"\\n\",\n",
    "    \"**Random control**: replacing real spatial neighbours with randomly\\n\",\n",
    "    \"chosen pseudo-neighbours eliminates the spatial structure. If the\\n\",\n",
    "    \"random ΔMAE is near zero while the local ΔMAE is positive, the effect\\n\",\n",
    "    \"is specifically spatial — the model relies on nearby stations, not\\n\",\n",
    "    \"just on having more stations globally.\\n\",\n",
    "    \"\\n\",\n",
    "    \"**Dose-response**: the monotonic increase in MAE with local masking\\n\",\n",
    "    \"fraction at R=50 km confirms a causal relationship: more local masking\\n\",\n",
    "    \"→ worse predictions, in a graded fashion.\\n\",\n",
    "    \"\\n\",\n",
    "    \"**Aggregate masking impact**: the per-station ΔMAE (MR=0.5 − MR=0.0)\\n\",\n",
    "    \"correlation with neighbour count reveals that stations in denser\\n\",\n",
    "    \"network regions lose more absolute performance when masking is applied,\\n\",\n",
    "    \"because they had more local context to lose.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"713c5d25112645f5\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Visible-station MAE by neighbour-count group (R=50 km)\\n\",\n",
    "    \"\\n\",\n",
    "    \"At R=50 km, split stations into four density groups (≤2, 3–5, 6–10,\\n\",\n",
    "    \">10 neighbours) and plot MAE vs lead time for MR=0.0 and MR=0.5.\\n\",\n",
    "    \"If dense groups show a larger MR=0.5 penalty, masking hurts more\\n\",\n",
    "    \"where the model has more spatial context to lose.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"8bd287d83ada44f7\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-09-02T10:37:14.310484Z\",\n",
    "     \"start_time\": \"2026-09-02T10:37:13.659713Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# ── MAE vs lead time by neighbour-count group at R=50 km ─────────────────────\\n\",\n",
    "    \"R_VIS = 50\\n\",\n",
    "    \"nn50_vis = (DIST <= R_VIS).sum(axis=1)  # (N,)\\n\",\n",
    "    \"\\n\",\n",
    "    \"NN_GROUPS = [\\n\",\n",
    "    \"    (\\\"≤2\\\",   lambda nn: nn <= 2),\\n\",\n",
    "    \"    (\\\"3–5\\\",  lambda nn: (nn >= 3) & (nn <= 5)),\\n\",\n",
    "    \"    (\\\"6–10\\\", lambda nn: (nn >= 6) & (nn <= 10)),\\n\",\n",
    "    \"    (\\\">10\\\",  lambda nn: nn > 10),\\n\",\n",
    "    \"]\\n\",\n",
    "    \"GROUP_COLORS = [\\\"#BC4749\\\", \\\"#D4A373\\\", \\\"#5B8E7D\\\", \\\"#2B7A78\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"a0 = AGG[\\\"v27\\\"]\\n\",\n",
    "    \"a5 = AGG5  # reuse — already loaded in agg_impact cell\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(2, NV, figsize=(17, 7),\\n\",\n",
    "    \"                         squeeze=False, constrained_layout=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"for mi, (agg, mr_label) in enumerate([(a0, \\\"MR=0.0\\\"), (a5, \\\"MR=0.5\\\")]):\\n\",\n",
    "    \"    for vi, v in enumerate(VARS):\\n\",\n",
    "    \"        ax = axes[mi, vi]\\n\",\n",
    "    \"        for gi, (glabel, gfn) in enumerate(NN_GROUPS):\\n\",\n",
    "    \"            mask = gfn(nn50_vis)\\n\",\n",
    "    \"            n_stn = mask.sum()\\n\",\n",
    "    \"            if n_stn == 0:\\n\",\n",
    "    \"                continue\\n\",\n",
    "    \"            # Pool MAE over stations in this group\\n\",\n",
    "    \"            cnt = agg[\\\"mod_all_cnt\\\"][:, mask, vi]   # (K, n_stn)\\n\",\n",
    "    \"            s   = agg[\\\"mod_all_sum_phys\\\"][:, mask, vi]\\n\",\n",
    "    \"            mae_k = np.where(cnt.sum(axis=1) > 0,\\n\",\n",
    "    \"                             s.sum(axis=1) / np.maximum(cnt.sum(axis=1), 1),\\n\",\n",
    "    \"                             np.nan)  # (K,)\\n\",\n",
    "    \"            ax.plot(range(1, K), mae_k[1:], \\\"o-\\\", ms=3, lw=1.3,\\n\",\n",
    "    \"                    color=GROUP_COLORS[gi],\\n\",\n",
    "    \"                    label=f\\\"{glabel} (n={n_stn})\\\" if mi == 0 else None)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        ax.set_xticks(range(1, K, 2))\\n\",\n",
    "    \"        ax.set_xticklabels(LEAD[1::2], rotation=45, ha=\\\"right\\\", fontsize=6.5)\\n\",\n",
    "    \"        ax.grid(alpha=.3)\\n\",\n",
    "    \"        if mi == 0:\\n\",\n",
    "    \"            ax.set_title(f\\\"{v}  [{C.UNITS[v]}]\\\", fontsize=10)\\n\",\n",
    "    \"        if vi == 0:\\n\",\n",
    "    \"            ax.set_ylabel(f\\\"MAE — {mr_label}\\\", fontsize=9)\\n\",\n",
    "    \"\\n\",\n",
    "    \"axes[0, -1].legend(fontsize=6.5, loc=\\\"upper left\\\", title=\\\"NN within 50 km\\\",\\n\",\n",
    "    \"                   title_fontsize=7)\\n\",\n",
    "    \"fig.suptitle(\\\"MAE Transformer MAE vs lead time by neighbour-count group (R=50 km)\\\\n\\\"\\n\",\n",
    "    \"             \\\"Top: MR=0.0 (full network) — Bottom: MR=0.5 (50% masked)\\\",\\n\",\n",
    "    \"             fontsize=12)\\n\",\n",
    "    \"# ── Sync y-axis per variable column across rows ──\\n\",\n",
    "    \"for vi in range(NV):\\n\",\n",
    "    \"    col_axes = [axes[ri, vi] for ri in range(2)]\\n\",\n",
    "    \"    lo = min(ax.get_ylim()[0] for ax in col_axes)\\n\",\n",
    "    \"    hi = max(ax.get_ylim()[1] for ax in col_axes)\\n\",\n",
    "    \"    for ax in col_axes:\\n\",\n",
    "    \"        ax.set_ylim(lo, hi)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Sync wind components ──\\n\",\n",
    "    \"wu_i, wv_i = VARS.index(\\\"wind_u\\\"), VARS.index(\\\"wind_v\\\")\\n\",\n",
    "    \"lo = min(axes[0, wu_i].get_ylim()[0], axes[0, wv_i].get_ylim()[0])\\n\",\n",
    "    \"hi = max(axes[0, wu_i].get_ylim()[1], axes[0, wv_i].get_ylim()[1])\\n\",\n",
    "    \"for ri in range(axes.shape[0]):\\n\",\n",
    "    \"    axes[ri, wu_i].set_ylim(lo, hi)\\n\",\n",
    "    \"    axes[ri, wv_i].set_ylim(lo, hi)\\n\",\n",
    "    \"C.save_fig(fig, \\\"46_visible_mr_compare_by_nn\\\")\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"plt.close(fig)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Print summary at REF_KI ─────────────────────────────────────────────────\\n\",\n",
    "    \"print(f\\\"\\\\nMAE at {LEAD[REF_KI]} by group (R={R_VIS} km):\\\")\\n\",\n",
    "    \"group_hdr = \\\"Group\\\"; n_hdr = \\\"n_stn\\\"\\n\",\n",
    "    \"print(f\\\"{group_hdr:>8s}  {n_hdr:>5s}  \\\", end=\\\"\\\")\\n\",\n",
    "    \"for v in VARS:\\n\",\n",
    "    \"    lbl0, lbl5, dlbl = v + \\\"(0.0)\\\", v + \\\"(0.5)\\\", \\\"ΔMAE\\\"\\n\",\n",
    "    \"    print(f\\\"  {lbl0:>12s}  {lbl5:>12s}  {dlbl:>8s}\\\", end=\\\"\\\")\\n\",\n",
    "    \"print()\\n\",\n",
    "    \"for glabel, gfn in NN_GROUPS:\\n\",\n",
    "    \"    mask = gfn(nn50_vis)\\n\",\n",
    "    \"    n_stn = mask.sum()\\n\",\n",
    "    \"    print(f\\\"{glabel:>8s}  {n_stn:>5d}  \\\", end=\\\"\\\")\\n\",\n",
    "    \"    for vi, v in enumerate(VARS):\\n\",\n",
    "    \"        c0 = a0[\\\"mod_all_cnt\\\"][REF_KI, mask, vi].sum()\\n\",\n",
    "    \"        s0 = a0[\\\"mod_all_sum_phys\\\"][REF_KI, mask, vi].sum()\\n\",\n",
    "    \"        c5 = a5[\\\"mod_all_cnt\\\"][REF_KI, mask, vi].sum()\\n\",\n",
    "    \"        s5 = a5[\\\"mod_all_sum_phys\\\"][REF_KI, mask, vi].sum()\\n\",\n",
    "    \"        m0 = s0 / max(c0, 1)\\n\",\n",
    "    \"        m5 = s5 / max(c5, 1)\\n\",\n",
    "    \"        print(f\\\"  {m0:>12.4f}  {m5:>12.4f}  {m5-m0:>+8.4f}\\\", end=\\\"\\\")\\n\",\n",
    "    \"    print()\\n\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"nn_cluster_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### MAE by minimum-neighbour threshold across radii\\n\",\n",
    "    \"\\n\",\n",
    "    \"Stations with ≥2 neighbours within R form increasingly inclusive\\n\",\n",
    "    \"clusters as R grows. This plot shows MAE vs lead time for each\\n\",\n",
    "    \"cluster at R = 10, 15, 25, 50 km, with MR=0.0 (solid) and\\n\",\n",
    "    \"MR=0.5 (dashed). The gap between solid and dashed reveals how\\n\",\n",
    "    \"much masking hurts at each spatial scale.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"nn_cluster_plot\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-09-02T10:37:14.749194Z\",\n",
    "     \"start_time\": \"2026-09-02T10:37:14.371850Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# ── MAE by \\\"≥2 neighbours\\\" cluster at R = 10, 15, 25, 50 km ────────────────\\n\",\n",
    "    \"CLUSTER_RADII = [10, 15, 25, 50]\\n\",\n",
    "    \"CLUSTER_COLORS = [\\\"#BC4749\\\", \\\"#D4A373\\\", \\\"#5B8E7D\\\", \\\"#2B7A78\\\"]\\n\",\n",
    "    \"MIN_NN = 2\\n\",\n",
    "    \"\\n\",\n",
    "    \"a0 = AGG[\\\"v27\\\"]\\n\",\n",
    "    \"a5 = AGG5  # reuse — already loaded in agg_impact cell\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Compute cluster membership\\n\",\n",
    "    \"cluster_mask = {}\\n\",\n",
    "    \"for R in CLUSTER_RADII:\\n\",\n",
    "    \"    nn = (DIST <= R).sum(axis=1)\\n\",\n",
    "    \"    cluster_mask[R] = nn >= MIN_NN\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Stations with ≥2 neighbours by radius:\\\")\\n\",\n",
    "    \"for R in CLUSTER_RADII:\\n\",\n",
    "    \"    print(f\\\"  R={R:>2d} km: {cluster_mask[R].sum()} / {N} stations\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(1, NV, figsize=(17, 4.5),\\n\",\n",
    "    \"                         constrained_layout=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"for vi, v in enumerate(VARS):\\n\",\n",
    "    \"    ax = axes[vi]\\n\",\n",
    "    \"    for ci, R in enumerate(CLUSTER_RADII):\\n\",\n",
    "    \"        mask = cluster_mask[R]\\n\",\n",
    "    \"        n_stn = mask.sum()\\n\",\n",
    "    \"        col = CLUSTER_COLORS[ci]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # MR=0.0 — solid\\n\",\n",
    "    \"        cnt0 = a0[\\\"mod_all_cnt\\\"][:, mask, vi]\\n\",\n",
    "    \"        sum0 = a0[\\\"mod_all_sum_phys\\\"][:, mask, vi]\\n\",\n",
    "    \"        mae0 = np.where(cnt0.sum(axis=1) > 0,\\n\",\n",
    "    \"                        sum0.sum(axis=1) / np.maximum(cnt0.sum(axis=1), 1),\\n\",\n",
    "    \"                        np.nan)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # MR=0.5 — dashed\\n\",\n",
    "    \"        cnt5 = a5[\\\"mod_all_cnt\\\"][:, mask, vi]\\n\",\n",
    "    \"        sum5 = a5[\\\"mod_all_sum_phys\\\"][:, mask, vi]\\n\",\n",
    "    \"        mae5 = np.where(cnt5.sum(axis=1) > 0,\\n\",\n",
    "    \"                        sum5.sum(axis=1) / np.maximum(cnt5.sum(axis=1), 1),\\n\",\n",
    "    \"                        np.nan)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        ax.plot(range(1, K), mae0[1:], \\\"o-\\\", ms=3, lw=1.5,\\n\",\n",
    "    \"                color=col, label=f\\\"R={R} km (n={n_stn}) — MR=0\\\")\\n\",\n",
    "    \"        ax.plot(range(1, K), mae5[1:], \\\"s--\\\", ms=3, lw=1.2,\\n\",\n",
    "    \"                color=col, alpha=0.7,\\n\",\n",
    "    \"                label=f\\\"R={R} km — MR=0.5\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ax.set_xticks(range(1, K, 2))\\n\",\n",
    "    \"    ax.set_xticklabels(LEAD[1::2], rotation=45, ha=\\\"right\\\", fontsize=6.5)\\n\",\n",
