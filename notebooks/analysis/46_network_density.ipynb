    "    \"    ax.set_title(f\\\"{v}  (ρ={rp:.2f}, ρₛ={rs:.2f})\\\", fontsize=9)\\n\",\n",
    "    \"    ax.set_xlabel(\\\"NN distance [km]\\\", fontsize=8)\\n\",\n",
    "    \"    ax.grid(alpha=.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"axes[0].set_ylabel(f\\\"MAE at {LEAD[REF_KI]}\\\")\\n\",\n",
