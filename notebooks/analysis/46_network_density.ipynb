    "     \"start_time\": \"2026-09-02T10:37:13.067121Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# ── Supplementary: MAE vs nearest-station distance ───────────────────────────\\n\",\n",
    "    \"fig, axes = plt.subplots(1, NV, figsize=(17, 3.5))\\n\",\n",
    "    \"a = AGG[\\\"v27\\\"]\\n\",\n",
    "    \"nn_d = stn.nn_dist_km.values\\n\",\n",
    "    \"for vi, (ax, v) in enumerate(zip(axes, VARS)):\\n\",\n",
    "    \"    cnt = a[\\\"mod_all_cnt\\\"][REF_KI, :, vi]\\n\",\n",
