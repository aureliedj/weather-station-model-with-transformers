    "    \"print(\\\"MR × N INTERACTION (v27): ΔMAE vs density predictors\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"mr_corr = []\\n\",\n",
    "    \"all_preds = [(f\\\"N({R} km)\\\", NN_COMP[R]) for R in COMPARE_RADII] + \\\\\\n\",\n",
    "    \"            [(f\\\"W_i (λ={LAMBDA_KM})\\\", W_i), (\\\"d_NN [km]\\\", d_NN)]\\n\",\n",
    "    \"for pname, px in all_preds:\\n\",\n",
