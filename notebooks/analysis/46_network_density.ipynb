    "    \"            r_val, p = pearsonr(px[valid], d[valid])\\n\",\n",
    "    \"            mr_corr.append({\\\"predictor\\\": pname, \\\"variable\\\": v,\\n\",\n",
    "    \"                            \\\"r\\\": r_val, \\\"p\\\": p})\\n\",\n",
