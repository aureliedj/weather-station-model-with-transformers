    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"t\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 4.6 — Network Density and Local Spatial Dependence\\n\",\n",
    "    \"\\n\",\n",
    "    \"How does the availability of nearby stations affect forecast quality?\\n\",\n",
    "    \"This notebook presents a controlled local-masking experiment using v27's\\n\",\n",
    "    \"MR=0.5 predictions, where 50\\\\% of stations are randomly masked per\\n\",\n",
    "    \"evaluation window. By analysing how the fraction of masked local\\n\",\n",
    "    \"neighbours correlates with target-station error, we isolate the\\n\",\n",
    "    \"contribution of local spatial context.\\n\",\n",
    "    \"\\n\",\n",
    "    \"**Main result**: ΔMAE vs masking radius, with terrain-class breakdown\\n\",\n",
    "    \"and a random-removal control that distinguishes genuine local spatial\\n\",\n",
    "    \"dependence from simply having fewer stations.\\n\",\n",
    "    \"\\n\",\n",
    "    \"Radii: 5, 10, 25, 50, 100 km.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"boot\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-09-02T10:36:48.819088Z\",\n",
    "     \"start_time\": \"2026-09-02T10:36:48.745400Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"import os, sys, datetime as dt\\n\",\n",
    "    \"import numpy as np, pandas as pd, matplotlib.pyplot as plt\\n\",\n",
    "    \"import matplotlib.colors as mcolors\\n\",\n",
    "    \"for _cand in (os.getcwd(),\\n\",\n",
    "    \"              os.path.join(os.getcwd(), \\\"notebooks\\\", \\\"analysis\\\"),\\n\",\n",
    "    \"              os.path.dirname(os.path.abspath(\\\"__file__\\\"))):\\n\",\n",
    "    \"    if os.path.isfile(os.path.join(_cand, \\\"common.py\\\")):\\n\",\n",
    "    \"        if _cand not in sys.path: sys.path.insert(0, _cand)\\n\",\n",
    "    \"        break\\n\",\n",
    "    \"import importlib, common as C; importlib.reload(C)\\n\",\n",
    "    \"plt.style.use(\\\"default\\\")\\n\",\n",
    "    \"plt.rcParams.update({\\\"figure.dpi\\\": 110, \\\"font.size\\\": 10,\\n\",\n",
    "    \"                     \\\"figure.facecolor\\\": \\\"white\\\", \\\"axes.facecolor\\\": \\\"white\\\",\\n\",\n",
    "    \"                     \\\"savefig.facecolor\\\": \\\"white\\\", \\\"axes.edgecolor\\\": \\\"0.3\\\",\\n\",\n",
    "    \"                     \\\"axes.labelcolor\\\": \\\"black\\\", \\\"xtick.color\\\": \\\"0.3\\\",\\n\",\n",
    "    \"                     \\\"ytick.color\\\": \\\"0.3\\\", \\\"text.color\\\": \\\"black\\\"})\\n\",\n",
    "    \"\\n\",\n",
    "    \"RUNS  = C.discovered_runs()\\n\",\n",
    "    \"MR0_RUNS = [r for r in RUNS if \\\"mr0.00\\\" in RUNS[r]]\\n\",\n",
    "    \"ns = C.norm_stats(); VARS = ns[\\\"var_names\\\"]; STD = ns[\\\"std\\\"]\\n\",\n",
    "    \"stn = C.station_table(); KEEP = C.keep_mask(stn, VARS)\\n\",\n",
    "    \"AGG  = {r: C.load_agg(r, \\\"mr0.00\\\") for r in MR0_RUNS}\\n\",\n",
    "    \"GRID = AGG[MR0_RUNS[0]][\\\"grid\\\"]; LEAD = C.lead_labels(GRID); K = len(GRID)\\n\",\n",
    "    \"NV = len(VARS); N = len(stn)\\n\",\n",
    "    \"print(\\\"Models at MR=0.00:\\\", MR0_RUNS)\\n\",\n",
    "    \"\\n\",\n",
    "    \"from scipy.stats import pearsonr, spearmanr, linregress\\n\",\n",
    "    \"REF_KI = 6  # \\\\u2248 3 h\\n\",\n",
    "    \"RADII_KM = [5, 10, 25, 50, 100]  # subset for masking experiment\\n\",\n",
    "    \"NN_RADII = [10, 25, 50, 100]  # full set for correlation analysis\\n\",\n",
    "    \"\\n\",\n",
    "    \"TC_IDX = C.terrain_class_indices(stn)\\n\",\n",
    "    \"TC_COLORS = {\\\"valley floor\\\": \\\"#2B7A78\\\", \\\"elevated enclosed\\\": \\\"#D4A373\\\",\\n\",\n",
    "    \"             \\\"exposed ridge/summit\\\": \\\"#BC4749\\\", \\\"open / slope\\\": \\\"#5B8E7D\\\"}\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"dist\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-09-02T10:36:48.833183Z\",\n",
    "     \"start_time\": \"2026-09-02T10:36:48.820463Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# ── Distance matrix from Swiss LV95 coordinates ─────────────────────────────\\neast  = stn.easting.values.astype(np.float64)\\nnorth = stn.northing.values.astype(np.float64)\\nDIST = np.sqrt((east[:, None] - east[None, :])**2 +\\n               (north[:, None] - north[None, :])**2) / 1000.0  # km\\nnp.fill_diagonal(DIST, np.inf)  # exclude self-distance\\n\\n# Adjacency matrices and neighbour counts at masking radii\\nADJ = {R: (DIST <= R) for R in RADII_KM}\\nN_LOCAL = {R: ADJ[R].sum(axis=1) for R in RADII_KM}\\n\\n# Neighbour counts at all analysis radii\\nNN_COUNT = {R: (DIST <= R).sum(axis=1) for R in NN_RADII}\\n\\nprint(\\\"Neighbour counts at analysis radii:\\\")\\nfor R in NN_RADII:\\n    n = NN_COUNT[R]\\n    print(f\\\"  {R:>3d} km: median={np.median(n):.0f}, \\\"\\n          f\\\"mean={n.mean():.1f}, min={n.min()}, max={n.max()}, \\\"\\n          f\\\"zero: {(n == 0).sum()}\\\")\\n\\n# Distance-weighted neighbour availability\\n# W_i = Σ_j exp(-d_ij / λ), excluding self\\nDIST_FINITE = DIST.copy()\\nnp.fill_diagonal(DIST_FINITE, 0)  # temp: 0 for self (excluded below)\\nLAMBDA_KM = 25  # decay scale ≈ median inter-station distance\\nW_RAW = np.exp(-DIST_FINITE / LAMBDA_KM)\\nnp.fill_diagonal(W_RAW, 0)  # exclude self-contribution\\nW_i = W_RAW.sum(axis=1)  # (N,)\\nnp.fill_diagonal(DIST_FINITE, np.inf)  # restore\\n\\n# Nearest-station distance\\nd_NN = DIST.min(axis=1)  # (N,) — km to nearest station\\n\\nprint(f\\\"W_i (λ={LAMBDA_KM} km): median={np.median(W_i):.2f}, \\\"\\n      f\\\"min={W_i.min():.2f}, max={W_i.max():.2f}\\\")\\nprint(f\\\"d_NN: median={np.median(d_NN):.1f} km, \\\"\\n      f\\\"min={d_NN.min():.1f}, max={d_NN.max():.1f} km\\\")\\n\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"exp_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Local Station Masking Experiment\\n\",\n",
    "    \"\\n\",\n",
    "    \"At MR=0.5, approximately half the stations are randomly masked each\\n\",\n",
    "    \"evaluation window. For each (window, target station) pair where the\\n\",\n",
    "    \"target is **visible**, we count how many of its neighbours within\\n\",\n",
    "    \"radius *R* happened to be masked. Splitting into \\\"high local masking\\\"\\n\",\n",
    "    \"(> 50\\\\% of *R*-km neighbours masked) vs \\\"low local masking\\\" gives\\n\",\n",
    "    \"ΔMAE — the MAE increase attributable to losing local spatial context.\\n\",\n",
    "    \"\\n\",\n",
    "    \"**Random control**: the same statistic computed with randomly chosen\\n\",\n",
    "    \"pseudo-neighbours (same count per station) instead of real spatial\\n\",\n",
    "    \"neighbours. If ΔMAE\\\\_local ≫ ΔMAE\\\\_random, the effect is genuinely\\n\",\n",
    "    \"spatial, not just a consequence of having fewer total stations.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"load_mr05\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-09-02T10:36:49.225392Z\",\n",
    "     \"start_time\": \"2026-09-02T10:36:48.834753Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# ── Load v27 MR=0.5 dump ────────────────────────────────────────────────────\\n\",\n",
    "    \"# At MR=0.5, ~50% of stations are randomly masked per evaluation pass.\\n\",\n",
    "    \"# masked_idx[w] lists which stations were masked.\\n\",\n",
    "    \"# Predictions exist for ALL stations (decoder reconstructs masked ones).\\n\",\n",
    "    \"import torch\\n\",\n",
    "    \"\\n\",\n",
    "    \"d5 = C.load_dump(\\\"v27\\\", \\\"mr0.50\\\")\\n\",\n",
    "    \"P5 = d5[\\\"preds\\\"][:, REF_KI, :, :NV].numpy().astype(np.float64)   # (Mw, N, NV)\\n\",\n",
    "    \"T5 = d5[\\\"targets\\\"][:, REF_KI, :, :NV].numpy().astype(np.float64)\\n\",\n",
    "    \"M5 = d5[\\\"masks\\\"][:, REF_KI, :, :NV].numpy() > 0.5                # (Mw, N, NV)\\n\",\n",
    "    \"MI5 = d5[\\\"masked_idx\\\"].numpy()                                    # (Mw, n_masked)\\n\",\n",
    "    \"Mw = P5.shape[0]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Per-window masked-station boolean\\n\",\n",
    "    \"masked_bool = np.zeros((Mw, N), dtype=bool)\\n\",\n",
    "    \"for w in range(Mw):\\n\",\n",
    "    \"    masked_bool[w, MI5[w]] = True\\n\",\n",
    "    \"visible_bool = ~masked_bool  # (Mw, N)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Per-window absolute error in physical units\\n\",\n",
    "    \"err5 = np.abs(P5 - T5) * STD[None]          # (Mw, N, NV)\\n\",\n",
    "    \"val5 = M5 & KEEP[None]                      # (Mw, N, NV)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Local masking counts per (window, station, radius):\\n\",\n",
    "    \"# local_masked_count[R][w, i] = number of i's R-km neighbours masked in window w\\n\",\n",
    "    \"# Computed as masked_bool @ adjacency_matrix (matrix multiplication).\\n\",\n",
    "    \"local_masked_count = {}\\n\",\n",
    "    \"for R in RADII_KM:\\n\",\n",
    "    \"    adj_f = ADJ[R].astype(np.float32)\\n\",\n",
    "    \"    local_masked_count[R] = masked_bool.astype(np.float32) @ adj_f  # (Mw, N)\\n\",\n",
    "    \"\\n\",\n",
    "    \"TH5_full = d5['target_hours'].numpy()  # save before freeing dump\\n\",\n",
    "    \"del d5, P5, T5, M5  # free memory\\n\",\n",
    "    \"import gc; gc.collect()\\n\",\n",
    "    \"print(f\\\"Loaded: {Mw} windows, {MI5.shape[1]} masked/window, {N} stations\\\")\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"vis_ext_load\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-09-02T10:36:49.263801Z\",\n",
    "     \"start_time\": \"2026-09-02T10:36:49.226624Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# ── Load extended aggregators for v27 at MR=0.0 and MR=0.5 ──────────────────\\n\",\n",
    "    \"EXT0 = C.load_ext(\\\"v27\\\", \\\"mr0.00\\\")\\n\",\n",
    "    \"EXT5 = C.load_ext(\\\"v27\\\", \\\"mr0.50\\\")\\n\",\n",
    "    \"print(\\\"Extended aggregators loaded for v27 at MR=0.0 and MR=0.5\\\")\\n\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"vis_mae_map\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-09-02T10:36:49.962744Z\",\n",
    "     \"start_time\": \"2026-09-02T10:36:49.265446Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# ── Per-station visible MAE map at +3 h — MR=0.0 vs MR=0.5 ──────────────────\\n\",\n",
    "    \"import matplotlib.colors as mcolors\\n\",\n",
    "    \"\\n\",\n",
    "    \"# The MR=0.5 mask is redrawn every window, so every station has a\\n\",\n",
    "    \"# visible-window MAE at MR=0.5 and an all-window MAE at MR=0.0: both panels\\n\",\n",
    "    \"# already show the same 155 stations. VIS_IDX = all stations.\\n\",\n",
    "    \"VIS_IDX = np.arange(N)\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _station_mae(ext, ki, station_idx=None):\\n\",\n",
    "    \"    s = ext[\\\"tod_mod_sum\\\"][:, ki, :, :].sum(axis=0)   # (N, V)\\n\",\n",
    "    \"    c = ext[\\\"tod_mod_cnt\\\"][:, ki, :, :].sum(axis=0)\\n\",\n",
    "    \"    mae = np.where(c > 0, s / np.maximum(c, 1), np.nan)\\n\",\n",
    "    \"    if station_idx is not None:\\n\",\n",
    "    \"        keep = np.zeros(mae.shape[0], dtype=bool)\\n\",\n",
    "    \"        keep[station_idx] = True\\n\",\n",
    "    \"        mae = np.where(keep[:, None], mae, np.nan)\\n\",\n",
    "    \"    return mae\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _station_vis_mae(ext, ki):\\n\",\n",
    "    \"    s = ext[\\\"tod_mod_vis_sum\\\"][:, ki, :, :].sum(axis=0)  # (N, V)\\n\",\n",
    "    \"    c = ext[\\\"tod_mod_vis_cnt\\\"][:, ki, :, :].sum(axis=0)\\n\",\n",
    "    \"    return np.where(c > 0, s / np.maximum(c, 1), np.nan)\\n\",\n",
    "    \"\\n\",\n",
    "    \"mae0 = _station_mae(EXT0, REF_KI, station_idx=VIS_IDX)  # (N, V) — MR=0.0, same stations\\n\",\n",
    "    \"mae5 = _station_vis_mae(EXT5, REF_KI)    # (N, V) — MR=0.5 visible only\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(2, NV, figsize=(5.4 * NV, 9), squeeze=False)\\n\",\n",
    "    \"labels_mr = [\\\"MR=0.0 (all visible)\\\", \\\"MR=0.5 (visible only)\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"for vi, v in enumerate(VARS):\\n\",\n",
    "    \"    # Shared color scale across MR settings\\n\",\n",
    "    \"    both = np.concatenate([mae0[:, vi], mae5[:, vi]])\\n\",\n",
    "    \"    both = both[np.isfinite(both)]\\n\",\n",
    "    \"    vmin = np.nanpercentile(both, 2)\\n\",\n",
    "    \"    vmax = np.nanpercentile(both, 98)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for ri, (mae, lbl) in enumerate(zip([mae0, mae5], labels_mr)):\\n\",\n",
    "    \"        ax = axes[ri, vi]\\n\",\n",
    "    \"        vals = mae[:, vi]\\n\",\n",
    "    \"        valid = np.isfinite(vals)\\n\",\n",
    "    \"        # Simple DEM-free map (46_ doesn't have draw_dem)\\n\",\n",
    "    \"        ax.scatter(stn.easting[valid], stn.northing[valid],\\n\",\n",
    "    \"                   c=vals[valid], s=40, cmap=\\\"YlOrRd\\\",\\n\",\n",
    "    \"                   vmin=vmin, vmax=vmax,\\n\",\n",
    "    \"                   edgecolors=\\\"0.4\\\", linewidths=0.3, zorder=5)\\n\",\n",
    "    \"        ax.set_aspect(\\\"equal\\\")\\n\",\n",
    "    \"        ax.grid(alpha=0.2)\\n\",\n",
    "    \"        if ri == 0:\\n\",\n",
    "    \"            ax.set_title(f\\\"{v}  [{C.UNITS[v]}]\\\", fontsize=10)\\n\",\n",
    "    \"        if vi == 0:\\n\",\n",
    "    \"            ax.set_ylabel(lbl, fontsize=9)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Colorbar for last column\\n\",\n",
    "    \"    sm = plt.cm.ScalarMappable(cmap=\\\"YlOrRd\\\",\\n\",\n",
    "    \"                               norm=mcolors.Normalize(vmin=vmin, vmax=vmax))\\n\",\n",
    "    \"    sm.set_array([])\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Sync axes per variable column ──\\n\",\n",
    "    \"for vi in range(NV):\\n\",\n",
    "    \"    col_axes = [axes[ri, vi] for ri in range(2)]\\n\",\n",
    "    \"    lo_y = min(ax.get_ylim()[0] for ax in col_axes)\\n\",\n",
    "    \"    hi_y = max(ax.get_ylim()[1] for ax in col_axes)\\n\",\n",
    "    \"    lo_x = min(ax.get_xlim()[0] for ax in col_axes)\\n\",\n",
    "    \"    hi_x = max(ax.get_xlim()[1] for ax in col_axes)\\n\",\n",
    "    \"    for ax in col_axes:\\n\",\n",
    "    \"        ax.set_ylim(lo_y, hi_y)\\n\",\n",
    "    \"        ax.set_xlim(lo_x, hi_x)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Sync wind component color scales ──\\n\",\n",
    "    \"wu_i, wv_i = VARS.index(\\\"wind_u\\\"), VARS.index(\\\"wind_v\\\")\\n\",\n",
    "    \"for ri in range(axes.shape[0]):\\n\",\n",
    "    \"    sc_u = axes[ri, wu_i].collections[-1]\\n\",\n",
    "    \"    sc_v = axes[ri, wv_i].collections[-1]\\n\",\n",
    "    \"    vmin = min(sc_u.get_clim()[0], sc_v.get_clim()[0])\\n\",\n",
    "    \"    vmax = max(sc_u.get_clim()[1], sc_v.get_clim()[1])\\n\",\n",
    "    \"    sc_u.set_clim(vmin, vmax)\\n\",\n",
    "    \"    sc_v.set_clim(vmin, vmax)\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig.suptitle(\\\"MAE Transformer visible-station MAE at +3 h — MR=0.0 vs MR=0.5\\\",\\n\",\n",
    "    \"             fontsize=12, y=1.01)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"C.save_fig(fig, \\\"46_vis_mae_map_mr_compare\\\")\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"plt.close(fig)\\n\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"vis_mae_tod\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-09-02T10:36:50.833697Z\",\n",
    "     \"start_time\": \"2026-09-02T10:36:50.028294Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# ── Visible-station MAE vs lead time by TOD — MR=0.0 vs MR=0.5 ──────────────\\n\",\n",
    "    \"TOD_LBL = [\\\"00–06 UTC\\\", \\\"06–12 UTC\\\", \\\"12–18 UTC\\\", \\\"18–24 UTC\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Station sets: the MR=0.5 mask is redrawn every window (each station is\\n\",\n",
    "    \"# visible in ~50% of windows), so EXT5's \\\"vis\\\" accumulators cover ALL 155\\n\",\n",
    "    \"# stations (visible windows only) and EXT0 covers all 155 stations (all\\n\",\n",
    "    \"# windows). Both curves are therefore over the same station set already;\\n\",\n",
    "    \"# VIS_IDX = all stations. (An earlier version restricted to visible_bool[0],\\n\",\n",
    "    \"# which is only the first window's partition — wrong for this dump.)\\n\",\n",
    "    \"VIS_IDX = np.arange(N)\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(4, NV, figsize=(17, 13), sharex=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"for ti, tod_lbl in enumerate(TOD_LBL):\\n\",\n",
    "    \"    for vi, v in enumerate(VARS):\\n\",\n",
    "    \"        ax = axes[ti, vi]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # MR=0.0: same stations as the MR=0.5 visible set\\n\",\n",
    "    \"        mae0_tod = C.pool_stations(EXT0[\\\"tod_mod_sum\\\"], EXT0[\\\"tod_mod_cnt\\\"],\\n\",\n",
    "    \"                                   station_idx=VIS_IDX)\\n\",\n",
    "    \"        ax.plot(range(1, K), mae0_tod[ti, 1:, vi], \\\"o-\\\", ms=2.5, lw=1.2,\\n\",\n",
    "    \"                color=C.MODELS[\\\"v27\\\"][1], label=\\\"MAE Tr. MR=0.0\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # MR=0.5: visible only (already restricted by the vis accumulator)\\n\",\n",
    "    \"        mae5_tod = C.pool_stations(EXT5[\\\"tod_mod_vis_sum\\\"],\\n\",\n",
    "    \"                                   EXT5[\\\"tod_mod_vis_cnt\\\"],\\n\",\n",
    "    \"                                   station_idx=VIS_IDX)\\n\",\n",
    "    \"        ax.plot(range(1, K), mae5_tod[ti, 1:, vi], \\\"s--\\\", ms=2.5, lw=1.2,\\n\",\n",
    "    \"                color=C.MODELS[\\\"v27\\\"][1], alpha=0.6, label=\\\"MAE Tr. MR=0.5 (vis)\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"        ax.grid(alpha=0.3)\\n\",\n",
    "    \"        if ti == 0:\\n\",\n",
    "    \"            ax.set_title(f\\\"{v}  [{C.UNITS[v]}]\\\", fontsize=10)\\n\",\n",
    "    \"        if ti == 3:\\n\",\n",
    "    \"            ax.set_xticks(range(1, K, 2))\\n\",\n",
    "    \"            ax.set_xticklabels(LEAD[1::2], rotation=45, ha=\\\"right\\\", fontsize=6.5)\\n\",\n",
    "    \"    axes[ti, 0].set_ylabel(f\\\"{tod_lbl}\\\\nMAE\\\", fontsize=9)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Sync y-axis per variable column across rows ──\\n\",\n",
    "    \"for vi in range(NV):\\n\",\n",
    "    \"    col_axes = [axes[ti, vi] for ti in range(4)]\\n\",\n",
    "    \"    lo = min(ax.get_ylim()[0] for ax in col_axes)\\n\",\n",
    "    \"    hi = max(ax.get_ylim()[1] for ax in col_axes)\\n\",\n",
    "    \"    for ax in col_axes:\\n\",\n",
    "    \"        ax.set_ylim(lo, hi)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Sync wind components ──\\n\",\n",
    "    \"wu_i, wv_i = VARS.index(\\\"wind_u\\\"), VARS.index(\\\"wind_v\\\")\\n\",\n",
    "    \"lo = min(axes[0, wu_i].get_ylim()[0], axes[0, wv_i].get_ylim()[0])\\n\",\n",
    "    \"hi = max(axes[0, wu_i].get_ylim()[1], axes[0, wv_i].get_ylim()[1])\\n\",\n",
    "    \"for ri in range(axes.shape[0]):\\n\",\n",
    "    \"    axes[ri, wu_i].set_ylim(lo, hi)\\n\",\n",
    "    \"    axes[ri, wv_i].set_ylim(lo, hi)\\n\",\n",
    "    \"\\n\",\n",
    "    \"axes[0, -1].legend(fontsize=6, loc=\\\"upper left\\\")\\n\",\n",
    "    \"fig.suptitle(\\\"MAE Transformer visible-station MAE vs lead time by TOD — \\\"\\n\",\n",
    "    \"             \\\"MR=0.0 vs MR=0.5\\\", y=1.01, fontsize=12)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"C.save_fig(fig, \\\"46_vis_mae_tod_mr_compare\\\")\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"plt.close(fig)\\n\"\n",
