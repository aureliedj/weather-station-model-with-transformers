    "    \"    (f\\\"W_i (λ={LAMBDA_KM})\\\", W_i),\\n\",\n",
    "    \"    (\\\"d_NN [km]\\\", d_NN),\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(len(predictors), NV,\\n\",\n",
    "    \"                         figsize=(17, 3.0 * len(predictors)),\\n\",\n",
    "    \"                         squeeze=False, constrained_layout=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"sa_corr_table = []  # for summary\\n\",\n",
    "    \"\\n\",\n",
    "    \"for pi, (pname, px) in enumerate(predictors):\\n\",\n",
