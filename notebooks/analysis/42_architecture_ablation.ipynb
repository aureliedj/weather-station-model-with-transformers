    "    \"\\n\",\n",
    "    \"# ── Row 2: SA gain = MAE(blind) − MAE(dense), positive = Dense better ──\\n\",\n",
    "    \"sa_gain = []\\n\",\n",
    "    \"for vi in SEL_VI:\\n\",\n",
    "    \"    cnt_b = EXT_GAIN[\\\"v32-blind\\\"][\\\"tod_mod_cnt\\\"][TOD_I, REF_KI, :, vi]\\n\",\n",
    "    \"    s_b   = EXT_GAIN[\\\"v32-blind\\\"][\\\"tod_mod_sum\\\"][TOD_I, REF_KI, :, vi]\\n\",\n",
    "    \"    mae_b = np.where(cnt_b > 0, s_b / np.maximum(cnt_b, 1), np.nan)\\n\",\n",
    "    \"    cnt_d = EXT_GAIN[\\\"v31\\\"][\\\"tod_mod_cnt\\\"][TOD_I, REF_KI, :, vi]\\n\",\n",
