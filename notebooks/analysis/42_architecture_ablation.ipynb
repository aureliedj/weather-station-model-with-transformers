    "    \"    mae_d = np.where(cnt_d > 0, s_d / np.maximum(cnt_d, 1), np.nan)\\n\",\n",
    "    \"    msk_gain.append(mae_v - mae_d)  # positive = Dense wins\\n\",\n",
    "    \"\\n\",\n",
    "    \"ROW_LABELS = [\\\"Dense MAE\\\", \\\"SA gain\\\\n(Blind − Dense)\\\", \\\"Masking cost\\\\n(MAE Tr. − Dense)\\\"]\\n\",\n",
    "    \"ROW_DATA   = [dense_mae, sa_gain, msk_gain]\\n\",\n",
    "    \"ROW_CMAP   = [\\\"magma\\\", \\\"PRGn\\\", \\\"PRGn\\\"]\\n\",\n",
