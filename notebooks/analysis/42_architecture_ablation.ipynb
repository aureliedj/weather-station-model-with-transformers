    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"t\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 4.2 — Contribution of Temporal Architecture and Spatial Attention\\n\",\n",
    "    \"\\n\",\n",
    "    \"Ablation chain: LSTM (per-station recurrence) → Spatially Blind\\n\",\n",
    "    \"Transformer (temporal attention only) → Dense (full\\n\",\n",
    "    \"factorised attention). All at MR=0.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"boot\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"import os, sys, datetime as dt\\nimport numpy as np, pandas as pd, matplotlib.pyplot as plt\\nimport matplotlib.colors as mcolors\\nfor _cand in (os.getcwd(),\\n              os.path.join(os.getcwd(), \\\"notebooks\\\", \\\"analysis\\\"),\\n              os.path.dirname(os.path.abspath(\\\"__file__\\\"))):\\n    if os.path.isfile(os.path.join(_cand, \\\"common.py\\\")):\\n        if _cand not in sys.path: sys.path.insert(0, _cand)\\n        break\\nimport importlib, common as C; importlib.reload(C)\\nplt.style.use(\\\"default\\\")\\nplt.rcParams.update({\\\"figure.dpi\\\": 110, \\\"font.size\\\": 10,\\n                     \\\"figure.facecolor\\\": \\\"white\\\", \\\"axes.facecolor\\\": \\\"white\\\",\\n                     \\\"savefig.facecolor\\\": \\\"white\\\", \\\"axes.edgecolor\\\": \\\"0.3\\\",\\n                     \\\"axes.labelcolor\\\": \\\"black\\\", \\\"xtick.color\\\": \\\"0.3\\\",\\n                     \\\"ytick.color\\\": \\\"0.3\\\", \\\"text.color\\\": \\\"black\\\"})\\n\\nRUNS  = C.discovered_runs()\\nMR0_RUNS = [r for r in RUNS if \\\"mr0.00\\\" in RUNS[r]]\\nns = C.norm_stats(); VARS = ns[\\\"var_names\\\"]; STD = ns[\\\"std\\\"]\\nstn = C.station_table(); KEEP = C.keep_mask(stn, VARS)\\nAGG  = {r: C.load_agg(r, \\\"mr0.00\\\") for r in MR0_RUNS}\\nGRID = AGG[MR0_RUNS[0]][\\\"grid\\\"]; LEAD = C.lead_labels(GRID); K = len(GRID)\\nNV = len(VARS)\\nprint(\\\"Models at MR=0.00:\\\", MR0_RUNS)\\n\\n# Ablation chain\\n# Free AGG entries not in the ablation chain after CHAIN is defined\\n_NEEDED_42 = set()\\nCHAIN = [\\\"v32-blind\\\", \\\"v31\\\"]\\nCHAIN_LABELS = [C.MODELS[r][0] for r in CHAIN]\\nCHAIN_COLORS = [C.MODELS[r][1] for r in CHAIN]\\n# Reference lead ≈ 3 h → index 6\\nREF_KI = 6; REF_LEAD = LEAD[REF_KI]\\nprint(f\\\"Reference lead: {REF_LEAD} (index {REF_KI})\\\")\\n# Free unused AGG entries\\n_needed = set(CHAIN) | {'v32-blind', 'v31', 'v27'}\\nfor _r in list(AGG):\\n    if _r not in _needed:\\n        del AGG[_r]\\nimport gc; gc.collect()\\n\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"p1_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## MAE vs lead — ablation chain\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"p3_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Spatial-attention gain: MAE(Blind) − MAE(Dense)\\n\",\n",
    "    \"\\n\",\n",
    "    \"Positive = Dense is better (spatial attention helps).\\n\",\n",
    "    \"This is the most directly interpretable spatial-attention result.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"p3\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"fig, axes = plt.subplots(1, NV, figsize=(17, 3.3))\\n\",\n",
    "    \"for vi, (ax, v) in enumerate(zip(axes, VARS)):\\n\",\n",
    "    \"    m_blind = C.metric(AGG[\\\"v32-blind\\\"], \\\"mae\\\", pool=(\\\"N\\\",))[:, vi]\\n\",\n",
    "    \"    m_dense = C.metric(AGG[\\\"v31\\\"], \\\"mae\\\", pool=(\\\"N\\\",))[:, vi]\\n\",\n",
    "    \"    gain = m_blind - m_dense\\n\",\n",
    "    \"    ax.bar(range(1, K), gain[1:], color=\\\"#5FAF5F\\\", edgecolor=\\\"k\\\", lw=0.4, alpha=0.7)\\n\",\n",
    "    \"    ax.axhline(0, ls=\\\":\\\", color=\\\"k\\\", lw=0.8)\\n\",\n",
    "    \"    ax.set_xticks(range(1, K, 2))\\n\",\n",
    "    \"    ax.set_xticklabels(LEAD[1::2], rotation=45, ha=\\\"right\\\", fontsize=6.5)\\n\",\n",
    "    \"    ax.set_title(f\\\"{v}  [{C.UNITS[v]}]\\\", fontsize=10); ax.grid(alpha=.3)\\n\",\n",
    "    \"axes[0].set_ylabel(\\\"MAE(Blind) − MAE(Dense)\\\")\\n\",\n",
    "    \"fig.suptitle(\\\"Spatial-attention gain: MAE(Spatially Blind) − MAE(Dense) vs lead time, MR=0, all stations\\\", y=1.04)\\n\",\n",
    "    \"plt.tight_layout(); C.save_fig(fig, \\\"42_spatial_attn_gain\\\"); plt.show()\\n\",\n",
    "    \"plt.close(fig)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Numerical summary at REF_KI\\n\",\n",
    "    \"print(f\\\"\\\\nSpatial-attention gain at {REF_LEAD}:\\\")\\n\",\n",
    "    \"for vi, v in enumerate(VARS):\\n\",\n",
    "    \"    mb = C.metric(AGG[\\\"v32-blind\\\"], \\\"mae\\\", pool=(\\\"N\\\",))[REF_KI, vi]\\n\",\n",
    "    \"    md = C.metric(AGG[\\\"v31\\\"], \\\"mae\\\", pool=(\\\"N\\\",))[REF_KI, vi]\\n\",\n",
    "    \"    print(f\\\"  {v:>12s}: {mb - md:+.3f} {C.UNITS[v]}  \\\"\\n\",\n",
    "    \"          f\\\"({100*(mb - md)/mb:+.1f}%)\\\")\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"bdbec8a387b447e5\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### Spatial-attention gain on the map\\n\",\n",
    "    \"\\n\",\n",
    "    \"Same quantity as above (MAE(Blind) − MAE(Dense) at the reference lead),\\n\",\n",
    "    \"per station, plotted spatially instead of pooled across the network.\\n\",\n",
    "    \"Positive (green) = Dense wins at that station, i.e. spatial\\n\",\n",
    "    \"attention helps there; negative (purple) = the Spatially Blind\\n\",\n",
    "    \"does better locally.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"aa825d4160ec49e6\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# ── DEM + Swiss border, for the map below (same as 47_topographic_controls) ──\\n\",\n",
    "    \"import geopandas as gpd\\n\",\n",
    "    \"import rioxarray  # noqa\\n\",\n",
    "    \"\\n\",\n",
    "    \"PROJ = os.path.abspath(os.path.join(os.getcwd(), \\\"..\\\", \\\"..\\\")) \\\\\\n\",\n",
    "    \"       if os.path.isfile(\\\"common.py\\\") else os.getcwd()\\n\",\n",
    "    \"if os.path.join(PROJ, \\\"src\\\") not in sys.path:\\n\",\n",
    "    \"    sys.path.insert(0, os.path.join(PROJ, \\\"src\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"PATH_SWISSSHAPE = os.path.expanduser(\\n\",\n",
    "    \"    os.environ.get(\\\"SWISSSHAPE\\\",\\n\",\n",
    "    \"        os.path.join(PROJ, \\\"swissboundaries3d_2056.shp.zip\\\")))\\n\",\n",
    "    \"_CAND = [os.environ.get(\\\"DATA_ROOT\\\", \\\"\\\"),\\n\",\n",
    "    \"         os.path.expanduser(\\\"~/PeakWeatherDataset\\\"),\\n\",\n",
    "    \"         os.path.join(PROJ, \\\"PeakWeatherDataset\\\")]\\n\",\n",
    "    \"DATA_ROOT = next((p for p in _CAND if os.path.isdir(str(p))), _CAND[-1])\\n\",\n",
    "    \"\\n\",\n",
    "    \"from peakweather.dataset import PeakWeatherDataset\\n\",\n",
    "    \"ds_topo = PeakWeatherDataset(\\n\",\n",
    "    \"    root=DATA_ROOT,\\n\",\n",
    "    \"    parameters=[\\\"temperature\\\", \\\"pressure\\\", \\\"humidity\\\",\\n\",\n",
    "    \"                 \\\"wind_speed\\\", \\\"wind_direction\\\", \\\"precipitation\\\"],\\n\",\n",
    "    \"    compute_uv=True, station_type=\\\"meteo_station\\\",\\n\",\n",
    "    \"    imputation_method=None, freq=\\\"d\\\", extended_topo_vars=\\\"DEM\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _load_dem_and_border(ds_topo, path_swissshape, coarsen=10):\\n\",\n",
    "    \"    switzerland = gpd.read_file(\\n\",\n",
    "    \"        path_swissshape,\\n\",\n",
    "    \"        layer='swissBOUNDARIES3D_1_5_TLM_LANDESGEBIET').to_crs('EPSG:2056')\\n\",\n",
    "    \"    minx, miny, maxx, maxy = switzerland.total_bounds\\n\",\n",
    "    \"    topo = ds_topo.load_topography()\\n\",\n",
    "    \"    dem  = topo['topo_DEM'].dem\\n\",\n",
    "    \"    dem_ch = dem.rio.clip(switzerland.geometry, switzerland.crs, drop=False)\\n\",\n",
    "    \"    dem_bg = dem.coarsen(x=coarsen, y=coarsen, boundary='trim').mean()\\n\",\n",
    "    \"    dem_fg = dem_ch.coarsen(x=coarsen, y=coarsen, boundary='trim').mean()\\n\",\n",
    "    \"    dem_bg = dem_bg.sel(x=slice(minx, maxx), y=slice(miny, maxy))\\n\",\n",
    "    \"    dem_fg = dem_fg.sel(x=slice(minx, maxx), y=slice(miny, maxy))\\n\",\n",
    "    \"    return dem_bg, dem_fg, switzerland\\n\",\n",
    "    \"\\n\",\n",
    "    \"def draw_dem(ax, dem_bg, dem_fg, switzerland):\\n\",\n",
    "    \"    norm = mcolors.Normalize(vmin=0, vmax=4500)\\n\",\n",
    "    \"    dem_bg.plot(ax=ax, cmap='terrain', norm=norm, alpha=0.35,\\n\",\n",
    "    \"                robust=True, add_labels=False, add_colorbar=False)\\n\",\n",
    "    \"    dem_fg.plot(ax=ax, cmap='terrain', norm=norm,\\n\",\n",
    "    \"                robust=True, add_labels=False, add_colorbar=False)\\n\",\n",
    "    \"    switzerland.boundary.plot(ax=ax, color='white', linewidth=1.0)\\n\",\n",
    "    \"    ax.axis('off')\\n\",\n",
    "    \"\\n\",\n",
    "    \"print('Loading DEM + border ...')\\n\",\n",
    "    \"dem_bg, dem_fg, switzerland = _load_dem_and_border(ds_topo, PATH_SWISSSHAPE)\\n\",\n",
    "    \"print('Done.')\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"6f7012adf3c24c29\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Exclusion overlay\\n\",\n",
    "    \"\\n\",\n",
    "    \"Every per-station scatter map below also marks stations excluded for that\\n\",\n",
    "    \"variable (`common.excluded_station_variable_reasons()`) with an X:\\n\",\n",
    "    \"**black** = missing in both train and test, **white** = missing in train\\n\",\n",
    "    \"only, **grey** = missing in test only, **orange** = present in both splits\\n\",\n",
    "    \"but excluded for a data-quality reason (BIZ/pressure, sensor drift).\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"d7ac2d5f4e1b4f4f\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"REASON_STYLE = {\\n\",\n",
    "    \"    \\\"missing_train\\\": dict(color=\\\"white\\\",   label=\\\"missing in train only\\\"),\\n\",\n",
    "    \"    \\\"missing_test\\\":  dict(color=\\\"0.6\\\",     label=\\\"missing in test only\\\"),\\n\",\n",
    "    \"    \\\"missing_both\\\":  dict(color=\\\"black\\\",   label=\\\"missing in train & test\\\"),\\n\",\n",
    "    \"    \\\"drift\\\":         dict(color=\\\"#E8A838\\\", label=\\\"excluded \\\\u2014 sensor drift\\\"),\\n\",\n",
    "    \"}\\n\",\n",
    "    \"EXCL_REASONS = C.excluded_station_variable_reasons()\\n\",\n",
    "    \"\\n\",\n",
    "    \"def overlay_exclusion_markers(ax, variable, s=70, legend=False):\\n\",\n",
    "    \"    return  # X markers removed per user request\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"23d03f8cfec3451c\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# ── MAE of Dense (v31) per station at +3h by TOD, MR=0.0 ────────────────────\\n\",\n",
    "    \"TOD_LABELS = [\\\"00–06 UTC\\\", \\\"06–12 UTC\\\", \\\"12–18 UTC\\\", \\\"18–24 UTC\\\"]\\n\",\n",
    "    \"EXT = {r: dict(np.load(C.aggregate_extended(r, \\\"mr0.00\\\"))) for r in [\\\"v31\\\", \\\"v32-blind\\\", \\\"v27\\\"]}\\n\",\n",
    "    \"e_dense = EXT[\\\"v31\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(len(TOD_LABELS), NV,\\n\",\n",
    "    \"                         figsize=(6.0 * NV, 3.5 * len(TOD_LABELS)), squeeze=False)\\n\",\n",
    "    \"for ti, tod_label in enumerate(TOD_LABELS):\\n\",\n",
    "    \"    for vi, v in enumerate(VARS):\\n\",\n",
    "    \"        ax = axes[ti, vi]\\n\",\n",
    "    \"        draw_dem(ax, dem_bg, dem_fg, switzerland)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        cnt_d = e_dense[\\\"tod_mod_cnt\\\"][ti, REF_KI, :, vi]\\n\",\n",
    "    \"        s_d   = e_dense[\\\"tod_mod_sum\\\"][ti, REF_KI, :, vi]\\n\",\n",
    "    \"        mae_d = np.where(cnt_d > 0, s_d / np.maximum(cnt_d, 1), np.nan)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        valid = ~np.isnan(mae_d)\\n\",\n",
    "    \"        sc = ax.scatter(stn.easting[valid], stn.northing[valid], c=mae_d[valid],\\n\",\n",
    "    \"                        s=45, cmap=\\\"magma\\\", edgecolors=\\\"k\\\", linewidths=0.3, zorder=5)\\n\",\n",
    "    \"        fig.colorbar(sc, ax=ax, fraction=0.03, pad=0.02,\\n\",\n",
    "    \"                     label=f\\\"MAE [{C.UNITS[v]}]\\\")\\n\",\n",
    "    \"        if ti == 0:\\n\",\n",
    "    \"            ax.set_title(f\\\"{v} at {REF_LEAD}\\\", fontsize=11)\\n\",\n",
    "    \"        if vi == 0:\\n\",\n",
    "    \"            ax.text(-0.06, 0.5, tod_label, transform=ax.transAxes, rotation=90,\\n\",\n",
    "    \"                    va=\\\"center\\\", ha=\\\"center\\\", fontsize=10)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Sync color scale per variable column ──\\n\",\n",
    "    \"for vi in range(NV):\\n\",\n",
    "    \"    col_axes = [axes[ri, vi] for ri in range(len(TOD_LABELS))]\\n\",\n",
    "    \"    col_sc = [ax.collections[-1] for ax in col_axes if ax.collections]\\n\",\n",
    "    \"    all_vals = np.concatenate([s.get_array() for s in col_sc])\\n\",\n",
    "    \"    vmin, vmax = np.nanmin(all_vals), np.nanmax(all_vals)\\n\",\n",
    "    \"    for s in col_sc:\\n\",\n",
    "    \"        s.set_clim(vmin, vmax)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Sync spatial axes per variable column ──\\n\",\n",
    "    \"for vi in range(NV):\\n\",\n",
    "    \"    col_axes = [axes[ri, vi] for ri in range(len(TOD_LABELS))]\\n\",\n",
    "    \"    lo = min(ax.get_ylim()[0] for ax in col_axes)\\n\",\n",
    "    \"    hi = max(ax.get_ylim()[1] for ax in col_axes)\\n\",\n",
    "    \"    for ax in col_axes:\\n\",\n",
    "    \"        ax.set_ylim(lo, hi)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Sync wind component color scales ──\\n\",\n",
    "    \"wu_i, wv_i = VARS.index(\\\"wind_u\\\"), VARS.index(\\\"wind_v\\\")\\n\",\n",
    "    \"for ri in range(axes.shape[0]):\\n\",\n",
    "    \"    sc_u = axes[ri, wu_i].collections[-1]\\n\",\n",
    "    \"    sc_v = axes[ri, wv_i].collections[-1]\\n\",\n",
    "    \"    vmin = min(sc_u.get_clim()[0], sc_v.get_clim()[0])\\n\",\n",
    "    \"    vmax = max(sc_u.get_clim()[1], sc_v.get_clim()[1])\\n\",\n",
    "    \"    sc_u.set_clim(vmin, vmax)\\n\",\n",
    "    \"    sc_v.set_clim(vmin, vmax)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"C.save_fig(fig, \\\"42_dense_mae_map_tod\\\")\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"plt.close(fig)\\n\",\n",
    "    \"\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"0d4a5ed032954299\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### Spatial-attention gain on the map, by time of day\\n\",\n",
    "    \"\\n\",\n",
    "    \"Same map as above, faceted by UTC time-of-day bin (rows) instead of pooled\\n\",\n",
    "    \"over the full test period. Colour scale is shared across the four bins\\n\",\n",
    "    \"within each variable (column), so a station's colour can be compared\\n\",\n",
    "    \"across rows directly — differences between rows are not a scale artefact.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"76d07f2ce7034270\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# ── Spatial-attention gain map by time-of-day bin ───────────────────────────\\n\",\n",
    "    \"TOD_LABELS = [\\\"00\\\\u201306 UTC\\\", \\\"06\\\\u201312 UTC\\\", \\\"12\\\\u201318 UTC\\\", \\\"18\\\\u201324 UTC\\\"]\\n\",\n",
    "    \"EXT_GAIN = {r: EXT[r] for r in [\\\"v32-blind\\\", \\\"v31\\\"]}  # reuse from EXT\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Per (tod bin, variable) gain, computed once so the colour scale can be\\n\",\n",
    "    \"# shared across bins within a variable (pooling all 4 bins' finite values).\\n\",\n",
    "    \"gain_by_bin = {}\\n\",\n",
    "    \"for ti in range(len(TOD_LABELS)):\\n\",\n",
    "    \"    row = []\\n\",\n",
    "    \"    for vi in range(NV):\\n\",\n",
    "    \"        cnt_b = EXT_GAIN[\\\"v32-blind\\\"][\\\"tod_mod_cnt\\\"][ti, REF_KI, :, vi]\\n\",\n",
    "    \"        s_b   = EXT_GAIN[\\\"v32-blind\\\"][\\\"tod_mod_sum\\\"][ti, REF_KI, :, vi]\\n\",\n",
    "    \"        mae_b = np.where(cnt_b > 0, s_b / np.maximum(cnt_b, 1), np.nan)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        cnt_d = EXT_GAIN[\\\"v31\\\"][\\\"tod_mod_cnt\\\"][ti, REF_KI, :, vi]\\n\",\n",
    "    \"        s_d   = EXT_GAIN[\\\"v31\\\"][\\\"tod_mod_sum\\\"][ti, REF_KI, :, vi]\\n\",\n",
    "    \"        mae_d = np.where(cnt_d > 0, s_d / np.maximum(cnt_d, 1), np.nan)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        row.append(mae_b - mae_d)                 # positive = Dense wins locally\\n\",\n",
    "    \"    gain_by_bin[ti] = row\\n\",\n",
    "    \"\\n\",\n",
    "    \"vmax_per_var = []\\n\",\n",
    "    \"for vi in range(NV):\\n\",\n",
    "    \"    allv = np.concatenate([gain_by_bin[ti][vi][~np.isnan(gain_by_bin[ti][vi])]\\n\",\n",
    "    \"                           for ti in range(len(TOD_LABELS))])\\n\",\n",
    "    \"    vmax_per_var.append(np.nanpercentile(np.abs(allv), 98) if allv.size else 1.0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Sync wind component color scales ──\\n\",\n",
    "    \"wu_i, wv_i = VARS.index(\\\"wind_u\\\"), VARS.index(\\\"wind_v\\\")\\n\",\n",
    "    \"wind_vmax = max(vmax_per_var[wu_i], vmax_per_var[wv_i])\\n\",\n",
