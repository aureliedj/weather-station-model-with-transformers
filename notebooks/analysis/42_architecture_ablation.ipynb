    "    \"    for ax in col_axes:\\n\",\n",
    "    \"        ax.set_ylim(lo, hi)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout(h_pad=0.5)\\n\",\n",
    "    \"fig.suptitle(\\\"Station maps at +3 h for forecasts initialised 06–12 UTC, all stations visible (MR=0)\\\\n\\\"\\n\",\n",
    "    \"             \\\"top: Dense MAE — middle: MAE(Spatially Blind) − MAE(Dense) — bottom: MAE(MAE Transformer) − MAE(Dense); green = Dense better\\\",\\n\",\n",
    "    \"             fontsize=13, y=1.005)\\n\",\n",
    "    \"C.save_fig(fig, \\\"42_morning_mae_sa_msk_maps\\\")\\n\",\n",
