    "    \"            sc = ax.scatter(stn.easting[valid], stn.northing[valid], c=vals[valid],\\n\",\n",
    "    \"                            s=45, cmap=\\\"magma\\\", edgecolors=\\\"k\\\", linewidths=0.3, zorder=5)\\n\",\n",
    "    \"            fig.colorbar(sc, ax=ax, fraction=0.03, pad=0.02,\\n\",\n",
    "    \"                         label=f\\\"MAE [{C.UNITS[v]}]\\\")\\n\",\n",
    "    \"        elif ri == 1:  # SA gain — diverging\\n\",\n",
    "    \"            vm = vmax_sa[ci]\\n\",\n",
    "    \"            sc = ax.scatter(stn.easting[valid], stn.northing[valid], c=vals[valid],\\n\",\n",
    "    \"                            s=45, cmap=\\\"PRGn\\\", vmin=-vm, vmax=vm,\\n\",\n",
    "    \"                            edgecolors=\\\"k\\\", linewidths=0.3, zorder=5)\\n\",\n",
    "    \"            fig.colorbar(sc, ax=ax, fraction=0.03, pad=0.02,\\n\",\n",
    "    \"                         label=f\\\"[{C.UNITS[v]}]\\\")\\n\",\n",
    "    \"        else:  # masking gain — diverging\\n\",\n",
    "    \"            vm = vmax_mk[ci]\\n\",\n",
