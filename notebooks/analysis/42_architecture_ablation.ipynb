    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"sd_gain_tod_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### Error-SD difference on the map, by time of day\\n\",\n",
    "    \"\\n\",\n",
    "    \"Same layout as the MAE gain map above, but showing\\n\",\n",
    "    \"σₑ(Blind) − σₑ(Dense) per station per TOD bin.\\n\",\n",
    "    \"Positive (green) = Dense has lower error variability.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"sd_gain_tod_plot\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# ── Error-SD difference map by time-of-day bin ───────────────────────────────\\n\",\n",
    "    \"# σₑ(Blind) − σₑ(Dense) per station, faceted by TOD.\\n\",\n",
    "    \"# Reuses EXT_GAIN loaded earlier.\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _station_sd(ext, ti, ki, vi):\\n\",\n",
    "    \"    \\\"\\\"\\\"Per-station error SD for a single (tod, lead, var) slice.\\\"\\\"\\\"\\n\",\n",
    "    \"    sq = ext[\\\"tod_mod_sumsq\\\"][ti, ki, :, vi]    # (N,)\\n\",\n",
    "    \"    sg = ext[\\\"tod_mod_signed\\\"][ti, ki, :, vi]\\n\",\n",
    "    \"    cn = ext[\\\"tod_mod_cnt\\\"][ti, ki, :, vi]\\n\",\n",
    "    \"    with np.errstate(invalid=\\\"ignore\\\", divide=\\\"ignore\\\"):\\n\",\n",
    "    \"        e2 = np.where(cn > 0, sq / cn, np.nan)\\n\",\n",
    "    \"        em = np.where(cn > 0, sg / cn, np.nan)\\n\",\n",
    "    \"        sd = np.sqrt(np.maximum(e2 - em**2, 0))\\n\",\n",
    "    \"    return np.where(cn > 0, sd, np.nan)\\n\",\n",
    "    \"\\n\",\n",
    "    \"sd_diff_by_bin = {}\\n\",\n",
    "    \"for ti in range(len(TOD_LABELS)):\\n\",\n",
    "    \"    row = []\\n\",\n",
    "    \"    for vi in range(NV):\\n\",\n",
    "    \"        sd_b = _station_sd(EXT_GAIN[\\\"v32-blind\\\"], ti, REF_KI, vi)\\n\",\n",
    "    \"        sd_d = _station_sd(EXT_GAIN[\\\"v31\\\"], ti, REF_KI, vi)\\n\",\n",
    "    \"        row.append(sd_b - sd_d)  # positive = Dense has lower σₑ\\n\",\n",
    "    \"    sd_diff_by_bin[ti] = row\\n\",\n",
    "    \"\\n\",\n",
    "    \"vmax_sd = []\\n\",\n",
    "    \"for vi in range(NV):\\n\",\n",
    "    \"    allv = np.concatenate([sd_diff_by_bin[ti][vi][\\n\",\n",
    "    \"        ~np.isnan(sd_diff_by_bin[ti][vi])] for ti in range(len(TOD_LABELS))])\\n\",\n",
    "    \"    vmax_sd.append(np.nanpercentile(np.abs(allv), 98) if allv.size else 1.0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(len(TOD_LABELS), NV,\\n\",\n",
    "    \"                         figsize=(6.0 * NV, 3.5 * len(TOD_LABELS)), squeeze=False)\\n\",\n",
    "    \"for ti, tod_label in enumerate(TOD_LABELS):\\n\",\n",
    "    \"    for vi, v in enumerate(VARS):\\n\",\n",
    "    \"        ax = axes[ti, vi]\\n\",\n",
    "    \"        draw_dem(ax, dem_bg, dem_fg, switzerland)\\n\",\n",
    "    \"        diff = sd_diff_by_bin[ti][vi]\\n\",\n",
    "    \"        valid = ~np.isnan(diff)\\n\",\n",
    "    \"        vmax = vmax_sd[vi]\\n\",\n",
    "    \"        sc = ax.scatter(stn.easting[valid], stn.northing[valid], c=diff[valid],\\n\",\n",
    "    \"                        s=45, cmap=\\\"PRGn\\\", vmin=-vmax, vmax=vmax,\\n\",\n",
    "    \"                        edgecolors=\\\"k\\\", linewidths=0.3, zorder=5)\\n\",\n",
    "    \"        overlay_exclusion_markers(ax, v, legend=(ti == 0 and vi == 0))\\n\",\n",
    "    \"        fig.colorbar(sc, ax=ax, fraction=0.03, pad=0.02, label=f\\\"[{C.UNITS[v]}]\\\")\\n\",\n",
    "    \"        if ti == 0:\\n\",\n",
    "    \"            ax.set_title(f\\\"{v} at {REF_LEAD}\\\", fontsize=11)\\n\",\n",
    "    \"        if vi == 0:\\n\",\n",
    "    \"            ax.text(-0.06, 0.5, tod_label, transform=ax.transAxes, rotation=90,\\n\",\n",
    "    \"                   va=\\\"center\\\", ha=\\\"center\\\", fontsize=10)\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig.suptitle(\\\"Error-SD difference by station and time of day\\\\n\\\"\\n\",\n",
