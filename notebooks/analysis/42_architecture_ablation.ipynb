    "    \"for ri in range(NROWS):\\n\",\n",
    "    \"    for ci, (v, vi) in enumerate(zip(SEL_VARS, SEL_VI)):\\n\",\n",
    "    \"        ax = axes[ri, ci]\\n\",\n",
    "    \"        draw_dem(ax, dem_bg, dem_fg, switzerland)\\n\",\n",
