    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# ── Morning 06–12 UTC maps: Dense MAE, SA gain, masking gain ─────────────────\\n\",\n",
    "    \"SEL_VARS = [\\\"temperature\\\", \\\"pressure\\\", \\\"humidity\\\", \\\"wind_u\\\"]\\n\",\n",
