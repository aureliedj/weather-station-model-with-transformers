    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"t\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 4.4 — Temporal and Seasonal Variability\\n\\nDiurnal and monthly MAE at Δ ≈ 3 h, MR=0.\\nUses the extended aggregation (per-TOD, per-month) cached by common.py.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"boot\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"import os, sys, datetime as dt\\n\",\n",
    "    \"import numpy as np, pandas as pd, matplotlib.pyplot as plt\\n\",\n",
    "    \"import matplotlib.colors as mcolors\\n\",\n",
    "    \"for _cand in (os.getcwd(),\\n\",\n",
    "    \"              os.path.join(os.getcwd(), \\\"notebooks\\\", \\\"analysis\\\"),\\n\",\n",
    "    \"              os.path.dirname(os.path.abspath(\\\"__file__\\\"))):\\n\",\n",
    "    \"    if os.path.isfile(os.path.join(_cand, \\\"common.py\\\")):\\n\",\n",
    "    \"        if _cand not in sys.path: sys.path.insert(0, _cand)\\n\",\n",
    "    \"        break\\n\",\n",
    "    \"import importlib, common as C; importlib.reload(C)\\n\",\n",
    "    \"plt.style.use(\\\"default\\\")\\nplt.rcParams.update({\\\"figure.dpi\\\": 110, \\\"font.size\\\": 10,\\n                     \\\"figure.facecolor\\\": \\\"white\\\", \\\"axes.facecolor\\\": \\\"white\\\",\\n                     \\\"savefig.facecolor\\\": \\\"white\\\", \\\"axes.edgecolor\\\": \\\"0.3\\\",\\n                     \\\"axes.labelcolor\\\": \\\"black\\\", \\\"xtick.color\\\": \\\"0.3\\\",\\n                     \\\"ytick.color\\\": \\\"0.3\\\", \\\"text.color\\\": \\\"black\\\"})\\n\",\n",
    "    \"\\n\",\n",
    "    \"RUNS  = C.discovered_runs()\\n\",\n",
    "    \"MR0_RUNS = [r for r in RUNS if \\\"mr0.00\\\" in RUNS[r]]\\n\",\n",
    "    \"ns = C.norm_stats(); VARS = ns[\\\"var_names\\\"]; STD = ns[\\\"std\\\"]\\n\",\n",
    "    \"stn = C.station_table(); KEEP = C.keep_mask(stn, VARS)\\n\",\n",
    "    \"AGG  = {r: C.load_agg(r, \\\"mr0.00\\\") for r in MR0_RUNS}\\n\",\n",
    "    \"GRID = AGG[MR0_RUNS[0]][\\\"grid\\\"]; LEAD = C.lead_labels(GRID); K = len(GRID)\\n\",\n",
    "    \"NV = len(VARS)\\n\",\n",
    "    \"print(\\\"Models at MR=0.00:\\\", MR0_RUNS)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Extended aggregation — per-TOD and per-month\\n\",\n",
    "    \"EXT = {r: C.load_ext(r, \\\"mr0.00\\\") for r in MR0_RUNS}\\n\",\n",
    "    \"REF_KI = 6  # ≈ 3 h\\n\",\n",
    "    \"print(f\\\"Reference lead: {LEAD[REF_KI]}\\\")\\n\",\n",
    "    \"print(\\\"Extended caches loaded.\\\")\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"p1_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Diurnal MAE at Δ ≈ 3 h — by season\\n\",\n",
    "    \"\\n\",\n",
    "    \"MAE at each 2-hour forecast-origin window (0–2 h, 2–4 h, …, 22–24 h UTC),\\n\",\n",
    "    \"split by season. One row per season, one column per variable.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"p1\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# ── Compute 2-hourly × season cross-tabulation ───────────────────────────────\\n\",\n",
    "    \"import torch, datetime\\n\",\n",
    "    \"\\n\",\n",
    "    \"SEASON_LABELS = [\\\"DJF\\\", \\\"MAM\\\", \\\"JJA\\\", \\\"SON\\\"]\\n\",\n",
    "    \"N_HBINS = 12  # 2-hour bins: [0,2), [2,4), ..., [22,24)\\n\",\n",
    "    \"HBIN_LABELS = [f\\\"{2*i}–{2*i+2}\\\" for i in range(N_HBINS)]\\n\",\n",
    "    \"HBIN_CENTRES = np.arange(1, 24, 2)  # 1, 3, 5, ..., 23\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _hbin_of(hours):\\n\",\n",
    "    \"    \\\"\\\"\\\"Hours-since-epoch -> 2-hour bin index 0..11.\\\"\\\"\\\"\\n\",\n",
    "    \"    return (hours % 24 / 2).astype(int)\\n\",\n",
    "    \"\\n\",\n",
    "    \"def compute_hbin_season(run, mr=\\\"mr0.00\\\"):\\n\",\n",
    "    \"    \\\"\\\"\\\"Return (4_sea, 12_hbin, K, V) model MAE and persistence MAE.\\\"\\\"\\\"\\n\",\n",
    "    \"    ns_ = C.norm_stats()\\n\",\n",
    "    \"    VAR_ = ns_[\\\"var_names\\\"]; STD_ = ns_[\\\"std\\\"]\\n\",\n",
    "    \"    stn_ = C.station_table(); KEEP_ = C.keep_mask(stn_, VAR_)\\n\",\n",
    "    \"    raw = C.raw_test_obs()\\n\",\n",
    "    \"    OBS, OMSK, H0, NT = raw[\\\"obs\\\"], raw[\\\"mask\\\"], raw[\\\"h0\\\"], raw[\\\"nt\\\"]\\n\",\n",
    "    \"    d = C.load_dump(run, mr)\\n\",\n",
    "    \"    import gc\\n\",\n",
    "    \"    P, T, M = d[\\\"preds\\\"], d[\\\"targets\\\"], d[\\\"masks\\\"]\\n\",\n",
    "    \"    TH = d[\\\"target_hours\\\"]\\n\",\n",
    "    \"    Mw, K_, N_, _ = P.shape; NV_ = len(VAR_)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    mod_sum = np.zeros((4, N_HBINS, K_, NV_))\\n\",\n",
    "    \"    mod_cnt = np.zeros((4, N_HBINS, K_, NV_))\\n\",\n",
    "    \"    per_sum = np.zeros((4, N_HBINS, K_, NV_))\\n\",\n",
    "    \"    per_cnt = np.zeros((4, N_HBINS, K_, NV_))\\n\",\n",
    "    \"    clim_sum = np.zeros((4, N_HBINS, K_, NV_))\\n\",\n",
    "    \"    clim_cnt = np.zeros((4, N_HBINS, K_, NV_))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    CLIM_LAG_STEPS = C.CLIM_LAG_STEPS  # 24 h on the 10-min raw-observation grid (144 steps)\\n\",\n",
    "    \"    chunk = 256\\n\",\n",
    "    \"    hours_to_row = C.hours_to_row  # raw_test_obs() is on the 10-min grid (6 rows per hour)\\n\",\n",
    "    \"    for a0 in range(0, Mw, chunk):\\n\",\n",
    "    \"        b0 = min(a0 + chunk, Mw)\\n\",\n",
    "    \"        p = P[a0:b0].numpy().astype(np.float64)\\n\",\n",
    "    \"        t = T[a0:b0, :, :, :NV_].numpy().astype(np.float64)\\n\",\n",
    "    \"        m = (M[a0:b0, :, :, :NV_].numpy() > 0.5) & KEEP_[None, None]\\n\",\n",
    "    \"        th = TH[a0:b0].numpy()\\n\",\n",
    "    \"        t0h = th[:, 0]\\n\",\n",
    "    \"        hbin = _hbin_of(t0h)\\n\",\n",
    "    \"        sea = C._season_of(t0h)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        e_phys = np.abs((p - t) * STD_[None, None])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        ti_tgt  = hours_to_row(th, H0)\\n\",\n",
    "    \"        ti_pers = hours_to_row(th[:, 0:1], H0)\\n\",\n",
    "    \"        ok_t = (ti_tgt >= 0) & (ti_tgt < NT)\\n\",\n",
    "    \"        ok_p = (ti_pers >= 0) & (ti_pers < NT)\\n\",\n",
    "    \"        truth  = OBS[np.clip(ti_tgt, 0, NT-1)].astype(np.float64)\\n\",\n",
    "    \"        tmask  = OMSK[np.clip(ti_tgt, 0, NT-1)] & ok_t[:, :, None, None]\\n\",\n",
    "    \"        pers_v = OBS[np.clip(ti_pers, 0, NT-1)].astype(np.float64)\\n\",\n",
    "    \"        pmask  = OMSK[np.clip(ti_pers, 0, NT-1)] & ok_p[:, :, None, None]\\n\",\n",
    "    \"        per_ep = np.abs(pers_v - truth)\\n\",\n",
    "    \"        mod_mk = m & tmask\\n\",\n",
    "    \"        per_mk = m & tmask & pmask\\n\",\n",
    "    \"        clim_v = OBS[np.clip(ti_tgt - CLIM_LAG_STEPS, 0, NT-1)].astype(np.float64)\\n\",\n",
    "    \"        ti_clim = ti_tgt - CLIM_LAG_STEPS\\n\",\n",
    "    \"        ok_c = (ti_clim >= 0) & (ti_clim < NT)\\n\",\n",
    "    \"        cmask = OMSK[np.clip(ti_clim, 0, NT-1)] & ok_c[:, :, None, None]\\n\",\n",
    "    \"        clim_ep = np.abs(clim_v - truth)\\n\",\n",
    "    \"        clim_mk = m & tmask & cmask\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for si in range(4):\\n\",\n",
    "    \"            for hi in range(N_HBINS):\\n\",\n",
    "    \"                sel = (sea == si) & (hbin == hi)\\n\",\n",
    "    \"                if not sel.any():\\n\",\n",
    "    \"                    continue\\n\",\n",
    "    \"                mod_sum[si, hi] += (e_phys[sel] * mod_mk[sel]).sum(axis=(0, 2))\\n\",\n",
    "    \"                mod_cnt[si, hi] += mod_mk[sel].sum(axis=(0, 2))\\n\",\n",
    "    \"                per_sum[si, hi] += (per_ep[sel] * per_mk[sel]).sum(axis=(0, 2))\\n\",\n",
    "    \"                per_cnt[si, hi] += per_mk[sel].sum(axis=(0, 2))\\n\",\n",
    "    \"                clim_sum[si, hi] += (clim_ep[sel] * clim_mk[sel]).sum(axis=(0, 2))\\n\",\n",
    "    \"                clim_cnt[si, hi] += clim_mk[sel].sum(axis=(0, 2))\\n\",\n",
    "    \"    mod_mae = np.where(mod_cnt > 0, mod_sum / mod_cnt, np.nan)\\n\",\n",
    "    \"    per_mae = np.where(per_cnt > 0, per_sum / per_cnt, np.nan)\\n\",\n",
    "    \"    clim_mae = np.where(clim_cnt > 0, clim_sum / clim_cnt, np.nan)\\n\",\n",
    "    \"    del P, T, M, d\\n\",\n",
    "    \"    gc.collect()\\n\",\n",
    "    \"    return mod_mae, per_mae, clim_mae  # (4_sea, 12_hbin, K, V)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Computing 2-hourly × season cross-tab …\\\")\\n\",\n",
    "    \"HS_MOD, HS_PER, HS_CLIM = {}, {}, {}\\n\",\n",
    "    \"for r in MR0_RUNS:\\n\",\n",
    "    \"    print(f\\\"  {r}…\\\", end=\\\" \\\", flush=True)\\n\",\n",
    "    \"    HS_MOD[r], HS_PER[r], HS_CLIM[r] = compute_hbin_season(r)\\n\",\n",
    "    \"    print(\\\"done\\\")\\n\",\n",
    "    \"print(\\\"All models computed.\\\")\\n\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"p1_plot\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# ── Figure: Diurnal MAE at Δ ≈ 3 h, 2-hourly, by season ────────────────────\\n\",\n",
    "    \"fig, axes = plt.subplots(4, NV, figsize=(17, 13), sharex=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"for si, sea_lbl in enumerate(SEASON_LABELS):\\n\",\n",
    "    \"    for vi, v in enumerate(VARS):\\n\",\n",
    "    \"        ax = axes[si, vi]\\n\",\n",
    "    \"        for r in MR0_RUNS:\\n\",\n",
    "    \"            label, col, _ = C.MODELS[r]\\n\",\n",
    "    \"            ax.plot(HBIN_CENTRES, HS_MOD[r][si, :, REF_KI, vi],\\n\",\n",
    "    \"                    \\\"o-\\\", ms=3, lw=1.3, color=col, label=label)\\n\",\n",
    "    \"        # persistence\\n\",\n",
    "    \"        ax.plot(HBIN_CENTRES, HS_PER[MR0_RUNS[0]][si, :, REF_KI, vi],\\n\",\n",
    "    \"                \\\"--\\\", lw=1.1, color=C.BASELINE_COLORS[\\\"persistence\\\"],\\n\",\n",
    "    \"                label=C.BASELINE_LABELS[\\\"persistence\\\"])\\n\",\n",
    "    \"        ax.grid(alpha=0.3)\\n\",\n",
    "    \"        if si == 0:\\n\",\n",
    "    \"            ax.set_title(f\\\"{v}  [{C.UNITS[v]}]\\\", fontsize=10)\\n\",\n",
    "    \"        if si == 3:\\n\",\n",
    "    \"            ax.set_xlabel(\\\"Forecast-origin hour (UTC)\\\", fontsize=8)\\n\",\n",
    "    \"            ax.set_xticks(HBIN_CENTRES)\\n\",\n",
    "    \"            ax.set_xticklabels(HBIN_LABELS, rotation=45, ha=\\\"right\\\", fontsize=7)\\n\",\n",
    "    \"    axes[si, 0].set_ylabel(f\\\"{sea_lbl}\\\\nMAE at {LEAD[REF_KI]}\\\", fontsize=9)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Sync y-axis per variable column ──────────────────────────────────────────\\n\",\n",
    "    \"for vi in range(NV):\\n\",\n",
    "    \"    col_axes = [axes[si, vi] for si in range(4)]\\n\",\n",
    "    \"    lo = min(ax.get_ylim()[0] for ax in col_axes)\\n\",\n",
    "    \"    hi = max(ax.get_ylim()[1] for ax in col_axes)\\n\",\n",
    "    \"    for ax in col_axes:\\n\",\n",
    "    \"        ax.set_ylim(lo, hi)\\n\",\n",
    "    \"axes[0, -1].legend(fontsize=5.5, loc=\\\"upper left\\\")\\n\",\n",
    "    \"fig.suptitle(f\\\"MAE at {LEAD[REF_KI]} by 2-hour forecast-origin bin (UTC) and season, all stations visible (MR=0); dashed = last-value persistence\\\",\\n\",\n",
    "    \"             y=1.01, fontsize=12)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"C.save_fig(fig, \\\"44_diurnal_hourly_by_season\\\")\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"plt.close(fig)\\n\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"p2_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Monthly MAE at Δ ≈ 3 h — selected models\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"p2\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"SEL = [\\\"v27\\\", \\\"v31\\\", \\\"lstm-baseline-v1\\\"]\\nfig, axes = plt.subplots(1, NV, figsize=(17, 3.4))\\nfor vi, (ax, v) in enumerate(zip(axes, VARS)):\\n    for r in SEL:\\n        e = EXT[r]\\n        label, col, _ = C.MODELS[r]\\n        mc = e[\\\"month_mod_cnt\\\"][:, REF_KI, vi]\\n        ms_ = e[\\\"month_mod_sum\\\"][:, REF_KI, vi]\\n        y = np.where(mc > 0, ms_ / np.maximum(mc, 1), np.nan)\\n        ax.plot(range(12), y, \\\"o-\\\", ms=4, lw=1.3, color=col, label=label)\\n    # persistence\\n    e0 = EXT[SEL[0]]\\n    pc = e0[\\\"month_per_cnt\\\"][:, REF_KI, vi]\\n    ps = e0[\\\"month_per_sum\\\"][:, REF_KI, vi]\\n    yp = np.where(pc > 0, ps / np.maximum(pc, 1), np.nan)\\n    ax.plot(range(12), yp, \\\"--\\\", lw=1.2, color=C.BASELINE_COLORS[\\\"persistence\\\"],\\n            label=C.BASELINE_LABELS[\\\"persistence\\\"])\\n    ax.set_xticks(range(12))\\n    ax.set_xticklabels(C.MONTH_LABELS, rotation=45, ha=\\\"right\\\", fontsize=7)\\n    ax.set_title(f\\\"{v}  [{C.UNITS[v]}]\\\", fontsize=10); ax.grid(alpha=.3)\\naxes[0].set_ylabel(f\\\"MAE at {LEAD[REF_KI]}\\\")\\naxes[-1].legend(fontsize=7)\\nfig.suptitle(f\\\"Monthly MAE at {LEAD[REF_KI]} (MR=0)\\\", y=1.04)\\nplt.tight_layout(); C.save_fig(fig, \\\"44_monthly\\\"); plt.show()\\nplt.close(fig)\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"sup_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n## Supplementary: diurnal MAE vs lead — full curves per TOD window\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"sup\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"for ti, tod_lbl in enumerate(C.TOD_LABELS):\\n    fig, axes = plt.subplots(1, NV, figsize=(17, 3.3))\\n    for vi, (ax, v) in enumerate(zip(axes, VARS)):\\n        for r in MR0_RUNS:\\n            label, col, _ = C.MODELS[r]\\n            y = C.pool_stations(EXT[r][\\\"tod_mod_sum\\\"][ti],\\n                                EXT[r][\\\"tod_mod_cnt\\\"][ti])[:, vi]\\n            ax.plot(range(1, K), y[1:], \\\"o-\\\", ms=3, lw=1.3, color=col, label=label)\\n        e0 = EXT[MR0_RUNS[0]]\\n        y_per  = C.pool_stations(e0[\\\"tod_per_sum\\\"][ti], e0[\\\"tod_per_cnt\\\"][ti])[:, vi]\\n        y_clim = C.pool_stations(e0[\\\"tod_clim_sum\\\"][ti], e0[\\\"tod_clim_cnt\\\"][ti])[:, vi]\\n        ax.plot(range(1, K), y_per[1:], \\\"--\\\", lw=1.2,\\n                color=C.BASELINE_COLORS[\\\"persistence\\\"],\\n                label=C.BASELINE_LABELS[\\\"persistence\\\"])\\n        ax.plot(range(1, K), y_clim[1:], \\\"--\\\", lw=1.2,\\n                color=C.BASELINE_COLORS[\\\"clim\\\"],\\n                label=C.BASELINE_LABELS[\\\"clim\\\"])\\n        ax.set_xticks(range(1, K, 2))\\n        ax.set_xticklabels(LEAD[1::2], rotation=45, ha=\\\"right\\\", fontsize=6.5)\\n        ax.set_title(f\\\"{v}  [{C.UNITS[v]}]\\\", fontsize=10); ax.grid(alpha=.3)\\n    axes[0].set_ylabel(\\\"MAE [phys]\\\")\\n    axes[-1].legend(fontsize=6, loc=\\\"upper left\\\")\\n    fig.suptitle(f\\\"Supplementary: MAE vs lead — {tod_lbl} (MR=0)\\\", y=1.04)\\n    plt.tight_layout(); C.save_fig(fig, f\\\"44_sup_tod_{ti}\\\"); plt.show()\\nplt.close(fig)\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"interp\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Interpretation\\n\\n**Diurnal:** Wind MAE peaks during afternoon convection (12–18 UTC).\\nTemperature shows the smallest diurnal variation (strong spatial\\ncoherence damps the TOD signal). If the model's diurnal profile\\ndiffers from persistence, it has learned time-of-day–dependent dynamics.\\n\\n**Monthly:** Winter months (DJF) may show elevated temperature/pressure\\nerrors (inversions, fog); summer months may show elevated wind errors\\n(convective instability).\"\n",
    "   ]\n",
    "  }\n",
    " ]\n",
    "}\n"
