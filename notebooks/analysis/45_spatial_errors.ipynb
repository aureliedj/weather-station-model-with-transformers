    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"sd_cmp_v27_v30nll\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# ── v27 vs v30-nll  σₑ comparison — temperature & pressure ──────────────────\\n\",\n",
    "    \"# Rows = models (MAE, Probabilistic MAE), columns = lead times (+30 min, +3 h, +6 h)\\n\",\n",
    "    \"# One figure per variable (temperature, pressure only)\\n\",\n",
    "    \"\\n\",\n",
    "    \"CMP_RUNS  = [\\\"v27\\\", \\\"v30-nll\\\"]\\n\",\n",
    "    \"CMP_LEADS = [(1, \\\"+30 min\\\"), (6, \\\"+3 h\\\"), (12, \\\"+6 h\\\")]\\n\",\n",
    "    \"CMP_VARS  = [\\\"temperature\\\", \\\"pressure\\\"]\\n\",\n",
    "    \"N_CMP     = len(CMP_RUNS)\\n\",\n",
    "    \"N_CLEAD   = len(CMP_LEADS)\\n\",\n",
    "    \"\\n\",\n",
    "    \"for v in CMP_VARS:\\n\",\n",
    "    \"    vi = VARS.index(v)\\n\",\n",
    "    \"    all_sd = []\\n\",\n",
    "    \"    for r in CMP_RUNS:\\n\",\n",
    "    \"        a   = AGG[r]\\n\",\n",
    "    \"        cnt = a[\\\"mod_all_cnt\\\"][:, :, vi]\\n\",\n",
    "    \"        sgn = a[\\\"mod_all_signed_phys\\\"][:, :, vi]\\n\",\n",
    "    \"        sq  = a[\\\"mod_all_sumsq_phys\\\"][:, :, vi]\\n\",\n",
    "    \"        n   = np.maximum(cnt, 1)\\n\",\n",
    "    \"        sd  = np.sqrt(np.maximum(sq / n - (sgn / n) ** 2, 0))\\n\",\n",
    "    \"        all_sd.append(np.where(cnt > 0, sd, np.nan))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Shared colour scale across both models and all lead times.\\n\",\n",
    "    \"    # `list(zip(*CMP_LEADS))[0]` is a Python TUPLE of lead indices, e.g.\\n\",\n",
    "    \"    # (1, 6, 12) — numpy treats a tuple index as multi-axis advanced\\n\",\n",
    "    \"    # indexing (sd[1, 6, 12]), not \\\"select these rows along axis 0\\\", so\\n\",\n",
    "    \"    # this raised \\\"IndexError: too many indices for array\\\" on a 2-D sd.\\n\",\n",
    "    \"    # A list index does the intended row selection.\\n\",\n",
    "    \"    CMP_LEAD_IDX = [ki for ki, _ in CMP_LEADS]\\n\",\n",
    "    \"    vmin = np.nanpercentile(np.concatenate(\\n\",\n",
    "    \"        [sd[CMP_LEAD_IDX].ravel() for sd in all_sd]), 2)\\n\",\n",
    "    \"    vmax = np.nanpercentile(np.concatenate(\\n\",\n",
    "    \"        [sd[CMP_LEAD_IDX].ravel() for sd in all_sd]), 98)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    fig, axes = plt.subplots(N_CMP, N_CLEAD,\\n\",\n",
    "    \"                             figsize=(5.4 * N_CLEAD, 4.2 * N_CMP))\\n\",\n",
    "    \"    if N_CMP == 1: axes = axes[None, :]\\n\",\n",
    "    \"    sc_last = None\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for ri, r in enumerate(CMP_RUNS):\\n\",\n",
    "    \"        sd_vals = all_sd[ri]\\n\",\n",
    "    \"        label, col, _ = C.MODELS[r]\\n\",\n",
    "    \"        for ci, (ki, lead_lbl) in enumerate(CMP_LEADS):\\n\",\n",
    "    \"            ax = axes[ri, ci]\\n\",\n",
    "    \"            draw_dem(ax, dem_bg, dem_fg, switzerland)\\n\",\n",
    "    \"            vals = sd_vals[ki]\\n\",\n",
    "    \"            valid = ~np.isnan(vals)\\n\",\n",
    "    \"            sc_last = ax.scatter(\\n\",\n",
    "    \"                stn.easting[valid], stn.northing[valid],\\n\",\n",
    "    \"                c=vals[valid], s=50, cmap=\\\"magma\\\",\\n\",\n",
    "    \"                vmin=vmin, vmax=vmax,\\n\",\n",
    "    \"                edgecolors=\\\"white\\\", linewidths=0.4, zorder=5)\\n\",\n",
    "    \"            if ri == 0:\\n\",\n",
    "    \"                ax.set_title(lead_lbl, fontsize=12, fontweight=\\\"bold\\\")\\n\",\n",
    "    \"            if ci == 0:\\n\",\n",
    "    \"                ax.text(-0.06, 0.5, label, transform=ax.transAxes,\\n\",\n",
    "    \"                        rotation=90, va=\\\"center\\\", ha=\\\"center\\\",\\n\",\n",
    "    \"                        fontsize=10, fontweight=\\\"bold\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # ── Sync axes limits ──\\n\",\n",
    "    \"    for ci in range(N_CLEAD):\\n\",\n",
    "    \"        col_axes = [axes[ri, ci] for ri in range(N_CMP)]\\n\",\n",
    "    \"        lo_y = min(a.get_ylim()[0] for a in col_axes)\\n\",\n",
    "    \"        hi_y = max(a.get_ylim()[1] for a in col_axes)\\n\",\n",
    "    \"        lo_x = min(a.get_xlim()[0] for a in col_axes)\\n\",\n",
    "    \"        hi_x = max(a.get_xlim()[1] for a in col_axes)\\n\",\n",
    "    \"        for a in col_axes:\\n\",\n",
    "    \"            a.set_ylim(lo_y, hi_y)\\n\",\n",
    "    \"            a.set_xlim(lo_x, hi_x)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    cbar = fig.colorbar(sc_last, ax=axes.ravel().tolist(),\\n\",\n",
    "    \"                        location=\\\"right\\\", fraction=0.015, pad=0.03,\\n\",\n",
    "    \"                        label=f\\\"σₑ [{C.UNITS[v]}]\\\", shrink=0.7,\\n\",\n",
    "    \"                        aspect=30)\\n\",\n",
    "    \"    fig.suptitle(f\\\"{v}: per-station error SD σₑ = std(ŷ−y) at three lead times, all stations visible (MR=0) — rows: MAE Transformer (Huber), Probabilistic MAE (Gaussian NLL)\\\",\\n\",\n",
    "    \"                 fontsize=14, y=1.02)\\n\",\n",
    "    \"    fig.subplots_adjust(right=0.88, wspace=0.05, hspace=0.08)\\n\",\n",
    "    \"    C.save_fig(fig, f\\\"45_sd_cmp_{v}\\\"); plt.show()\\n\",\n",
    "    \"    plt.close(fig)\\n\"\n",
    "   ],\n",
