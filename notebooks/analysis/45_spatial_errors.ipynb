    "   \"source\": [\n",
    "    \"## Exclusion overlay\\n\",\n",
    "    \"\\n\",\n",
    "    \"Every per-station scatter map below also marks stations excluded for that\\n\",\n",
    "    \"variable (`common.excluded_station_variable_reasons()`) with an X:\\n\",\n",
    "    \"**black** = missing in both train and test, **white** = missing in train\\n\",\n",
    "    \"only, **grey** = missing in test only, **orange** = present in both splits\\n\",\n",
    "    \"but excluded for a data-quality reason (BIZ/pressure, sensor drift).\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"eeac66d65f414715\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"REASON_STYLE = {\\n\",\n",
    "    \"    \\\"missing_train\\\": dict(color=\\\"white\\\",   label=\\\"missing in train only\\\"),\\n\",\n",
    "    \"    \\\"missing_test\\\":  dict(color=\\\"0.6\\\",     label=\\\"missing in test only\\\"),\\n\",\n",
    "    \"    \\\"missing_both\\\":  dict(color=\\\"black\\\",   label=\\\"missing in train & test\\\"),\\n\",\n",
    "    \"    \\\"drift\\\":         dict(color=\\\"#E8A838\\\", label=\\\"excluded \\\\u2014 sensor drift\\\"),\\n\",\n",
    "    \"}\\n\",\n",
    "    \"EXCL_REASONS = C.excluded_station_variable_reasons()\\n\",\n",
    "    \"\\n\",\n",
    "    \"def overlay_exclusion_markers(ax, variable, s=70, legend=False):\\n\",\n",
    "    \"    return  # X markers removed per user request\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"p1_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Per-station MAE maps — LSTM, Spatially Blind, Dense\\n\",\n",
    "    \"\\n\",\n",
    "    \"Rows = models (LSTM → Spatially Blind → Dense), columns = lead times\\n\",\n",
    "    \"(+30 min, +3 h, +6 h). Shared colour scale per variable.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"p1\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# ── Select models and leads ──────────────────────────────────────────────────\\n\",\n",
    "    \"MAP_RUNS = [\\\"v27\\\", \\\"v30-nll\\\"]\\n\",\n",
    "    \"MAP_RUNS = [r for r in MAP_RUNS if r in MR0_RUNS]\\n\",\n",
    "    \"SHOW_LEADS = [(1, \\\"+30 min\\\"), (6, \\\"+3 h\\\"), (12, \\\"+6 h\\\")]\\n\",\n",
    "    \"N_MOD = len(MAP_RUNS); N_LEAD = len(SHOW_LEADS)\\n\",\n",
    "    \"\\n\",\n",
    "    \"for vi, v in enumerate(VARS):\\n\",\n",
    "    \"    all_mae = []\\n\",\n",
    "    \"    for r in MAP_RUNS:\\n\",\n",
    "    \"        a = AGG[r]\\n\",\n",
    "    \"        cnt = a[\\\"mod_all_cnt\\\"][:, :, vi]\\n\",\n",
    "    \"        s   = a[\\\"mod_all_sum_phys\\\"][:, :, vi]\\n\",\n",
    "    \"        all_mae.append(np.where(cnt > 0, s / np.maximum(cnt, 1), np.nan))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    fig, axes = plt.subplots(N_MOD, N_LEAD,\\n\",\n",
    "    \"                             figsize=(5.4 * N_LEAD, 4.2 * N_MOD))\\n\",\n",
    "    \"    if N_MOD == 1: axes = axes[None, :]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    vmin = np.nanpercentile(np.concatenate([m.ravel() for m in all_mae]), 2)\\n\",\n",
    "    \"    vmax = np.nanpercentile(np.concatenate([m.ravel() for m in all_mae]), 98)\\n\",\n",
    "    \"    sc_last = None\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for ri, r in enumerate(MAP_RUNS):\\n\",\n",
    "    \"        mae = all_mae[ri]\\n\",\n",
    "    \"        label, col, _ = C.MODELS[r]\\n\",\n",
    "    \"        for ci, (ki, lead_lbl) in enumerate(SHOW_LEADS):\\n\",\n",
    "    \"            ax = axes[ri, ci]\\n\",\n",
    "    \"            draw_dem(ax, dem_bg, dem_fg, switzerland)\\n\",\n",
    "    \"            vals = mae[ki]\\n\",\n",
    "    \"            valid = ~np.isnan(vals)\\n\",\n",
    "    \"            sc_last = ax.scatter(\\n\",\n",
    "    \"                stn.easting[valid], stn.northing[valid],\\n\",\n",
    "    \"                c=vals[valid], s=50, cmap=\\\"YlOrRd\\\",\\n\",\n",
    "    \"                vmin=vmin, vmax=vmax,\\n\",\n",
    "    \"                edgecolors=\\\"white\\\", linewidths=0.4, zorder=5)\\n\",\n",
    "    \"            overlay_exclusion_markers(ax, v, legend=(ri == 0 and ci == 0))\\n\",\n",
    "    \"            if ri == 0:\\n\",\n",
    "    \"                ax.set_title(lead_lbl, fontsize=12, fontweight=\\\"bold\\\")\\n\",\n",
    "    \"            if ci == 0:\\n\",\n",
    "    \"                ax.text(-0.06, 0.5, label, transform=ax.transAxes,\\n\",\n",
    "    \"                        rotation=90, va=\\\"center\\\", ha=\\\"center\\\",\\n\",\n",
    "    \"                        fontsize=10, fontweight=\\\"bold\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    cbar = fig.colorbar(sc_last, ax=axes.ravel().tolist(),\\n\",\n",
    "    \"                        location=\\\"right\\\", fraction=0.015, pad=0.03,\\n\",\n",
    "    \"                        label=f\\\"MAE [{C.UNITS[v]}]\\\", shrink=0.7,\\n\",\n",
    "    \"                        aspect=30)\\n\",\n",
    "    \"    fig.suptitle(f\\\"{v} — per-station MAE at MR=0.0\\\", fontsize=14, y=1.02)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # ── Sync axes limits across all subplots ──\\n\",\n",
    "    \"    for ci in range(N_LEAD):\\n\",\n",
    "    \"        col_axes = [axes[ri, ci] for ri in range(N_MOD)]\\n\",\n",
    "    \"        lo_y = min(ax.get_ylim()[0] for ax in col_axes)\\n\",\n",
    "    \"        hi_y = max(ax.get_ylim()[1] for ax in col_axes)\\n\",\n",
    "    \"        lo_x = min(ax.get_xlim()[0] for ax in col_axes)\\n\",\n",
    "    \"        hi_x = max(ax.get_xlim()[1] for ax in col_axes)\\n\",\n",
    "    \"        for ax in col_axes:\\n\",\n",
    "    \"            ax.set_ylim(lo_y, hi_y)\\n\",\n",
    "    \"            ax.set_xlim(lo_x, hi_x)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    fig.subplots_adjust(right=0.88, wspace=0.05, hspace=0.08)\\n\",\n",
    "    \"    C.save_fig(fig, f\\\"45_map_{v}\\\"); plt.show()\\n\",\n",
    "    \"    plt.close(fig)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Free unused AGG entries\\n\",\n",
    "    \"for _r in list(AGG):\\n\",\n",
    "    \"    if _r not in MAP_RUNS:\\n\",\n",
    "    \"        del AGG[_r]\\n\",\n",
    "    \"import gc; gc.collect()\\n\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"p1_sd\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# ── Per-station σₑ maps — same layout as MAE maps ───────────────────────────\\n\",\n",
    "    \"for vi, v in enumerate(VARS):\\n\",\n",
    "    \"    all_sd = []\\n\",\n",
    "    \"    for r in MAP_RUNS:\\n\",\n",
    "    \"        a = AGG[r]\\n\",\n",
    "    \"        cnt = a[\\\"mod_all_cnt\\\"][:, :, vi]\\n\",\n",
    "    \"        sgn = a[\\\"mod_all_signed_phys\\\"][:, :, vi]\\n\",\n",
    "    \"        sq  = a[\\\"mod_all_sumsq_phys\\\"][:, :, vi]\\n\",\n",
    "    \"        n = np.maximum(cnt, 1)\\n\",\n",
    "    \"        sd = np.sqrt(np.maximum(sq / n - (sgn / n) ** 2, 0))\\n\",\n",
    "    \"        all_sd.append(np.where(cnt > 0, sd, np.nan))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    fig, axes = plt.subplots(N_MOD, N_LEAD,\\n\",\n",
    "    \"                             figsize=(5.4 * N_LEAD, 4.2 * N_MOD))\\n\",\n",
    "    \"    if N_MOD == 1: axes = axes[None, :]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    vmin = np.nanpercentile(np.concatenate([s.ravel() for s in all_sd]), 2)\\n\",\n",
    "    \"    vmax = np.nanpercentile(np.concatenate([s.ravel() for s in all_sd]), 98)\\n\",\n",
    "    \"    sc_last = None\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for ri, r in enumerate(MAP_RUNS):\\n\",\n",
    "    \"        sd_vals = all_sd[ri]\\n\",\n",
    "    \"        label, col, _ = C.MODELS[r]\\n\",\n",
    "    \"        for ci, (ki, lead_lbl) in enumerate(SHOW_LEADS):\\n\",\n",
    "    \"            ax = axes[ri, ci]\\n\",\n",
    "    \"            draw_dem(ax, dem_bg, dem_fg, switzerland)\\n\",\n",
    "    \"            vals = sd_vals[ki]\\n\",\n",
    "    \"            valid = ~np.isnan(vals)\\n\",\n",
    "    \"            sc_last = ax.scatter(\\n\",\n",
    "    \"                stn.easting[valid], stn.northing[valid],\\n\",\n",
    "    \"                c=vals[valid], s=50, cmap=\\\"magma\\\",\\n\",\n",
    "    \"                vmin=vmin, vmax=vmax,\\n\",\n",
    "    \"                edgecolors=\\\"white\\\", linewidths=0.4, zorder=5)\\n\",\n",
    "    \"            if ri == 0:\\n\",\n",
    "    \"                ax.set_title(lead_lbl, fontsize=12, fontweight=\\\"bold\\\")\\n\",\n",
    "    \"            if ci == 0:\\n\",\n",
    "    \"                ax.text(-0.06, 0.5, label, transform=ax.transAxes,\\n\",\n",
    "    \"                        rotation=90, va=\\\"center\\\", ha=\\\"center\\\",\\n\",\n",
    "    \"                        fontsize=10, fontweight=\\\"bold\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    cbar = fig.colorbar(sc_last, ax=axes.ravel().tolist(),\\n\",\n",
    "    \"                        location=\\\"right\\\", fraction=0.015, pad=0.03,\\n\",\n",
    "    \"                        label=f\\\"σₑ [{C.UNITS[v]}]\\\", shrink=0.7,\\n\",\n",
    "    \"                        aspect=30)\\n\",\n",
    "    \"    fig.suptitle(f\\\"{v} — per-station σₑ at MR=0.0\\\", fontsize=14, y=1.02)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # ── Sync axes limits across all subplots ──\\n\",\n",
    "    \"    for ci in range(N_LEAD):\\n\",\n",
    "    \"        col_axes = [axes[ri, ci] for ri in range(N_MOD)]\\n\",\n",
    "    \"        lo_y = min(ax.get_ylim()[0] for ax in col_axes)\\n\",\n",
    "    \"        hi_y = max(ax.get_ylim()[1] for ax in col_axes)\\n\",\n",
    "    \"        lo_x = min(ax.get_xlim()[0] for ax in col_axes)\\n\",\n",
    "    \"        hi_x = max(ax.get_xlim()[1] for ax in col_axes)\\n\",\n",
    "    \"        for ax in col_axes:\\n\",\n",
    "    \"            ax.set_ylim(lo_y, hi_y)\\n\",\n",
    "    \"            ax.set_xlim(lo_x, hi_x)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    fig.subplots_adjust(right=0.88, wspace=0.05, hspace=0.08)\\n\",\n",
    "    \"    C.save_fig(fig, f\\\"45_sd_map_{v}\\\"); plt.show()\\n\",\n",
    "    \"    plt.close(fig)\\n\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"p2_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Error standard deviation (σₑ) maps — v27 at key leads\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"p2\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"a = AGG[\\\"v27\\\"]\\n\",\n",
    "    \"cnt = a[\\\"mod_all_cnt\\\"]           # (K, N, V)\\n\",\n",
    "    \"sgn = a[\\\"mod_all_signed_phys\\\"]\\n\",\n",
    "    \"rmse_sq = a[\\\"mod_all_sumsq_phys\\\"]\\n\",\n",
    "    \"n = np.maximum(cnt, 1)\\n\",\n",
    "    \"sd = np.sqrt(np.maximum(rmse_sq / n - (sgn / n) ** 2, 0))  # (K, N, V)\\n\",\n",
    "    \"\\n\",\n",
    "    \"for ki, klbl in [(1, \\\"+30 min\\\"), (4, \\\"+2 h\\\"), (12, \\\"+6 h\\\")]:\\n\",\n",
    "    \"    fig, axes = plt.subplots(1, NV, figsize=(5.4 * NV, 4.5))\\n\",\n",
    "    \"    for vi, (ax, v) in enumerate(zip(axes, VARS)):\\n\",\n",
    "    \"        draw_dem(ax, dem_bg, dem_fg, switzerland)\\n\",\n",
    "    \"        vals = sd[ki, :, vi]\\n\",\n",
    "    \"        valid = cnt[ki, :, vi] > 0\\n\",\n",
    "    \"        sc = ax.scatter(stn.easting[valid], stn.northing[valid],\\n\",\n",
    "    \"                        c=vals[valid], s=50, cmap=\\\"magma\\\",\\n\",\n",
    "    \"                        edgecolors=\\\"white\\\", linewidths=0.4, zorder=5)\\n\",\n",
    "    \"        overlay_exclusion_markers(ax, v, legend=(vi == 0))\\n\",\n",
    "    \"        fig.colorbar(sc, ax=ax, fraction=0.04, pad=0.02,\\n\",\n",
    "    \"                     label=f\\\"σₑ [{C.UNITS[v]}]\\\")\\n\",\n",
    "    \"        ax.set_title(f\\\"{v}\\\", fontsize=10)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # ── Sync axes limits across all variable subplots ──\\n\",\n",
    "    \"    lo_y = min(ax.get_ylim()[0] for ax in axes)\\n\",\n",
    "    \"    hi_y = max(ax.get_ylim()[1] for ax in axes)\\n\",\n",
    "    \"    lo_x = min(ax.get_xlim()[0] for ax in axes)\\n\",\n",
    "    \"    hi_x = max(ax.get_xlim()[1] for ax in axes)\\n\",\n",
    "    \"    for ax in axes:\\n\",\n",
    "    \"        ax.set_ylim(lo_y, hi_y)\\n\",\n",
    "    \"        ax.set_xlim(lo_x, hi_x)\\n\",\n",
    "    \"\\n\",\n",
