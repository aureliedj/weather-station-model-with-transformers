    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"p1_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Figure 4 — Forecasting error (MAE vs lead time)\\n\",\n",
    "    \"\\n\",\n",
    "    \"Per time-of-day window. Models ordered by experimental progression.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"p1\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# ── Load extended (per-TOD) caches ───────────────────────────────────────────\\n\",\n",
    "    \"EXT = {r: C.load_ext(r, \\\"mr0.00\\\") for r in MODEL_ORDER}\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── MAE vs lead, by init-hour band — same bands as the σₑ plot (p1b) below ──\\n\",\n",
    "    \"# `np.isclose(hod, hr)` matched nothing: forecast-origin times (\\\"blocks\\\"\\n\",\n",
    "    \"# index_mode, offset by W/4) never land exactly on the hour — they sit at\\n\",\n",
    "    \"# a fixed set of 16 hour-of-day values 1.5h apart (…, 4.34, 5.84, 7.34, …).\\n\",\n",
    "    \"# Use the same ±1h band centred on each target hour as p1b / the\\n\",\n",
    "    \"# INIT_LO/INIT_HI cell below, so MAE and σₑ are computed on identical\\n\",\n",
    "    \"# windows and the notebook doesn't define two different \\\"05 UTC\\\" bins.\\n\",\n",
    "    \"INIT_BANDS_MAE = [(4, 6, \\\"05 UTC\\\"), (10, 12, \\\"11 UTC\\\"),\\n\",\n",
    "    \"                  (16, 18, \\\"17 UTC\\\"), (22, 24, \\\"23 UTC\\\")]\\n\",\n",
    "    \"N_BANDS_MAE = len(INIT_BANDS_MAE)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Compute MAE by init-hour band from raw predictions ──\\n\",\n",
    "    \"band_mod_sum = {}\\n\",\n",
    "    \"band_mod_cnt = {}\\n\",\n",
    "    \"for run in MODEL_ORDER:\\n\",\n",
    "    \"    d = C.load_dump(run, \\\"mr0.00\\\")\\n\",\n",
    "    \"    P, T, M = d[\\\"preds\\\"], d[\\\"targets\\\"], d[\\\"masks\\\"]\\n\",\n",
    "    \"    TH = d[\\\"target_hours\\\"].numpy()\\n\",\n",
    "    \"    t0h = TH[:, 0]\\n\",\n",
    "    \"    hod = t0h % 24\\n\",\n",
    "    \"\\n\",\n",
    "    \"    s_acc = np.zeros((N_BANDS_MAE, K, NV))\\n\",\n",
    "    \"    c_acc = np.zeros((N_BANDS_MAE, K, NV))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    BS = 512\\n\",\n",
    "    \"    for a0 in range(0, len(P), BS):\\n\",\n",
    "    \"        b0 = min(a0 + BS, len(P))\\n\",\n",
    "    \"        p = P[a0:b0, :, :, :NV].numpy().astype(np.float64)\\n\",\n",
    "    \"        t = T[a0:b0, :, :, :NV].numpy().astype(np.float64)\\n\",\n",
    "    \"        m = (M[a0:b0, :, :, :NV].numpy() > 0.5) & KEEP[None, None]\\n\",\n",
    "    \"        e_phys = np.abs((p - t) * STD[None, None])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for bi, (lo_h, hi_h, _) in enumerate(INIT_BANDS_MAE):\\n\",\n",
    "    \"            sel = (hod[a0:b0] >= lo_h) & (hod[a0:b0] < hi_h)\\n\",\n",
    "    \"            if not sel.any():\\n\",\n",
    "    \"                continue\\n\",\n",
    "    \"            s_acc[bi] += (e_phys[sel] * m[sel]).sum(axis=(0, 2))\\n\",\n",
    "    \"            c_acc[bi] += m[sel].sum(axis=(0, 2))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    band_mod_sum[run] = s_acc\\n\",\n",
    "    \"    band_mod_cnt[run] = c_acc\\n\",\n",
    "    \"    del d, P, T, M, TH\\n\",\n",
    "    \"    import gc; gc.collect()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Persistence MAE baseline per band ──\\n\",\n",
    "    \"d = C.load_dump(MODEL_ORDER[0], \\\"mr0.00\\\")\\n\",\n",
    "    \"P, T, M = d[\\\"preds\\\"], d[\\\"targets\\\"], d[\\\"masks\\\"]\\n\",\n",
    "    \"TH = d[\\\"target_hours\\\"].numpy()\\n\",\n",
    "    \"t0h = TH[:, 0]\\n\",\n",
    "    \"hod = t0h % 24\\n\",\n",
    "    \"\\n\",\n",
    "    \"per_s = np.zeros((N_BANDS_MAE, K, NV))\\n\",\n",
    "    \"per_c = np.zeros((N_BANDS_MAE, K, NV))\\n\",\n",
    "    \"\\n\",\n",
    "    \"BS = 512\\n\",\n",
    "    \"for a0 in range(0, len(P), BS):\\n\",\n",
    "    \"    b0 = min(a0 + BS, len(P))\\n\",\n",
    "    \"    t = T[a0:b0, :, :, :NV].numpy().astype(np.float64)\\n\",\n",
    "    \"    m = (M[a0:b0, :, :, :NV].numpy() > 0.5) & KEEP[None, None]\\n\",\n",
    "    \"    per = t[:, 0:1, :, :].repeat(K, axis=1)\\n\",\n",
    "    \"    per_ep = np.abs((per - t) * STD[None, None])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for bi, (lo_h, hi_h, _) in enumerate(INIT_BANDS_MAE):\\n\",\n",
    "    \"        sel = (hod[a0:b0] >= lo_h) & (hod[a0:b0] < hi_h)\\n\",\n",
    "    \"        if not sel.any():\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"        per_s[bi] += (per_ep[sel] * m[sel]).sum(axis=(0, 2))\\n\",\n",
    "    \"        per_c[bi] += m[sel].sum(axis=(0, 2))\\n\",\n",
    "    \"\\n\",\n",
    "    \"del d, P, T, M, TH; gc.collect()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Plot: N_BANDS_MAE rows × NV columns ──\\n\",\n",
    "    \"fig, axes = plt.subplots(N_BANDS_MAE, NV, figsize=(17, 13), sharex=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"for bi, (_, _, band_lbl) in enumerate(INIT_BANDS_MAE):\\n\",\n",
    "    \"    for vi, v in enumerate(VARS):\\n\",\n",
    "    \"        ax = axes[bi, vi]\\n\",\n",
    "    \"        for run in MODEL_ORDER:\\n\",\n",
    "    \"            label, col, _ = C.MODELS[run]\\n\",\n",
    "    \"            mae = np.where(band_mod_cnt[run] > 0,\\n\",\n",
    "    \"                           band_mod_sum[run] / np.maximum(band_mod_cnt[run], 1), np.nan)\\n\",\n",
    "    \"            ax.plot(range(1, K), mae[bi, 1:, vi], \\\"o-\\\", ms=2.5, lw=1.2,\\n\",\n",
    "    \"                    color=col, label=label)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        per_mae = np.where(per_c > 0, per_s / np.maximum(per_c, 1), np.nan)\\n\",\n",
    "    \"        ax.plot(range(1, K), per_mae[bi, 1:, vi], \\\"--\\\", lw=1.1,\\n\",\n",
    "    \"                color=C.BASELINE_COLORS[\\\"persistence\\\"],\\n\",\n",
    "    \"                label=C.BASELINE_LABELS[\\\"persistence\\\"])\\n\",\n",
    "    \"        ax.grid(alpha=0.3)\\n\",\n",
    "    \"        if bi == 0:\\n\",\n",
    "    \"            ax.set_title(f\\\"{v}  [{C.UNITS[v]}]\\\", fontsize=10)\\n\",\n",
    "    \"        if bi == N_BANDS_MAE - 1:\\n\",\n",
    "    \"            ax.set_xticks(range(1, K, 2))\\n\",\n",
    "    \"            ax.set_xticklabels(LEAD[1::2], rotation=45, ha=\\\"right\\\", fontsize=6.5)\\n\",\n",
    "    \"    axes[bi, 0].set_ylabel(f\\\"{band_lbl}\\\\nMAE\\\", fontsize=9)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Sync y-axis per variable column ──\\n\",\n",
    "    \"for vi in range(NV):\\n\",\n",
    "    \"    col_axes = [axes[bi, vi] for bi in range(N_BANDS_MAE)]\\n\",\n",
    "    \"    lo = min(ax.get_ylim()[0] for ax in col_axes)\\n\",\n",
    "    \"    hi = max(ax.get_ylim()[1] for ax in col_axes)\\n\",\n",
    "    \"    for ax in col_axes:\\n\",\n",
    "    \"        ax.set_ylim(lo, hi)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Sync wind components ──\\n\",\n",
    "    \"wu_i, wv_i = VARS.index(\\\"wind_u\\\"), VARS.index(\\\"wind_v\\\")\\n\",\n",
    "    \"lo = min(axes[0, wu_i].get_ylim()[0], axes[0, wv_i].get_ylim()[0])\\n\",\n",
    "    \"hi = max(axes[0, wu_i].get_ylim()[1], axes[0, wv_i].get_ylim()[1])\\n\",\n",
    "    \"for ri in range(axes.shape[0]):\\n\",\n",
    "    \"    axes[ri, wu_i].set_ylim(lo, hi)\\n\",\n",
    "    \"    axes[ri, wv_i].set_ylim(lo, hi)\\n\",\n",
    "    \"\\n\",\n",
    "    \"axes[0, -1].legend(fontsize=5.5, loc=\\\"upper left\\\")\\n\",\n",
    "    \"fig.suptitle(\\\"MAE vs lead time, all stations visible (MR=0), by forecast-origin band (±1 h around 05/11/17/23 UTC); dashed = last-value persistence\\\", y=1.01, fontsize=12)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"C.save_fig(fig, \\\"41_mae_vs_lead_by_tod\\\")\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"plt.close(fig)\\n\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import numpy as np, torch\\n\",\n",
    "    \"d = torch.load('../../test_results/v27/best_mr0.00/predictions.pt', map_location='cpu', weights_only=False)\\n\",\n",
    "    \"hod = d['target_hours'][:, 0].numpy() % 24\\n\",\n",
    "    \"print(f'hod range: {hod.min():.2f} – {hod.max():.2f}')\\n\",\n",
    "    \"for h in range(24):\\n\",\n",
    "    \"    cnt = ((hod >= h) & (hod < h+1)).sum()\\n\",\n",
    "    \"    print(f'  {h:02d}:00 : {cnt}')\"\n",
    "   ],\n",
    "   \"id\": \"dad73d97ca98f480\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"p1b_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Figure 5 — Error variability (error standard deviation (σₑ) vs lead time)\\n\",\n",
    "    \"\\n\",\n",
    "    \"Per time-of-day window. Same layout as Figure 4.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"clim_sd_compute\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# ── Compute 24h-persistence σₑ by TOD (not in extended aggregator) ──────────\\n\",\n",
    "    \"# The extended aggregator stores tod_clim_sum/cnt but not sumsq/signed,\\n\",\n",
    "    \"# so we compute them here from the same raw data.\\n\",\n",
    "    \"#\\n\",\n",
    "    \"# NOTE: this used to load a hand-rolled \\\"data/processed/observations.pt\\\" that\\n\",\n",
    "    \"# does not exist on disk. The canonical source for raw physical observations\\n\",\n",
    "    \"# is common.raw_test_obs() (backed by build_observations(), same as\\n\",\n",
    "    \"# aggregate_extended() uses internally) — reuse that instead of a bespoke\\n\",\n",
    "    \"# path. raw_test_obs() already returns PHYSICAL-unit values, so no extra\\n\",\n",
    "    \"# std scaling is needed here (unlike the model's preds/targets, which are\\n\",\n",
    "    \"# normalised). Also fixed CLIM_LAG_STEPS: raw_test_obs() is on the 10-min\\n\",\n",
    "    \"# observation grid (6 steps/h), so 24h = 144 steps, not 48 (that value\\n\",\n",
    "    \"# assumed a 30-min grid) — use common.py's own CLIM_LAG_STEPS for\\n\",\n",
    "    \"# consistency with aggregate_extended().\\n\",\n",
    "    \"_run0 = MODEL_ORDER[0]\\n\",\n",
    "    \"_d = C.load_dump(_run0, \\\"mr0.00\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"raw = C.raw_test_obs()\\n\",\n",
    "    \"OBS, OMSK, H0, NT = raw[\\\"obs\\\"], raw[\\\"mask\\\"], raw[\\\"h0\\\"], raw[\\\"nt\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"N = len(C.station_table())\\n\",\n",
    "    \"KEEP = C.keep_mask(C.station_table(), VARS)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Accumulators: (4_tod, K, N, V)\\n\",\n",
    "    \"clim_sumsq_tod = np.zeros((4, K, N, NV))\\n\",\n",
    "    \"clim_signed_tod = np.zeros((4, K, N, NV))\\n\",\n",
    "    \"clim_cnt_tod = np.zeros((4, K, N, NV))\\n\",\n",
    "    \"\\n\",\n",
    "    \"TH = _d[\\\"target_hours\\\"].numpy()     # (Mw, K)\\n\",\n",
    "    \"M = _d[\\\"masks\\\"][:, :, :, :NV].numpy() > 0.5  # (Mw, K, N, V)\\n\",\n",
    "    \"Mw = TH.shape[0]\\n\",\n",
    "    \"CHUNK = 512\\n\",\n",
    "    \"\\n\",\n",
    "    \"for a0 in range(0, Mw, CHUNK):\\n\",\n",
    "    \"    b0 = min(a0 + CHUNK, Mw)\\n\",\n",
    "    \"    th = TH[a0:b0]       # (chunk, K)\\n\",\n",
    "    \"    m = M[a0:b0] & KEEP[None, None]  # (chunk, K, N, V)\\n\",\n",
    "    \"    t0h = th[:, 0]        # (chunk,) — same convention as aggregate_extended\\n\",\n",
    "    \"    tod = C._tod_of(t0h)  # (chunk,)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ti_tgt = C.hours_to_row(th, H0)          # (chunk, K)\\n\",\n",
    "    \"    ti_clim = ti_tgt - C.CLIM_LAG_STEPS\\n\",\n",
    "    \"    ok_t = (ti_tgt >= 0) & (ti_tgt < NT)\\n\",\n",
    "    \"    ok_c = (ti_clim >= 0) & (ti_clim < NT)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    truth = OBS[np.clip(ti_tgt, 0, NT-1)].astype(np.float64)   # (chunk, K, N, V)\\n\",\n",
    "    \"    tmask = OMSK[np.clip(ti_tgt, 0, NT-1)] & ok_t[:, :, None, None]\\n\",\n",
    "    \"    clim_v = OBS[np.clip(ti_clim, 0, NT-1)].astype(np.float64)\\n\",\n",
    "    \"    cmask = OMSK[np.clip(ti_clim, 0, NT-1)] & ok_c[:, :, None, None]\\n\",\n",
    "    \"    clim_mk = m & tmask & cmask\\n\",\n",
    "    \"\\n\",\n",
    "    \"    clim_err_signed = clim_v - truth   # already physical units (raw_test_obs)\\n\",\n",
    "    \"    clim_err_sq = clim_err_signed ** 2\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for ti in range(4):\\n\",\n",
    "    \"        s = tod == ti\\n\",\n",
    "    \"        if not s.any():\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"        clim_sumsq_tod[ti] += (clim_err_sq[s] * clim_mk[s]).sum(0)\\n\",\n",
    "    \"        clim_signed_tod[ti] += (clim_err_signed[s] * clim_mk[s]).sum(0)\\n\",\n",
    "    \"        clim_cnt_tod[ti] += clim_mk[s].sum(0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Pool over stations\\n\",\n",
    "    \"clim_sd_tod = C.error_sd(clim_sumsq_tod, clim_signed_tod, clim_cnt_tod)\\n\",\n",
    "    \"print(\\\"24h-persistence σₑ by TOD computed.\\\")\\n\",\n",
    "    \"print(f\\\"  Shape: {clim_sd_tod.shape}\\\")\\n\",\n",
    "    \"del OBS, OMSK, _d, raw  # free memory\\n\",\n",
    "    \"import gc; gc.collect()\\n\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"p1b\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# ── σₑ vs lead, averaged over init-hour bands (5–7 & 11–13 UTC) ─────────────\\n\",\n",
    "    \"# Iterate raw predictions to compute σₑ = sqrt(E[e²] - E[e]²) per band.\\n\",\n",
    "    \"\\n\",\n",
    "    \"INIT_BANDS = [(4, 6, \\\"05 UTC\\\"), (10, 12, \\\"11 UTC\\\"), (16, 18, \\\"17 UTC\\\"), (22, 24, \\\"23 UTC\\\")]\\n\",\n",
    "    \"N_BANDS = len(INIT_BANDS)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Compute σₑ by init-hour band from raw predictions ──\\n\",\n",
    "    \"band_sumsq  = {}  # {run: (N_BANDS, K, NV)}\\n\",\n",
    "    \"band_signed = {}\\n\",\n",
    "    \"band_cnt    = {}\\n\",\n",
    "    \"for run in MODEL_ORDER:\\n\",\n",
    "    \"    d = C.load_dump(run, \\\"mr0.00\\\")\\n\",\n",
    "    \"    P, T, M = d[\\\"preds\\\"], d[\\\"targets\\\"], d[\\\"masks\\\"]\\n\",\n",
    "    \"    TH = d[\\\"target_hours\\\"].numpy()\\n\",\n",
    "    \"    t0h = TH[:, 0]\\n\",\n",
    "    \"    hod = t0h % 24\\n\",\n",
    "    \"\\n\",\n",
    "    \"    sq_acc  = np.zeros((N_BANDS, K, NV))\\n\",\n",
    "    \"    sg_acc  = np.zeros((N_BANDS, K, NV))\\n\",\n",
    "    \"    cnt_acc = np.zeros((N_BANDS, K, NV))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    BS = 512\\n\",\n",
    "    \"    for a0 in range(0, len(P), BS):\\n\",\n",
    "    \"        b0 = min(a0 + BS, len(P))\\n\",\n",
    "    \"        p = P[a0:b0, :, :, :NV].numpy().astype(np.float64)\\n\",\n",
    "    \"        t = T[a0:b0, :, :, :NV].numpy().astype(np.float64)\\n\",\n",
    "    \"        m = (M[a0:b0, :, :, :NV].numpy() > 0.5) & KEEP[None, None]\\n\",\n",
    "    \"        e_signed = (p - t) * STD[None, None]\\n\",\n",
    "    \"        e_sq = e_signed ** 2\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for bi, (lo_h, hi_h, _) in enumerate(INIT_BANDS):\\n\",\n",
    "    \"            sel = (hod[a0:b0] >= lo_h) & (hod[a0:b0] < hi_h)\\n\",\n",
    "    \"            if not sel.any():\\n\",\n",
    "    \"                continue\\n\",\n",
    "    \"            sq_acc[bi]  += (e_sq[sel] * m[sel]).sum(axis=(0, 2))\\n\",\n",
    "    \"            sg_acc[bi]  += (e_signed[sel] * m[sel]).sum(axis=(0, 2))\\n\",\n",
    "    \"            cnt_acc[bi] += m[sel].sum(axis=(0, 2))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    band_sumsq[run]  = sq_acc\\n\",\n",
    "    \"    band_signed[run] = sg_acc\\n\",\n",
    "    \"    band_cnt[run]    = cnt_acc\\n\",\n",
    "    \"    del d, P, T, M, TH\\n\",\n",
    "    \"    import gc; gc.collect()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Persistence baseline σₑ per band ──\\n\",\n",
    "    \"d = C.load_dump(MODEL_ORDER[0], \\\"mr0.00\\\")\\n\",\n",
    "    \"P, T, M = d[\\\"preds\\\"], d[\\\"targets\\\"], d[\\\"masks\\\"]\\n\",\n",
    "    \"TH = d[\\\"target_hours\\\"].numpy()\\n\",\n",
    "    \"t0h = TH[:, 0]\\n\",\n",
    "    \"hod = t0h % 24\\n\",\n",
    "    \"\\n\",\n",
    "    \"per_sq  = np.zeros((N_BANDS, K, NV))\\n\",\n",
    "    \"per_sg  = np.zeros((N_BANDS, K, NV))\\n\",\n",
    "    \"per_cnt = np.zeros((N_BANDS, K, NV))\\n\",\n",
    "    \"\\n\",\n",
    "    \"BS = 512\\n\",\n",
    "    \"for a0 in range(0, len(P), BS):\\n\",\n",
    "    \"    b0 = min(a0 + BS, len(P))\\n\",\n",
    "    \"    t = T[a0:b0, :, :, :NV].numpy().astype(np.float64)\\n\",\n",
    "    \"    m = (M[a0:b0, :, :, :NV].numpy() > 0.5) & KEEP[None, None]\\n\",\n",
    "    \"    per = t[:, 0:1, :, :].repeat(K, axis=1)\\n\",\n",
    "    \"    e_signed = (per - t) * STD[None, None]\\n\",\n",
    "    \"    e_sq = e_signed ** 2\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for bi, (lo_h, hi_h, _) in enumerate(INIT_BANDS):\\n\",\n",
    "    \"        sel = (hod[a0:b0] >= lo_h) & (hod[a0:b0] < hi_h)\\n\",\n",
    "    \"        if not sel.any():\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"        per_sq[bi]  += (e_sq[sel] * m[sel]).sum(axis=(0, 2))\\n\",\n",
    "    \"        per_sg[bi]  += (e_signed[sel] * m[sel]).sum(axis=(0, 2))\\n\",\n",
    "    \"        per_cnt[bi] += m[sel].sum(axis=(0, 2))\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _sd(sumsq, signed, cnt):\\n\",\n",
    "    \"    safe = np.maximum(cnt, 1)\\n\",\n",
    "    \"    mean_sq = sumsq / safe\\n\",\n",
    "    \"    mean_e  = signed / safe\\n\",\n",
    "    \"    var = mean_sq - mean_e ** 2\\n\",\n",
    "    \"    return np.where(cnt > 0, np.sqrt(np.maximum(var, 0)), np.nan)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Plot: N_BANDS rows × NV columns ──\\n\",\n",
    "    \"fig, axes = plt.subplots(N_BANDS, NV, figsize=(17, 3.5 * N_BANDS), sharex=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"for bi, (_, _, band_lbl) in enumerate(INIT_BANDS):\\n\",\n",
    "    \"    for vi, v in enumerate(VARS):\\n\",\n",
    "    \"        ax = axes[bi, vi]\\n\",\n",
    "    \"        for run in MODEL_ORDER:\\n\",\n",
    "    \"            label, col, _ = C.MODELS[run]\\n\",\n",
    "    \"            sd = _sd(band_sumsq[run], band_signed[run], band_cnt[run])\\n\",\n",
    "    \"            ax.plot(range(1, K), sd[bi, 1:, vi], \\\"o-\\\", ms=2.5, lw=1.2,\\n\",\n",
    "    \"                    color=col, label=label)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        per_sd = _sd(per_sq, per_sg, per_cnt)\\n\",\n",
    "    \"        ax.plot(range(1, K), per_sd[bi, 1:, vi], \\\"--\\\", lw=1.1,\\n\",\n",
    "    \"                color=C.BASELINE_COLORS[\\\"persistence\\\"],\\n\",\n",
    "    \"                label=C.BASELINE_LABELS[\\\"persistence\\\"])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        ax.grid(alpha=0.3)\\n\",\n",
    "    \"        if bi == 0:\\n\",\n",
    "    \"            ax.set_title(f\\\"{v}  [{C.UNITS[v]}]\\\", fontsize=10)\\n\",\n",
    "    \"        if bi == N_BANDS - 1:\\n\",\n",
    "    \"            ax.set_xticks(range(1, K, 2))\\n\",\n",
    "    \"            ax.set_xticklabels(LEAD[1::2], rotation=45, ha=\\\"right\\\", fontsize=6.5)\\n\",\n",
    "    \"    axes[bi, 0].set_ylabel(f\\\"{band_lbl}\\\\nσₑ\\\", fontsize=9)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Sync y-axis per variable column ──\\n\",\n",
    "    \"for vi in range(NV):\\n\",\n",
    "    \"    col_axes = [axes[bi, vi] for bi in range(N_BANDS)]\\n\",\n",
    "    \"    lo = min(ax.get_ylim()[0] for ax in col_axes)\\n\",\n",
    "    \"    hi = max(ax.get_ylim()[1] for ax in col_axes)\\n\",\n",
    "    \"    for ax in col_axes:\\n\",\n",
    "    \"        ax.set_ylim(lo, hi)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Sync wind components ──\\n\",\n",
    "    \"wu_i, wv_i = VARS.index(\\\"wind_u\\\"), VARS.index(\\\"wind_v\\\")\\n\",\n",
    "    \"lo = min(axes[0, wu_i].get_ylim()[0], axes[0, wv_i].get_ylim()[0])\\n\",\n",
    "    \"hi = max(axes[0, wu_i].get_ylim()[1], axes[0, wv_i].get_ylim()[1])\\n\",\n",
    "    \"for ri in range(axes.shape[0]):\\n\",\n",
    "    \"    axes[ri, wu_i].set_ylim(lo, hi)\\n\",\n",
    "    \"    axes[ri, wv_i].set_ylim(lo, hi)\\n\",\n",
    "    \"\\n\",\n",
    "    \"axes[0, -1].legend(fontsize=5.5, loc=\\\"upper left\\\")\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"C.save_fig(fig, \\\"41_error_sd_vs_lead_by_tod\\\")\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"plt.close(fig)\\n\",\n",
    "    \"\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# ── MAE at init 05 UTC, +30 min to +6 h ───────────────────────────────────────\\n\",\n",
    "    \"# Select windows with T=0 in the same \\\"05 UTC\\\" band as p1/p1b above\\n\",\n",
    "    \"# ([4, 6), i.e. ±1h around 05:00) — this used to be the narrower [5, 6),\\n\",\n",
    "    \"# a different band definition for the same \\\"05 UTC\\\" label elsewhere in\\n\",\n",
    "    \"# the notebook.\\n\",\n",
    "    \"INIT_LO, INIT_HI = 4, 6\\n\",\n",
    "    \"PLOT_VARS = [v for v in VARS if v != \\\"wind_v\\\"]\\n\",\n",
    "    \"NV_PLOT = len(PLOT_VARS)\\n\",\n",
    "    \"\\n\",\n",
    "    \"init5_mae = {}\\n\",\n",
    "    \"for run in MODEL_ORDER:\\n\",\n",
    "    \"    d = C.load_dump(run, \\\"mr0.00\\\")\\n\",\n",
    "    \"    P, T, M = d[\\\"preds\\\"], d[\\\"targets\\\"], d[\\\"masks\\\"]\\n\",\n",
    "    \"    TH = d[\\\"target_hours\\\"].numpy()\\n\",\n",
    "    \"    hod = TH[:, 0] % 24\\n\",\n",
    "    \"\\n\",\n",
    "    \"    s_acc = np.zeros((K, NV))\\n\",\n",
    "    \"    c_acc = np.zeros((K, NV))\\n\",\n",
    "    \"    BS = 512\\n\",\n",
    "    \"    for a0 in range(0, len(P), BS):\\n\",\n",
    "    \"        b0 = min(a0 + BS, len(P))\\n\",\n",
    "    \"        p = P[a0:b0, :, :, :NV].numpy().astype(np.float64)\\n\",\n",
    "    \"        t = T[a0:b0, :, :, :NV].numpy().astype(np.float64)\\n\",\n",
    "    \"        m = (M[a0:b0, :, :, :NV].numpy() > 0.5) & KEEP[None, None]\\n\",\n",
    "    \"        sel = (hod[a0:b0] >= INIT_LO) & (hod[a0:b0] < INIT_HI)\\n\",\n",
    "    \"        if sel.any():\\n\",\n",
    "    \"            e = np.abs((p[sel] - t[sel]) * STD[None, None])\\n\",\n",
    "    \"            s_acc += (e * m[sel]).sum(axis=(0, 2))\\n\",\n",
    "    \"            c_acc += m[sel].sum(axis=(0, 2))\\n\",\n",
    "    \"    init5_mae[run] = np.where(c_acc > 0, s_acc / np.maximum(c_acc, 1), np.nan)\\n\",\n",
    "    \"    del d, P, T, M, TH\\n\",\n",
    "    \"    import gc; gc.collect()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Persistence baseline\\n\",\n",
    "    \"d = C.load_dump(MODEL_ORDER[0], \\\"mr0.00\\\")\\n\",\n",
    "    \"P, T, M = d[\\\"preds\\\"], d[\\\"targets\\\"], d[\\\"masks\\\"]\\n\",\n",
    "    \"TH = d[\\\"target_hours\\\"].numpy()\\n\",\n",
    "    \"hod = TH[:, 0] % 24\\n\",\n",
    "    \"\\n\",\n",
    "    \"per_s = np.zeros((K, NV)); per_c = np.zeros((K, NV))\\n\",\n",
    "    \"BS = 512\\n\",\n",
    "    \"for a0 in range(0, len(P), BS):\\n\",\n",
    "    \"    b0 = min(a0 + BS, len(P))\\n\",\n",
    "    \"    t = T[a0:b0, :, :, :NV].numpy().astype(np.float64)\\n\",\n",
    "    \"    m = (M[a0:b0, :, :, :NV].numpy() > 0.5) & KEEP[None, None]\\n\",\n",
    "    \"    sel = (hod[a0:b0] >= INIT_LO) & (hod[a0:b0] < INIT_HI)\\n\",\n",
    "    \"    if sel.any():\\n\",\n",
    "    \"        per = t[sel, 0:1, :, :].repeat(K, axis=1)\\n\",\n",
    "    \"        per_ep = np.abs((per - t[sel]) * STD[None, None])\\n\",\n",
    "    \"        per_s += (per_ep * m[sel]).sum(axis=(0, 2))\\n\",\n",
    "    \"        per_c += m[sel].sum(axis=(0, 2))\\n\",\n",
    "    \"\\n\",\n",
    "    \"per_mae = np.where(per_c > 0, per_s / np.maximum(per_c, 1), np.nan)\\n\",\n",
    "    \"del d, P, T, M, TH; gc.collect()\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(1, NV_PLOT, figsize=(15, 3.2), sharex=True)\\n\",\n",
    "    \"for vi, v in enumerate(PLOT_VARS):\\n\",\n",
    "    \"    ax = axes[vi]\\n\",\n",
    "    \"    v_idx = VARS.index(v)\\n\",\n",
    "    \"    for run in MODEL_ORDER:\\n\",\n",
    "    \"        label, col, _ = C.MODELS[run]\\n\",\n",
    "    \"        ax.plot(range(1, K), init5_mae[run][1:, v_idx], \\\"o-\\\", ms=2.5,\\n\",\n",
    "    \"                lw=1.2, color=col, label=label)\\n\",\n",
    "    \"    ax.plot(range(1, K), per_mae[1:, v_idx], \\\"--\\\", lw=1.1,\\n\",\n",
    "    \"            color=C.BASELINE_COLORS[\\\"persistence\\\"],\\n\",\n",
    "    \"            label=C.BASELINE_LABELS[\\\"persistence\\\"])\\n\",\n",
    "    \"    ax.set_title(f\\\"{v}  [{C.UNITS[v]}]\\\", fontsize=10)\\n\",\n",
    "    \"    ax.grid(alpha=0.3)\\n\",\n",
    "    \"    ax.set_xticks(range(1, K, 2))\\n\",\n",
    "    \"    ax.set_xticklabels(LEAD[1::2], rotation=45, ha=\\\"right\\\", fontsize=6.5)\\n\",\n",
    "    \"\\n\",\n",
    "    \"axes[0].set_ylabel(\\\"MAE 05 UTC\\\", fontsize=9)\\n\",\n",
    "    \"handles, labels = axes[0].get_legend_handles_labels()\\n\",\n",
    "    \"fig.legend(handles, labels, loc=\\\"center right\\\", fontsize=7,\\n\",\n",
    "    \"           bbox_to_anchor=(1.0, 0.5), frameon=True)\\n\",\n",
    "    \"plt.tight_layout(rect=[0, 0, 0.88, 1])\\n\",\n",
    "    \"C.save_fig(fig, \\\"41_mae_morning\\\")\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"plt.close(fig)\\n\"\n",
    "   ],\n",
    "   \"id\": \"a6508ba89eddb5f0\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"season_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Figure 4b — Forecasting error (MAE vs lead time)\\n\",\n",
    "    \"\\n\",\n",
    "    \"Per season (DJF / MAM / JJA / SON). Models ordered by experimental progression.\\n\",\n",
    "    \"Season-split baselines are not available in the base aggregator, so only model\\n\",\n",
    "    \"curves are shown.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"sea_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### MAE and σₑ by season\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"sea_sd_compute\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# ── Compute σₑ by season from raw predictions ───────────────────────────────\\n\",\n",
    "    \"# Extended aggregator lacks season-level sumsq/signed, so we compute from\\n\",\n",
    "    \"# raw predictions, one model at a time, to keep memory manageable.\\n\",\n",
    "    \"import gc\\n\",\n",
    "    \"\\n\",\n",
    "    \"SEASON_LABELS = [\\\"DJF\\\", \\\"MAM\\\", \\\"JJA\\\", \\\"SON\\\"]\\n\",\n",
    "    \"N = len(stn); KEEP = C.keep_mask(stn, VARS)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Dict: run -> (4_sea, K, V) error SD\\n\",\n",
    "    \"sea_sd = {}\\n\",\n",
    "    \"sea_mae = {}   # also collect season MAE with baselines\\n\",\n",
    "    \"sea_per_sd = None   # persistence σₑ by season\\n\",\n",
    "    \"sea_clim_sd = None  # 24h-persistence σₑ by season\\n\",\n",
    "    \"sea_per_mae = None\\n\",\n",
    "    \"sea_clim_mae = None\\n\",\n",
    "    \"\\n\",\n",
    "    \"raw = C.raw_test_obs()\\n\",\n",
    "    \"OBS, OMSK, H0, NT = raw[\\\"obs\\\"], raw[\\\"mask\\\"], raw[\\\"h0\\\"], raw[\\\"nt\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"for ri, run in enumerate(MODEL_ORDER):\\n\",\n",
    "    \"    d = C.load_dump(run, \\\"mr0.00\\\")\\n\",\n",
    "    \"    P = d[\\\"preds\\\"][:, :, :, :NV].numpy().astype(np.float64)\\n\",\n",
    "    \"    T = d[\\\"targets\\\"][:, :, :, :NV].numpy().astype(np.float64)\\n\",\n",
    "    \"    M = d[\\\"masks\\\"][:, :, :, :NV].numpy() > 0.5\\n\",\n",
    "    \"    TH = d[\\\"target_hours\\\"].numpy()\\n\",\n",
    "    \"    Mw = TH.shape[0]; CHUNK = 512\\n\",\n",
    "    \"    del d; gc.collect()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Accumulators: (4, K, N, V)\\n\",\n",
    "    \"    mod_sumsq = np.zeros((4, K, N, NV))\\n\",\n",
    "    \"    mod_signed = np.zeros((4, K, N, NV))\\n\",\n",
    "    \"    mod_cnt = np.zeros((4, K, N, NV))\\n\",\n",
    "    \"    mod_abssum = np.zeros((4, K, N, NV))  # for MAE\\n\",\n",
    "    \"    if ri == 0:  # compute baselines on first model only\\n\",\n",
    "    \"        per_sumsq = np.zeros((4, K, N, NV))\\n\",\n",
    "    \"        per_signed = np.zeros((4, K, N, NV))\\n\",\n",
    "    \"        per_cnt = np.zeros((4, K, N, NV))\\n\",\n",
    "    \"        per_abssum = np.zeros((4, K, N, NV))\\n\",\n",
    "    \"        clm_sumsq = np.zeros((4, K, N, NV))\\n\",\n",
    "    \"        clm_signed = np.zeros((4, K, N, NV))\\n\",\n",
    "    \"        clm_cnt = np.zeros((4, K, N, NV))\\n\",\n",
    "    \"        clm_abssum = np.zeros((4, K, N, NV))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for a0 in range(0, Mw, CHUNK):\\n\",\n",
    "    \"        b0 = min(a0 + CHUNK, Mw)\\n\",\n",
    "    \"        th = TH[a0:b0]\\n\",\n",
    "    \"        m = M[a0:b0] & KEEP[None, None]\\n\",\n",
    "    \"        p_chunk = P[a0:b0]\\n\",\n",
    "    \"        t_chunk = T[a0:b0]\\n\",\n",
    "    \"        sea = C._season_of(th[:, 0:1])[:, 0]  # (chunk,) — season from target_hours[:,0]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        mod_err = p_chunk - t_chunk\\n\",\n",
    "    \"        mod_abs = np.abs(mod_err)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # baselines\\n\",\n",
    "    \"        if ri == 0:\\n\",\n",
    "    \"            ti_tgt = C.hours_to_row(th, H0)\\n\",\n",
    "    \"            ti_per = C.hours_to_row(th[:, 0:1], H0)  # persistence: t=0 obs\\n\",\n",
    "    \"            ti_clm = ti_tgt - C.CLIM_LAG_STEPS\\n\",\n",
    "    \"            ok_t = (ti_tgt >= 0) & (ti_tgt < NT)\\n\",\n",
    "    \"            ok_p = (ti_per >= 0) & (ti_per < NT)\\n\",\n",
    "    \"            ok_c = (ti_clm >= 0) & (ti_clm < NT)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            truth = OBS[np.clip(ti_tgt, 0, NT-1)].astype(np.float64)\\n\",\n",
    "    \"            tmask = OMSK[np.clip(ti_tgt, 0, NT-1)] & ok_t[:, :, None, None]\\n\",\n",
    "    \"\\n\",\n",
    "    \"            per_v = OBS[np.clip(np.broadcast_to(ti_per, th.shape), 0, NT-1)].astype(np.float64)\\n\",\n",
    "    \"            pmask = OMSK[np.clip(np.broadcast_to(ti_per, th.shape), 0, NT-1)] & np.broadcast_to(ok_p, th.shape)[:, :, None, None]\\n\",\n",
    "    \"            per_mk = m & tmask & pmask\\n\",\n",
    "    \"            per_err = per_v - truth\\n\",\n",
    "    \"\\n\",\n",
    "    \"            clm_v = OBS[np.clip(ti_clm, 0, NT-1)].astype(np.float64)\\n\",\n",
    "    \"            cmask = OMSK[np.clip(ti_clm, 0, NT-1)] & ok_c[:, :, None, None]\\n\",\n",
    "    \"            clm_mk = m & tmask & cmask\\n\",\n",
    "    \"            clm_err = clm_v - truth\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for si in range(4):\\n\",\n",
    "    \"            s = sea == si\\n\",\n",
    "    \"            if not s.any():\\n\",\n",
    "    \"                continue\\n\",\n",
    "    \"            mod_sumsq[si] += (mod_err[s]**2 * m[s]).sum(0)\\n\",\n",
    "    \"            mod_signed[si] += (mod_err[s] * m[s]).sum(0)\\n\",\n",
    "    \"            mod_cnt[si] += m[s].sum(0)\\n\",\n",
    "    \"            mod_abssum[si] += (mod_abs[s] * m[s]).sum(0)\\n\",\n",
    "    \"            if ri == 0:\\n\",\n",
    "    \"                per_sumsq[si] += (per_err[s]**2 * per_mk[s]).sum(0)\\n\",\n",
    "    \"                per_signed[si] += (per_err[s] * per_mk[s]).sum(0)\\n\",\n",
    "    \"                per_cnt[si] += per_mk[s].sum(0)\\n\",\n",
    "    \"                per_abssum[si] += (np.abs(per_err[s]) * per_mk[s]).sum(0)\\n\",\n",
    "    \"                clm_sumsq[si] += (clm_err[s]**2 * clm_mk[s]).sum(0)\\n\",\n",
    "    \"                clm_signed[si] += (clm_err[s] * clm_mk[s]).sum(0)\\n\",\n",
    "    \"                clm_cnt[si] += clm_mk[s].sum(0)\\n\",\n",
    "    \"                clm_abssum[si] += (np.abs(clm_err[s]) * clm_mk[s]).sum(0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    sea_sd[run] = C.error_sd(mod_sumsq, mod_signed, mod_cnt)\\n\",\n",
    "    \"    sea_mae[run] = C.pool_stations(mod_abssum, mod_cnt)\\n\",\n",
    "    \"    if ri == 0:\\n\",\n",
    "    \"        sea_per_sd = C.error_sd(per_sumsq, per_signed, per_cnt)\\n\",\n",
    "    \"        sea_clim_sd = C.error_sd(clm_sumsq, clm_signed, clm_cnt)\\n\",\n",
    "    \"        sea_per_mae = C.pool_stations(per_abssum, per_cnt)\\n\",\n",
    "    \"        sea_clim_mae = C.pool_stations(clm_abssum, clm_cnt)\\n\",\n",
    "    \"    del P, T, M, TH; gc.collect()\\n\",\n",
    "    \"    print(f\\\"  {run}: done\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"del OBS, OMSK, raw; gc.collect()\\n\",\n",
    "    \"print(f\\\"Season σₑ computed for {len(sea_sd)} models.\\\")\\n\"\n",
    "   ],\n",
