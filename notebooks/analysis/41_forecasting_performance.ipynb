    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"hourly_season_compute\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# ── Compute hourly MAE by season, averaged over +2h30–3h30 leads ─────────────\\n\",\n",
    "    \"# Using a range of leads (indices 5,6,7 = +2h30, +3h, +3h30) fills hourly\\n\",\n",
    "    \"# bins more evenly and avoids gaps in the diurnal cycle.\\n\",\n",
    "    \"import gc, datetime\\n\",\n",
    "    \"\\n\",\n",
    "    \"LEAD_RANGE = [5, 6, 7]  # +2h30, +3h, +3h30\\n\",\n",
    "    \"SEASON_LABELS_H = [\\\"DJF\\\", \\\"MAM\\\", \\\"JJA\\\", \\\"SON\\\"]\\n\",\n",
    "    \"HOURS = np.arange(24)\\n\",\n",
    "    \"\\n\",\n",
    "    \"raw = C.raw_test_obs()\\n\",\n",
    "    \"OBS, OMSK, H0, NT = raw[\\\"obs\\\"], raw[\\\"mask\\\"], raw[\\\"h0\\\"], raw[\\\"nt\\\"]\\n\",\n",
    "    \"N = len(stn); KEEP_H = C.keep_mask(stn, VARS)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Results: run -> (4_sea, 24_hour, V)\\n\",\n",
    "    \"hourly_mae = {}\\n\",\n",
    "    \"\\n\",\n",
    "    \"for ri, run in enumerate(MODEL_ORDER):\\n\",\n",
    "    \"    d = C.load_dump(run, \\\"mr0.00\\\")\\n\",\n",
    "    \"    Mw = d[\\\"target_hours\\\"].shape[0]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Accumulators: (4, 24, N, V)\\n\",\n",
    "    \"    mod_sum = np.zeros((4, 24, N, NV))\\n\",\n",
    "    \"    mod_cnt = np.zeros((4, 24, N, NV))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for ki in LEAD_RANGE:\\n\",\n",
    "    \"        P = d[\\\"preds\\\"][:, ki, :, :NV].numpy().astype(np.float64)\\n\",\n",
    "    \"        T = d[\\\"targets\\\"][:, ki, :, :NV].numpy().astype(np.float64)\\n\",\n",
    "    \"        M = d[\\\"masks\\\"][:, ki, :, :NV].numpy() > 0.5\\n\",\n",
    "    \"        TH_k = d[\\\"target_hours\\\"][:, ki].numpy()\\n\",\n",
    "    \"        TH0 = d[\\\"target_hours\\\"][:, 0].numpy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        hod = (TH_k % 24).astype(int)\\n\",\n",
    "    \"        ep = datetime.datetime(1970, 1, 1)\\n\",\n",
    "    \"        months = np.array([(ep + datetime.timedelta(hours=float(h))).month for h in TH0])\\n\",\n",
    "    \"        sea = np.select([np.isin(months, [12,1,2]), np.isin(months, [3,4,5]),\\n\",\n",
    "    \"                         np.isin(months, [6,7,8])], [0, 1, 2], 3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        m = M & KEEP_H[None]\\n\",\n",
    "    \"        mod_err = np.abs((P - T) * STD[None])  # physical units (per-station std); axis titles show physical units\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for si in range(4):\\n\",\n",
    "    \"            for hi in range(24):\\n\",\n",
    "    \"                sel = (sea == si) & (hod == hi)\\n\",\n",
    "    \"                if not sel.any():\\n\",\n",
    "    \"                    continue\\n\",\n",
    "    \"                mod_sum[si, hi] += (mod_err[sel] * m[sel]).sum(0)\\n\",\n",
    "    \"                mod_cnt[si, hi] += m[sel].sum(0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    hourly_mae[run] = C.pool_stations(mod_sum, mod_cnt)\\n\",\n",
    "    \"    del mod_sum, mod_cnt; gc.collect()\\n\",\n",
    "    \"    print(f\\\"  {run}: done\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"del d, OBS, OMSK, raw; gc.collect()\\n\",\n",
    "    \"print(f\\\"Hourly MAE by season (+2h30–3h30 avg) computed for {len(hourly_mae)} models.\\\")\\n\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
