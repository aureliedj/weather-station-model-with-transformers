    "   \"name\": \"python\",\n",
    "   \"version\": \"3.10.0\"\n",
    "  }\n",
    " },\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"t\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 4.3 — Robustness to Missing Stations\\n\\nMasked vs visible station performance at MR=0.5 with the actual fixed\\nevaluation mask from the v27 dump. Controlled penalty analysis and\\noperational comparison with v31.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"boot\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"import os, sys, datetime as dt\\n\",\n",
    "    \"import numpy as np, pandas as pd, matplotlib.pyplot as plt\\n\",\n",
    "    \"import matplotlib.colors as mcolors\\n\",\n",
    "    \"for _cand in (os.getcwd(),\\n\",\n",
    "    \"              os.path.join(os.getcwd(), \\\"notebooks\\\", \\\"analysis\\\"),\\n\",\n",
    "    \"              os.path.dirname(os.path.abspath(\\\"__file__\\\"))):\\n\",\n",
    "    \"    if os.path.isfile(os.path.join(_cand, \\\"common.py\\\")):\\n\",\n",
    "    \"        if _cand not in sys.path: sys.path.insert(0, _cand)\\n\",\n",
    "    \"        break\\n\",\n",
    "    \"import importlib, common as C; importlib.reload(C)\\n\",\n",
    "    \"plt.style.use(\\\"default\\\")\\nplt.rcParams.update({\\\"figure.dpi\\\": 110, \\\"font.size\\\": 10,\\n                     \\\"figure.facecolor\\\": \\\"white\\\", \\\"axes.facecolor\\\": \\\"white\\\",\\n                     \\\"savefig.facecolor\\\": \\\"white\\\", \\\"axes.edgecolor\\\": \\\"0.3\\\",\\n                     \\\"axes.labelcolor\\\": \\\"black\\\", \\\"xtick.color\\\": \\\"0.3\\\",\\n                     \\\"ytick.color\\\": \\\"0.3\\\", \\\"text.color\\\": \\\"black\\\"})\\n\",\n",
    "    \"\\n\",\n",
    "    \"RUNS  = C.discovered_runs()\\n\",\n",
    "    \"MR0_RUNS = [r for r in RUNS if \\\"mr0.00\\\" in RUNS[r]]\\n\",\n",
    "    \"ns = C.norm_stats(); VARS = ns[\\\"var_names\\\"]; STD = ns[\\\"std\\\"]\\n\",\n",
    "    \"stn = C.station_table(); KEEP = C.keep_mask(stn, VARS)\\n\",\n",
    "    \"AGG  = {r: C.load_agg(r, \\\"mr0.00\\\") for r in MR0_RUNS}\\n\",\n",
    "    \"GRID = AGG[MR0_RUNS[0]][\\\"grid\\\"]; LEAD = C.lead_labels(GRID); K = len(GRID)\\n\",\n",
    "    \"NV = len(VARS)\\n\",\n",
    "    \"print(\\\"Models at MR=0.00:\\\", MR0_RUNS)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Also load MR=0.5 aggregations\\n\",\n",
    "    \"MR5_RUNS = [r for r in RUNS if \\\"mr0.50\\\" in RUNS[r]]\\n\",\n",
    "    \"AGG5 = {r: C.load_agg(r, \\\"mr0.50\\\") for r in MR5_RUNS}\\n\",\n",
    "    \"print(\\\"Models at MR=0.50:\\\", MR5_RUNS)\",\n",
    "    \"\\nREF_KI = 6  # ≈ 3 h\\n\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"dem\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"import geopandas as gpd\\n\",\n",
    "    \"import rioxarray  # noqa\\n\",\n",
    "    \"\\n\",\n",
    "    \"PROJ = os.path.abspath(os.path.join(os.getcwd(), \\\"..\\\", \\\"..\\\")) \\\\\\n\",\n",
    "    \"       if os.path.isfile(\\\"common.py\\\") else os.getcwd()\\n\",\n",
    "    \"if os.path.join(PROJ, \\\"src\\\") not in sys.path:\\n\",\n",
    "    \"    sys.path.insert(0, os.path.join(PROJ, \\\"src\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"PATH_SWISSSHAPE = os.path.expanduser(\\n\",\n",
    "    \"    os.environ.get(\\\"SWISSSHAPE\\\",\\n\",\n",
    "    \"        os.path.join(PROJ, \\\"swissboundaries3d_2056.shp.zip\\\")))\\n\",\n",
    "    \"_CAND = [os.environ.get(\\\"DATA_ROOT\\\", \\\"\\\"),\\n\",\n",
    "    \"         os.path.expanduser(\\\"~/PeakWeatherDataset\\\"),\\n\",\n",
    "    \"         os.path.join(PROJ, \\\"PeakWeatherDataset\\\")]\\n\",\n",
    "    \"DATA_ROOT = next((p for p in _CAND if os.path.isdir(str(p))), _CAND[-1])\\n\",\n",
    "    \"\\n\",\n",
    "    \"from peakweather.dataset import PeakWeatherDataset\\n\",\n",
    "    \"ds_topo = PeakWeatherDataset(\\n\",\n",
    "    \"    root=DATA_ROOT,\\n\",\n",
    "    \"    parameters=[\\\"temperature\\\", \\\"pressure\\\", \\\"humidity\\\",\\n\",\n",
    "    \"                 \\\"wind_speed\\\", \\\"wind_direction\\\", \\\"precipitation\\\"],\\n\",\n",
    "    \"    compute_uv=True, station_type=\\\"meteo_station\\\",\\n\",\n",
    "    \"    imputation_method=None, freq=\\\"d\\\", extended_topo_vars=\\\"DEM\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _load_dem_and_border(ds_topo, path_swissshape, coarsen=10):\\n\",\n",
    "    \"    switzerland = gpd.read_file(\\n\",\n",
    "    \"        path_swissshape,\\n\",\n",
    "    \"        layer='swissBOUNDARIES3D_1_5_TLM_LANDESGEBIET').to_crs('EPSG:2056')\\n\",\n",
    "    \"    minx, miny, maxx, maxy = switzerland.total_bounds\\n\",\n",
    "    \"    topo = ds_topo.load_topography()\\n\",\n",
    "    \"    dem  = topo['topo_DEM'].dem\\n\",\n",
    "    \"    dem_ch = dem.rio.clip(switzerland.geometry, switzerland.crs, drop=False)\\n\",\n",
    "    \"    dem_bg = dem.coarsen(x=coarsen, y=coarsen, boundary='trim').mean()\\n\",\n",
    "    \"    dem_fg = dem_ch.coarsen(x=coarsen, y=coarsen, boundary='trim').mean()\\n\",\n",
    "    \"    dem_bg = dem_bg.sel(x=slice(minx, maxx), y=slice(miny, maxy))\\n\",\n",
    "    \"    dem_fg = dem_fg.sel(x=slice(minx, maxx), y=slice(miny, maxy))\\n\",\n",
    "    \"    return dem_bg, dem_fg, switzerland\\n\",\n",
    "    \"\\n\",\n",
    "    \"def draw_dem(ax, dem_bg, dem_fg, switzerland):\\n\",\n",
    "    \"    norm = mcolors.Normalize(vmin=0, vmax=4500)\\n\",\n",
    "    \"    dem_bg.plot(ax=ax, cmap='terrain', norm=norm, alpha=0.35,\\n\",\n",
    "    \"                robust=True, add_labels=False, add_colorbar=False)\\n\",\n",
    "    \"    dem_fg.plot(ax=ax, cmap='terrain', norm=norm,\\n\",\n",
    "    \"                robust=True, add_labels=False, add_colorbar=False)\\n\",\n",
    "    \"    switzerland.boundary.plot(ax=ax, color='white', linewidth=1.0)\\n\",\n",
    "    \"    ax.axis('off')\\n\",\n",
    "    \"\\n\",\n",
    "    \"print('Loading DEM + border ...')\\n\",\n",
    "    \"dem_bg, dem_fg, switzerland = _load_dem_and_border(ds_topo, PATH_SWISSSHAPE)\\n\",\n",
    "    \"print('Done.')\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"markers\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# ── Marker convention across all MR=0.5 maps ──\\n\",\n",
    "    \"# masked stations  = triangle marker\\n\",\n",
    "    \"# visible stations = 'o' marker\\n\",\n",
    "    \"MRK_MASKED, MRK_VISIBLE = \\\"^\\\", \\\"o\\\"\\n\",\n",
    "    \"COL_MASKED, COL_VISIBLE = \\\"#C4502A\\\", \\\"#1F5F6B\\\"\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"map_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Fixed evaluation mask — station map\\n\\nWhich stations the encoder sees vs. which it must reconstruct,\\nread directly from the v27 MR=0.5 dump's `masked_idx` tensor.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"map\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"import torch\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Read the actual masked_idx from the v27 MR=0.5 dump\\n\",\n",
    "    \"d5 = C.load_dump(\\\"v27\\\", \\\"mr0.50\\\")\\n\",\n",
    "    \"MI = d5[\\\"masked_idx\\\"]                      # (M, N_masked)\\n\",\n",
    "    \"N = len(stn)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# With a fixed eval mask, masked_idx is identical across all windows.\\n\",\n",
    "    \"unique_masks = torch.unique(MI, dim=0)\\n\",\n",
    "    \"if unique_masks.shape[0] == 1:\\n\",\n",
    "    \"    print(f\\\"Fixed evaluation mask confirmed: {MI.shape[1]} stations \\\"\\n\",\n",
    "    \"          f\\\"masked in every window ({MI.shape[0]} windows)\\\")\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print(f\\\"WARNING: {unique_masks.shape[0]} distinct masks found across \\\"\\n\",\n",
    "    \"          f\\\"{MI.shape[0]} windows — mask is NOT fixed.\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"masked_set = set(MI[0].tolist())\\n\",\n",
    "    \"is_masked = np.array([i in masked_set for i in range(N)])\\n\",\n",
    "    \"n_masked = is_masked.sum()\\n\",\n",
    "    \"n_visible = N - n_masked\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Map ──────────────────────────────────────────────────────────────\\n\",\n",
    "    \"fig, ax = plt.subplots(figsize=(11, 7.5))\\n\",\n",
    "    \"draw_dem(ax, dem_bg, dem_fg, switzerland)\\n\",\n",
    "    \"\\n\",\n",
    "    \"sel_v = ~is_masked\\n\",\n",
    "    \"ax.scatter(stn.easting[sel_v], stn.northing[sel_v],\\n\",\n",
    "    \"           c=COL_VISIBLE, marker=MRK_VISIBLE, s=60,\\n\",\n",
    "    \"           edgecolors=\\\"white\\\", linewidths=0.5,\\n\",\n",
    "    \"           label=f\\\"visible ({n_visible})\\\", zorder=5)\\n\",\n",
    "    \"sel_m = is_masked\\n\",\n",
    "    \"ax.scatter(stn.easting[sel_m], stn.northing[sel_m],\\n\",\n",
    "    \"           c=COL_MASKED, marker=MRK_MASKED, s=80,\\n\",\n",
    "    \"           edgecolors=\\\"white\\\", linewidths=0.5,\\n\",\n",
    "    \"           label=f\\\"masked  ({n_masked})\\\", zorder=6)\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.legend(fontsize=10, framealpha=0.85, loc=\\\"upper left\\\")\\n\",\n",
    "    \"ax.set_title(f\\\"Fixed evaluation mask — \\\"\\n\",\n",
    "    \"             f\\\"{n_masked}/{N} stations masked (MR=0.5)\\\", fontsize=12)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"C.save_fig(fig, \\\"43_fixed_eval_mask_map\\\"); plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Elevation distribution ───────────────────────────────────────────\\n\",\n",
    "    \"h = stn.height.values\\n\",\n",
    "    \"bins = [0, 500, 1000, 1500, 2000, 3000, 5000]\\n\",\n",
    "    \"print(\\\"\\\\nElevation distribution:\\\")\\n\",\n",
    "    \"for lo, hi in zip(bins[:-1], bins[1:]):\\n\",\n",
    "    \"    band = (h >= lo) & (h < hi)\\n\",\n",
    "    \"    nm = (is_masked & band).sum()\\n\",\n",
    "    \"    nt = band.sum()\\n\",\n",
    "    \"    print(f\\\"  {lo:>4}–{hi:<4} m:  {nm:>3} / {nt:>3} masked  ({100*nm/max(nt,1):5.1f}%)\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"\\\\nMasked:  {', '.join(stn.abbr[is_masked])}\\\")\\n\",\n",
    "    \"print(f\\\"Visible: {', '.join(stn.abbr[~is_masked])}\\\")\\n\",\n",
    "    \"del d5\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"msk_mae_map_0h\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# ── Map: per-station masked MAE at +0 h, by variable ─────────────────────────\\n\",\n",
    "    \"# Uses is_masked from the cell above.\\n\",\n",
    "    \"a5 = AGG5[\\\"v27\\\"]\\n\",\n",
    "    \"KI_0H = 0  # lead index for +0 h\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(1, NV, figsize=(5.5 * NV, 7))\\n\",\n",
    "    \"for vi, v in enumerate(VARS):\\n\",\n",
    "    \"    ax = axes[vi]\\n\",\n",
    "    \"    draw_dem(ax, dem_bg, dem_fg, switzerland)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Per-station masked MAE at +0 h\\n\",\n",
    "    \"    cnt_msk = a5[\\\"mod_msk_cnt\\\"][KI_0H, :, vi]\\n\",\n",
    "    \"    mae_msk = np.full(cnt_msk.shape, np.nan)\\n\",\n",
    "    \"    ok = cnt_msk > 0\\n\",\n",
    "    \"    mae_msk[ok] = a5[\\\"mod_msk_sum_phys\\\"][KI_0H, ok, vi] / cnt_msk[ok]\\n\",\n",
    "    \"    has_msk = is_masked & np.isfinite(mae_msk)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Visible stations: white circles (background)\\n\",\n",
    "    \"    sel_v = ~is_masked\\n\",\n",
    "    \"    ax.scatter(stn.easting[sel_v], stn.northing[sel_v],\\n\",\n",
    "    \"               c=\\\"white\\\", marker=MRK_VISIBLE, s=60,\\n\",\n",
    "    \"               edgecolors=\\\"0.5\\\", linewidths=0.5, zorder=4,\\n\",\n",
    "    \"               label=f\\\"visible ({sel_v.sum()})\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Masked stations: triangles coloured by MAE\\n\",\n",
    "    \"    vals = mae_msk[has_msk]\\n\",\n",
    "    \"    vmin, vmax = np.nanpercentile(vals, 2), np.nanpercentile(vals, 98)\\n\",\n",
    "    \"    sc = ax.scatter(stn.easting[has_msk], stn.northing[has_msk],\\n\",\n",
    "    \"                    c=vals, cmap=\\\"magma\\\", vmin=vmin, vmax=vmax,\\n\",\n",
    "    \"                    marker=MRK_MASKED, s=80,\\n\",\n",
    "    \"                    edgecolors=\\\"0.3\\\", linewidths=0.4, zorder=5,\\n\",\n",
    "    \"                    label=f\\\"masked ({has_msk.sum()})\\\")\\n\",\n",
    "    \"    ax.set_title(f\\\"{v}  [{C.UNITS[v]}]\\\", fontsize=10)\\n\",\n",
    "    \"    plt.colorbar(sc, ax=ax, fraction=0.035, pad=0.02, label=\\\"MAE\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Sync wind colour scales\\n\",\n",
    "    \"wu_i, wv_i = VARS.index(\\\"wind_u\\\"), VARS.index(\\\"wind_v\\\")\\n\",\n",
    "    \"sc_u = axes[wu_i].collections[-1]; sc_v = axes[wv_i].collections[-1]\\n\",\n",
    "    \"vmin = min(sc_u.get_clim()[0], sc_v.get_clim()[0])\\n\",\n",
    "    \"vmax = max(sc_u.get_clim()[1], sc_v.get_clim()[1])\\n\",\n",
    "    \"sc_u.set_clim(vmin, vmax); sc_v.set_clim(vmin, vmax)\\n\",\n",
    "    \"\\n\",\n",
    "    \"axes[0].legend(fontsize=8, loc=\\\"upper left\\\", framealpha=0.85)\\n\",\n",
    "    \"#fig.suptitle(\\\"Per-station masked MAE at +0 h (MAE Transformer, MR=0.5)\\\\n\\\"\\n\",\n",
    "    \"#             \\\"△ = masked (coloured by MAE), ○ = visible (white)\\\",\\n\",\n",
    "    \"#             y=1.04, fontsize=11)\\n\",\n",
    "    \"fig.suptitle(\\\"MAE Transformer at MR=0.5, Δ=0 (reconstruction): per-station MAE for one test window\\\\n\\\"\\n\",\n",
    "    \"             \\\"triangles = stations masked in that window (reconstructed from neighbours), circles = visible stations\\\", fontsize=13, y=1.02)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"C.save_fig(fig, \\\"43_masked_mae_map_0h\\\"); plt.show(); plt.close(fig)\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"mae_vs_height_scatter\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# ── Scatter: per-station MAE vs height by TOD — v31 MR=0.0 & v27 MR=0.5 ────\\n\",\n",
    "    \"# Only visible stations (under v27 MR=0.5 mask) are plotted.\\n\",\n",
    "    \"# Open markers = v31 MR=0.0 (dense baseline), filled = v27 MR=0.5.\\n\",\n",
    "    \"# One row per TOD bin (00–06, 06–12, 12–18, 18–24 UTC).\\n\",\n",
    "    \"EXT0 = C.load_ext(\\\"v31\\\", \\\"mr0.00\\\")   # dense baseline\\n\",\n",
    "    \"EXT5 = C.load_ext(\\\"v27\\\", \\\"mr0.50\\\")\\n\",\n",
    "    \"h = stn.height.values\\n\",\n",
    "    \"\\n\",\n",
    "    \"TOD_LABELS = C.TOD_LABELS  # [\\\"00–06 UTC\\\", \\\"06–12 UTC\\\", \\\"12–18 UTC\\\", \\\"18–24 UTC\\\"]\\n\",\n",
    "    \"n_tod = len(TOD_LABELS)\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(n_tod, NV, figsize=(4.5 * NV, 4.5 * n_tod),\\n\",\n",
    "    \"                         sharey=\\\"col\\\", sharex=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"for ti, tod_lbl in enumerate(TOD_LABELS):\\n\",\n",
    "    \"    for vi, v in enumerate(VARS):\\n\",\n",
    "    \"        ax = axes[ti, vi]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # MR=0.0: per-station MAE (tod_mod_sum / tod_mod_cnt)\\n\",\n",
    "    \"        cnt0 = EXT0[\\\"tod_mod_cnt\\\"][ti, REF_KI, :, vi]\\n\",\n",
    "    \"        mae0 = np.full(cnt0.shape, np.nan)\\n\",\n",
    "    \"        ok0 = cnt0 > 0\\n\",\n",
    "    \"        mae0[ok0] = EXT0[\\\"tod_mod_sum\\\"][ti, REF_KI, ok0, vi] / cnt0[ok0]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # MR=0.5 visible\\n\",\n",
    "    \"        cnt5v = EXT5[\\\"tod_mod_vis_cnt\\\"][ti, REF_KI, :, vi]\\n\",\n",
    "    \"        mae5v = np.full(cnt5v.shape, np.nan)\\n\",\n",
    "    \"        ok5v = cnt5v > 0\\n\",\n",
    "    \"        mae5v[ok5v] = EXT5[\\\"tod_mod_vis_sum\\\"][ti, REF_KI, ok5v, vi] / cnt5v[ok5v]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # MR=0.5 masked\\n\",\n",
    "    \"        cnt5m = EXT5[\\\"tod_mod_msk_cnt\\\"][ti, REF_KI, :, vi]\\n\",\n",
    "    \"        mae5m = np.full(cnt5m.shape, np.nan)\\n\",\n",
    "    \"        ok5m = cnt5m > 0\\n\",\n",
    "    \"        mae5m[ok5m] = EXT5[\\\"tod_mod_msk_sum\\\"][ti, REF_KI, ok5m, vi] / cnt5m[ok5m]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        vis = ~is_masked\\n\",\n",
    "    \"        msk = is_masked\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # MR=0.0 — open markers\\n\",\n",
    "    \"        ax.scatter(h[vis & ok0], mae0[vis & ok0],\\n\",\n",
    "    \"                   marker=\\\"o\\\", s=25, alpha=0.5, facecolors=\\\"none\\\",\\n\",\n",
    "    \"                   edgecolors=COL_VISIBLE, linewidths=0.8, zorder=4,\\n\",\n",
    "    \"                   label=\\\"Dense MR=0 vis\\\" if vi == 0 and ti == 0 else None)\\n\",\n",
    "    \"        ax.scatter(h[msk & ok0], mae0[msk & ok0],\\n\",\n",
    "    \"                   marker=\\\"^\\\", s=30, alpha=0.5, facecolors=\\\"none\\\",\\n\",\n",
    "    \"                   edgecolors=COL_MASKED, linewidths=0.8, zorder=4,\\n\",\n",
    "    \"                   label=\\\"Dense MR=0 msk\\\" if vi == 0 and ti == 0 else None)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # MR=0.5 — filled markers\\n\",\n",
    "    \"        ax.scatter(h[vis & ok5v], mae5v[vis & ok5v],\\n\",\n",
