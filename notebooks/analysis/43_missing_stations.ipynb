    "    \"\\n\",\n",
    "    \"    ax.set_xticks(x + w / 2)\\n\",\n",
    "    \"    ax.set_xticklabels(BIN_LABELS, rotation=45, ha=\\\"right\\\", fontsize=8)\\n\",\n",
    "    \"    ax.set_title(f\\\"NN k={k}\\\", fontsize=11)\\n\",\n",
    "    \"    ax.set_xlabel(\\\"Distance to k-th nearest neighbour\\\", fontsize=9)\\n\",\n",
    "    \"    ax.grid(alpha=0.3, axis=\\\"y\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"axes[0].set_ylabel(\\\"Number of visible stations\\\")\\n\",\n",
    "    \"axes[-1].legend(fontsize=8, loc=\\\"upper right\\\", framealpha=0.85)\\n\",\n",
    "    \"fig.suptitle(\\\"NN distance distribution for visible stations — \\\"\\n\",\n",
    "    \"             \\\"MR=0.0 (full network) vs MR=0.5 (visible only)\\\",\\n\",\n",
    "    \"             y=1.02, fontsize=11)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"C.save_fig(fig, \\\"43_nn_dist_barplot\\\"); plt.show(); plt.close(fig)\\n\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"nn_dist_mae\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# ── MAE by NN distance cluster for k=1,2,3 — v31 MR=0.0 vs v27 MR=0.5 ──────\\n\",\n",
    "    \"a0 = AGG[\\\"v31\\\"]; a5 = AGG5[\\\"v27\\\"]\\n\",\n",
    "    \"DIST_BINS = [0, 5, 10, 15, 20, 30, 50, 100, 200]\\n\",\n",
    "    \"BIN_LABELS = [f\\\"{lo}–{hi}\\\" for lo, hi in zip(DIST_BINS[:-1], DIST_BINS[1:])]\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(3, NV, figsize=(4.5 * NV, 4.0 * 3),\\n\",\n",
    "    \"                         sharey=\\\"col\\\", sharex=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"for ki, k in enumerate([1, 2, 3]):\\n\",\n",
    "    \"    # Compute k-th NN distance under MR=0.5 (visible subset)\\n\",\n",
    "    \"    dists_k = np.full(N, np.nan)\\n\",\n",
    "    \"    for si in vis_idx:\\n\",\n",
    "    \"        d = DIST[si, vis_idx]\\n\",\n",
    "    \"        d_sorted = np.sort(d[np.isfinite(d)])\\n\",\n",
    "    \"        if len(d_sorted) >= k:\\n\",\n",
    "    \"            dists_k[si] = d_sorted[k - 1]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Bin each visible station\\n\",\n",
    "    \"    bin_idx = np.digitize(dists_k, DIST_BINS) - 1  # 0-based bin\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for vi, v in enumerate(VARS):\\n\",\n",
    "    \"        ax = axes[ki, vi]\\n\",\n",
    "    \"        x = np.arange(len(BIN_LABELS))\\n\",\n",
    "    \"        w = 0.35\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for si_bar, (label, cnt_key, sum_key, color) in enumerate([\\n\",\n",
    "    \"                (\\\"v31 MR=0\\\", \\\"mod_all_cnt\\\", \\\"mod_all_sum_phys\\\", COL_VISIBLE),\\n\",\n",
    "    \"                (\\\"v27 MR=0.5\\\", \\\"mod_vis_cnt\\\", \\\"mod_vis_sum_phys\\\", COL_MASKED)]):\\n\",\n",
    "    \"            agg = a0 if si_bar == 0 else a5\\n\",\n",
    "    \"            mae_per_bin = []\\n\",\n",
    "    \"            for bi in range(len(BIN_LABELS)):\\n\",\n",
    "    \"                in_bin = vis & (bin_idx == bi)\\n\",\n",
    "    \"                s = agg[sum_key][REF_KI, in_bin, vi].sum()\\n\",\n",
    "    \"                c = agg[cnt_key][REF_KI, in_bin, vi].sum()\\n\",\n",
    "    \"                mae_per_bin.append(s / c if c > 0 else np.nan)\\n\",\n",
    "    \"            mae_per_bin = np.array(mae_per_bin)\\n\",\n",
    "    \"            valid_bins = np.isfinite(mae_per_bin)\\n\",\n",
    "    \"            ax.bar(x[valid_bins] + si_bar * w, mae_per_bin[valid_bins],\\n\",\n",
    "    \"                   width=w, color=color, alpha=0.8,\\n\",\n",
    "    \"                   edgecolor=\\\"white\\\", linewidth=0.5,\\n\",\n",
    "    \"                   label=label if ki == 0 and vi == NV - 1 else None)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        ax.set_xticks(x + w / 2)\\n\",\n",
    "    \"        if ki == 2:\\n\",\n",
    "    \"            ax.set_xticklabels(BIN_LABELS, rotation=45, ha=\\\"right\\\", fontsize=7)\\n\",\n",
    "    \"            ax.set_xlabel(\\\"NN distance [km]\\\", fontsize=8)\\n\",\n",
    "    \"        if ki == 0:\\n\",\n",
    "    \"            ax.set_title(f\\\"{v}  [{C.UNITS[v]}]\\\", fontsize=10)\\n\",\n",
    "    \"        if vi == 0:\\n\",\n",
    "    \"            ax.set_ylabel(f\\\"k={k}\\\\nMAE at {LEAD[REF_KI]}\\\", fontsize=9)\\n\",\n",
    "    \"        ax.grid(alpha=0.3, axis=\\\"y\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"axes[0, -1].legend(fontsize=8, loc=\\\"upper right\\\", framealpha=0.85)\\n\",\n",
    "    \"fig.suptitle(f\\\"Pooled MAE at {LEAD[REF_KI]} by distance to the k-th nearest visible station — Dense (MR=0) vs MAE Transformer (MR=0.5, visible windows) \\\"\\n\",\n",
    "    \"             f\\\"at {LEAD[REF_KI]}\\\\n\\\"\\n\",\n",
    "    \"             f\\\"Stations grouped by distance to k-th nearest visible neighbour\\\",\\n\",\n",
    "    \"             y=1.02, fontsize=11)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"C.save_fig(fig, \\\"43_nn_dist_mae_v31\\\"); plt.show(); plt.close(fig)\\n\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"nn_dist_mae_line\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# ── Scatter: MAE vs k-th NN distance — v31 MR=0.0 vs v27 MR=0.5 with segments ─\\n\",\n",
    "    \"# Each point uses its OWN network's k-th NN distance:\\n\",\n",
    "    \"#   v31 MR=0.0 ○ → full network NN distance (all 155 stations)\\n\",\n",
    "    \"#   v27 MR=0.5 △ → visible-only NN distance (~78 stations)\\n\",\n",
    "    \"# Diagonal segments show joint shift: rightward = lost proximity, upward = worse MAE.\\n\",\n",
    "    \"# Only visible stations (in both setups) are plotted.\\n\",\n",
    "    \"a0 = AGG[\\\"v31\\\"]; a5 = AGG5[\\\"v27\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(3, NV, figsize=(4.5 * NV, 4.0 * 3),\\n\",\n",
    "    \"                         sharex=\\\"row\\\", sharey=\\\"col\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"for ki, k in enumerate([1, 2, 3]):\\n\",\n",
    "    \"    # k-th NN distance under MR=0.0 (full network)\\n\",\n",
    "    \"    dists_k_full = np.full(N, np.nan)\\n\",\n",
    "    \"    for si in vis_idx:\\n\",\n",
    "    \"        d = DIST[si, :].copy()\\n\",\n",
    "    \"        d_sorted = np.sort(d[np.isfinite(d)])\\n\",\n",
    "    \"        if len(d_sorted) >= k:\\n\",\n",
    "    \"            dists_k_full[si] = d_sorted[k - 1]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # k-th NN distance under MR=0.5 (visible subset only)\\n\",\n",
    "    \"    dists_k_vis = np.full(N, np.nan)\\n\",\n",
    "    \"    for si in vis_idx:\\n\",\n",
    "    \"        d = DIST[si, vis_idx]\\n\",\n",
    "    \"        d_sorted = np.sort(d[np.isfinite(d)])\\n\",\n",
    "    \"        if len(d_sorted) >= k:\\n\",\n",
    "    \"            dists_k_vis[si] = d_sorted[k - 1]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for vi, v in enumerate(VARS):\\n\",\n",
    "    \"        ax = axes[ki, vi]\\n\",\n",
    "    \"        cnt0 = a0[\\\"mod_all_cnt\\\"][REF_KI, :, vi]\\n\",\n",
    "    \"        mae0 = np.full(N, np.nan)\\n\",\n",
    "    \"        ok0 = cnt0 > 0\\n\",\n",
    "    \"        mae0[ok0] = a0[\\\"mod_all_sum_phys\\\"][REF_KI, ok0, vi] / cnt0[ok0]\\n\",\n",
    "    \"        cnt5 = a5[\\\"mod_vis_cnt\\\"][REF_KI, :, vi]\\n\",\n",
    "    \"        mae5 = np.full(N, np.nan)\\n\",\n",
    "    \"        ok5 = cnt5 > 0\\n\",\n",
    "    \"        mae5[ok5] = a5[\\\"mod_vis_sum_phys\\\"][REF_KI, ok5, vi] / cnt5[ok5]\\n\",\n",
    "    \"        valid = vis & ok0 & ok5 & np.isfinite(dists_k_full) & np.isfinite(dists_k_vis)\\n\",\n",
    "    \"        # Diagonal segments connecting same station\\n\",\n",
    "    \"        for si in np.where(valid)[0]:\\n\",\n",
    "    \"            ax.plot([dists_k_full[si], dists_k_vis[si]],\\n\",\n",
    "    \"                    [mae0[si], mae5[si]],\\n\",\n",
    "    \"                    color=\\\"0.7\\\", lw=0.5, zorder=3)\\n\",\n",
    "    \"        ax.scatter(dists_k_full[valid], mae0[valid], s=20, alpha=0.6,\\n\",\n",
    "    \"                   color=COL_VISIBLE, marker=\\\"o\\\", zorder=4,\\n\",\n",
    "    \"                   label=\\\"Dense MR=0\\\" if ki == 0 and vi == NV - 1 else None)\\n\",\n",
    "    \"        ax.scatter(dists_k_vis[valid], mae5[valid], s=20, alpha=0.6,\\n\",\n",
    "    \"                   color=COL_MASKED, marker=\\\"^\\\", zorder=5,\\n\",\n",
    "    \"                   label=\\\"MAE Tr. MR=0.5\\\" if ki == 0 and vi == NV - 1 else None)\\n\",\n",
    "    \"        ax.grid(alpha=0.3)\\n\",\n",
    "    \"        if ki == 0:\\n\",\n",
    "    \"            ax.set_title(f\\\"{v}  [{C.UNITS[v]}]\\\", fontsize=10)\\n\",\n",
    "    \"        if vi == 0:\\n\",\n",
    "    \"            ax.set_ylabel(f\\\"k={k}\\\\nMAE at {LEAD[REF_KI]}\\\", fontsize=9)\\n\",\n",
    "    \"        if ki == 2:\\n\",\n",
    "    \"            ax.set_xlabel(\\\"Distance to k-th NN [km]\\\", fontsize=9)\\n\",\n",
    "    \"\\n\",\n",
    "    \"axes[0, -1].legend(fontsize=8, loc=\\\"upper left\\\", framealpha=0.85)\\n\",\n",
    "    \"fig.suptitle(f\\\"Per-station MAE vs k-th NN distance at {LEAD[REF_KI]} — Dense vs MAE Transformer MR=0.5\\\\n\\\"\\n\",\n",
    "    \"             f\\\"○ teal = v31 MR=0.0 (full network), △ coral = v27 MR=0.5 (visible only)\\\\n\\\"\\n\",\n",
    "    \"             f\\\"segments: rightward = lost proximity, upward = worse MAE\\\",\\n\",\n",
    "    \"             y=1.03, fontsize=11)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"C.save_fig(fig, \\\"43_nn_dist_mae_scatter_v31\\\"); plt.show(); plt.close(fig)\\n\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"p1_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Masked vs visible MAE — v27 at MR=0.5\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"p1\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# ── Masked vs visible MAE by init hour — v27 MR=0.5 ──────────────────────────\\n\",\n",
    "    \"# Init bands matching 41_: 05, 11, 17, 23 UTC (±1 h).\\n\",\n",
    "    \"INIT_BANDS = [(4, 6, \\\"05 UTC\\\"), (10, 12, \\\"11 UTC\\\"),\\n\",\n",
    "    \"              (16, 18, \\\"17 UTC\\\"), (22, 24, \\\"23 UTC\\\")]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Load extended aggregator (has TOD splits, but we need finer init-hour control)\\n\",\n",
    "    \"# → use dump to filter by init hour\\n\",\n",
    "    \"d5 = C.load_dump(\\\"v27\\\", \\\"mr0.50\\\")\\n\",\n",
    "    \"P = d5[\\\"preds\\\"]; T = d5[\\\"targets\\\"]; M = d5[\\\"masks\\\"]\\n\",\n",
    "    \"TH = d5[\\\"target_hours\\\"]\\n\",\n",
    "    \"MI = d5.get(\\\"masked_idx\\\")\\n\",\n",
    "    \"Mw, Kd, Nd, NVd = P.shape\\n\",\n",
    "    \"import torch\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Build per-init-band, per-station, msk/vis MAE\\n\",\n",
    "    \"ns_ = C.norm_stats(); STD_ = ns_[\\\"std\\\"]\\n\",\n",
    "    \"grid = d5[\\\"delta_steps\\\"][0].numpy().astype(int)\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(len(INIT_BANDS), NV,\\n\",\n",
    "    \"                         figsize=(17, 3.0 * len(INIT_BANDS)),\\n\",\n",
    "    \"                         sharex=True, sharey=\\\"col\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"for bi, (lo, hi, lbl) in enumerate(INIT_BANDS):\\n\",\n",
    "    \"    t0h = TH[:, 0].numpy() % 24\\n\",\n",
    "    \"    sel = (t0h >= lo) & (t0h < hi)\\n\",\n",
    "    \"    if sel.sum() == 0:\\n\",\n",
    "    \"        continue\\n\",\n",
    "    \"    Ps = P[sel]; Ts = T[sel]; Ms = M[sel]\\n\",\n",
    "    \"    MIs = MI[sel] if MI is not None else None\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for vi, v in enumerate(VARS):\\n\",\n",
    "    \"        ax = axes[bi, vi]\\n\",\n",
    "    \"        # STD_ is (N_stations, V) per-station physical std. Two bugs here:\\n\",\n",
    "    \"        # (1) STD_[vi] indexed the STATION axis instead of the variable axis\\n\",\n",
    "    \"        #     (grabs one station's std across all 5 variables — shape (5,),\\n\",\n",
    "    \"        #     which can't broadcast against the (Mw, K, N) error tensor: that's\\n\",\n",
    "    \"        #     the ValueError). Fixed by indexing STD_[:, vi] -> shape (N,).\\n\",\n",
    "    \"        # (2) Ps/Ts are torch tensors, but multiplying a torch tensor by a\\n\",\n",
    "    \"        #     bare numpy array makes numpy (not torch) run the operation via\\n\",\n",
    "    \"        #     the tensor's __array__ conversion, silently turning e_phys into\\n\",\n",
    "    \"        #     a plain ndarray — which then breaks the `.numpy()` calls used\\n\",\n",
    "    \"        #     on it further down. Wrap the std slice in torch.as_tensor(...)\\n\",\n",
    "    \"        #     so the multiplication stays a torch op and e_phys stays a tensor.\\n\",\n",
    "    \"        std_v = torch.as_tensor(STD_[:, vi], dtype=Ps.dtype)\\n\",\n",
    "    \"        e_phys = (Ps[:, :, :, vi] - Ts[:, :, :, vi]).abs() * std_v\\n\",\n",
    "    \"        mk = Ms[:, :, :, vi]  # valid mask\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Build masked/visible masks per window\\n\",\n",
    "    \"        if MIs is not None:\\n\",\n",
    "    \"            msk_mask = torch.zeros(Ps.shape[0], Nd, dtype=torch.bool)\\n\",\n",
    "    \"            for wi in range(Ps.shape[0]):\\n\",\n",
    "    \"                msk_mask[wi, MIs[wi]] = True\\n\",\n",
    "    \"            vis_mask = ~msk_mask\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            vis_mask = torch.ones(Ps.shape[0], Nd, dtype=torch.bool)\\n\",\n",
    "    \"            msk_mask = torch.zeros(Ps.shape[0], Nd, dtype=torch.bool)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Pool over windows → per-lead MAE for msk and vis\\n\",\n",
    "    \"        mae_msk = np.full(Kd, np.nan)\\n\",\n",
    "    \"        mae_vis = np.full(Kd, np.nan)\\n\",\n",
    "    \"        for ki in range(Kd):\\n\",\n",
    "    \"            e_k = e_phys[:, ki, :].numpy()\\n\",\n",
    "    \"            m_k = mk[:, ki, :].numpy()\\n\",\n",
    "    \"            mm = msk_mask.numpy()\\n\",\n",
    "    \"            vm = vis_mask.numpy()\\n\",\n",
    "    \"            s_m = (e_k * m_k * mm).sum()\\n\",\n",
    "    \"            c_m = (m_k * mm).sum()\\n\",\n",
    "    \"            s_v = (e_k * m_k * vm).sum()\\n\",\n",
    "    \"            c_v = (m_k * vm).sum()\\n\",\n",
    "    \"            if c_m > 0: mae_msk[ki] = s_m / c_m\\n\",\n",
    "    \"            if c_v > 0: mae_vis[ki] = s_v / c_v\\n\",\n",
    "    \"\\n\",\n",
    "    \"        ax.plot(range(1, Kd), mae_msk[1:], \\\"s-\\\", ms=3, lw=1.3,\\n\",\n",
    "    \"                color=COL_MASKED, label=\\\"masked\\\" if bi == 0 and vi == NV-1 else None)\\n\",\n",
    "    \"        ax.plot(range(1, Kd), mae_vis[1:], \\\"o-\\\", ms=3, lw=1.3,\\n\",\n",
    "    \"                color=COL_VISIBLE, label=\\\"visible\\\" if bi == 0 and vi == NV-1 else None)\\n\",\n",
    "    \"        ax.set_xticks(range(1, Kd, 2))\\n\",\n",
    "    \"        if bi == len(INIT_BANDS) - 1:\\n\",\n",
    "    \"            ax.set_xticklabels(LEAD[1::2], rotation=45, ha=\\\"right\\\", fontsize=6.5)\\n\",\n",
    "    \"        if bi == 0:\\n\",\n",
    "    \"            ax.set_title(f\\\"{v}  [{C.UNITS[v]}]\\\", fontsize=10)\\n\",\n",
    "    \"        if vi == 0:\\n\",\n",
    "    \"            ax.set_ylabel(f\\\"init {lbl}\\\\nMAE [phys]\\\", fontsize=9)\\n\",\n",
    "    \"        ax.grid(alpha=.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"axes[0, -1].legend(fontsize=7.5)\\n\",\n",
    "    \"fig.suptitle(\\\"MAE Transformer at MR=0.5: MAE vs lead time while masked vs while visible, by forecast-origin band (±1 h around 05/11/17/23 UTC)\\\", y=1.02)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"C.save_fig(fig, \\\"43_masked_vs_visible_by_init\\\")\\n\",\n",
    "    \"plt.show(); plt.close(fig)\\n\",\n",
    "    \"del d5, P, T, M, TH, MI\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"tc_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Masked vs visible MAE stratified by terrain class\\n\",\n",
    "    \"\\n\",\n",
    "    \"Does masking disproportionately affect stations in particular\\n\",\n",
    "    \"topographic settings? For each terrain class × variable, we report\\n\",\n",
    "    \"pooled MAE for masked and visible stations, the ΔMAE (masked − visible),\\n\",\n",
    "    \"and the sample size (number of stations in each group).\\n\",\n",
    "    \"\\n\",\n",
    "    \"Groups with fewer than 5 stations are flagged — interpret with caution.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"tc_analysis\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# ── Terrain-class stratified masked vs visible analysis ────────────────────\\n\",\n",
    "    \"TC_IDX = C.terrain_class_indices(stn)\\n\",\n",
    "    \"a5 = AGG5[\\\"v27\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Summary table ────────────────────────────────────────────────────────────\\n\",\n",
    "    \"# For each terrain class × variable, pool MAE over masked and visible stations.\\n\",\n",
    "    \"rows = []\\n\",\n",
    "    \"for tc_name, tc_idx in TC_IDX.items():\\n\",\n",
    "    \"    # Split terrain-class stations into masked and visible\\n\",\n",
    "    \"    tc_masked  = tc_idx[is_masked[tc_idx]]\\n\",\n",
    "    \"    tc_visible = tc_idx[~is_masked[tc_idx]]\\n\",\n",
    "    \"    for vi, v in enumerate(VARS):\\n\",\n",
    "    \"        # Pooled MAE at reference lead for masked stations in this terrain class\\n\",\n",
    "    \"        sm = a5[\\\"mod_msk_sum_phys\\\"][REF_KI, tc_masked, vi].sum()\\n\",\n",
    "    \"        cm = a5[\\\"mod_msk_cnt\\\"][REF_KI, tc_masked, vi].sum()\\n\",\n",
    "    \"        mae_m = sm / max(cm, 1) if cm > 0 else np.nan\\n\",\n",
    "    \"        # Pooled MAE for visible stations in this terrain class\\n\",\n",
    "    \"        sv = a5[\\\"mod_vis_sum_phys\\\"][REF_KI, tc_visible, vi].sum()\\n\",\n",
    "    \"        cv = a5[\\\"mod_vis_cnt\\\"][REF_KI, tc_visible, vi].sum()\\n\",\n",
    "    \"        mae_v = sv / max(cv, 1) if cv > 0 else np.nan\\n\",\n",
    "    \"        delta = mae_m - mae_v if not (np.isnan(mae_m) or np.isnan(mae_v)) else np.nan\\n\",\n",
    "    \"        flag = \\\"†\\\" if len(tc_masked) < 5 or len(tc_visible) < 5 else \\\"\\\"\\n\",\n",
    "    \"        rows.append({\\\"Terrain class\\\": tc_name,\\n\",\n",
    "    \"                     \\\"Variable\\\": v,\\n\",\n",
    "    \"                     \\\"N_masked\\\": len(tc_masked),\\n\",\n",
    "    \"                     \\\"N_visible\\\": len(tc_visible),\\n\",\n",
    "    \"                     \\\"MAE_masked\\\": mae_m,\\n\",\n",
    "    \"                     \\\"MAE_visible\\\": mae_v,\\n\",\n",
    "    \"                     \\\"ΔMAE\\\": delta,\\n\",\n",
    "    \"                     \\\"flag\\\": flag})\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_tc = pd.DataFrame(rows)\\n\",\n",
    "    \"REF_LEAD = LEAD[REF_KI]\\n\",\n",
    "    \"print(f\\\"\\\\nMasked vs visible MAE at {REF_LEAD}, stratified by terrain class (v27, MR=0.5)\\\\n\\\")\\n\",\n",
    "    \"display(df_tc.style.format({\\\"MAE_masked\\\": \\\"{:.3f}\\\", \\\"MAE_visible\\\": \\\"{:.3f}\\\",\\n\",\n",
    "    \"                            \\\"ΔMAE\\\": \\\"{:+.3f}\\\"}).set_caption(\\n\",\n",
    "    \"    f\\\"† = fewer than 5 stations in one group — interpret with caution\\\"))\\n\",\n",
    "    \"C.save_table(df_tc, \\\"43_terrain_masked_vs_visible\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ── Compact figure: ΔMAE by terrain class × variable ─────────────────────────\\n\",\n",
    "    \"# Grouped bar plot: terrain classes on x-axis, one bar per variable,\\n\",\n",
    "    \"# bar height = ΔMAE (masked − visible). Error bars via bootstrap would\\n\",\n",
    "    \"# require per-window data; instead we annotate sample sizes.\\n\",\n",
    "    \"tc_names = list(TC_IDX.keys())\\n\",\n",
    "    \"n_tc = len(tc_names)\\n\",\n",
    "    \"x = np.arange(n_tc)\\n\",\n",
    "    \"w = 0.15\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, ax = plt.subplots(figsize=(12, 4.5))\\n\",\n",
    "    \"for vi, v in enumerate(VARS):\\n\",\n",
    "    \"    deltas = []\\n\",\n",
    "    \"    for tc_name in tc_names:\\n\",\n",
    "    \"        row = df_tc[(df_tc[\\\"Terrain class\\\"] == tc_name) &\\n\",\n",
    "    \"                    (df_tc[\\\"Variable\\\"] == v)]\\n\",\n",
    "    \"        deltas.append(row[\\\"ΔMAE\\\"].values[0])\\n\",\n",
    "    \"    color = plt.cm.Set2(vi / NV)\\n\",\n",
    "    \"    bars = ax.bar(x + vi * w, deltas, width=w, label=f\\\"{v} [{C.UNITS[v]}]\\\",\\n\",\n",
    "    \"                  color=color, edgecolor=\\\"k\\\", linewidth=0.4)\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.axhline(0, ls=\\\":\\\", color=\\\"k\\\", lw=0.8)\\n\",\n",
    "    \"ax.set_xticks(x + w * (NV - 1) / 2)\\n\",\n",
    "    \"ax.set_xticklabels(tc_names, fontsize=9)\\n\",\n",
    "    \"ax.set_ylabel(f\\\"ΔMAE (masked − visible) at {REF_LEAD}\\\")\\n\",\n",
    "    \"ax.set_title(\\\"Masking penalty by terrain class — MAE Transformer, MR=0.5\\\", fontsize=11)\\n\",\n",
    "    \"ax.legend(fontsize=7, ncol=NV, loc=\\\"upper left\\\")\\n\",\n",
