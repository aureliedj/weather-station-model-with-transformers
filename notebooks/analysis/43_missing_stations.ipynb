    "    \"fig, axes = plt.subplots(NV, n_tc, figsize=(4.2 * n_tc, 3.0 * NV),\\n\",\n",
    "    \"                         sharex=True, squeeze=False)\\n\",\n",
    "    \"for vi, v in enumerate(VARS):\\n\",\n",
    "    \"    for ti, tc_name in enumerate(tc_names):\\n\",\n",
    "    \"        ax = axes[vi, ti]\\n\",\n",
    "    \"        tc_idx_arr = TC_IDX[tc_name]\\n\",\n",
    "    \"        tc_m = tc_idx_arr[is_masked[tc_idx_arr]]\\n\",\n",
    "    \"        tc_v = tc_idx_arr[~is_masked[tc_idx_arr]]\\n\",\n",
    "    \"        # Pooled MAE vs lead for masked stations\\n\",\n",
