    "    \"    \\\"Median ΔMAE\\\": \\\"{:+.4f}\\\",\\n\",\n",
    "    \"    \\\"Std ΔMAE\\\": \\\"{:.4f}\\\",\\n\",\n",
    "    \"}).set_caption(f\\\"ΔMAE = MAE(v27 MR=0.5 vis) − MAE(v31 MR=0.0) on identical visible station set  —  \\\"\\n\",\n",
    "    \"               f\\\"positive = degradation\\\"))\\n\",\n",
    "    \"C.save_table(df_summary, \\\"43_vis_mae_change_v31mr0_vs_v27mr5\\\")\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
