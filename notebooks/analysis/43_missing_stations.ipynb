    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"nn_dist_analysis\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# ── Nearest-neighbour distances for visible stations under MR=0.0 vs MR=0.5 ──\\n\",\n",
    "    \"# MR=0.0: all 155 stations visible → NN distances from full network.\\n\",\n",
    "    \"# MR=0.5: masked stations removed → NN distances from visible subset only.\\n\",\n",
    "    \"east = stn.easting.values; north = stn.northing.values\\n\",\n",
    "    \"N = len(stn)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Pairwise distance matrix (km)\\n\",\n",
    "    \"DIST = np.sqrt((east[:, None] - east[None, :]) ** 2 +\\n\",\n",
    "    \"               (north[:, None] - north[None, :]) ** 2) / 1000.0\\n\",\n",
    "    \"np.fill_diagonal(DIST, np.inf)\\n\",\n",
    "    \"\\n\",\n",
    "    \"vis = ~is_masked\\n\",\n",
    "    \"vis_idx = np.where(vis)[0]\\n\",\n",
    "    \"\\n\",\n",
    "    \"rows = []\\n\",\n",
    "    \"for k in [1, 2, 3]:  # k-th nearest neighbour\\n\",\n",
    "    \"    for label, neighbour_set in [(\\\"MR=0.0 (all)\\\", np.arange(N)),\\n\",\n",
    "    \"                                  (\\\"MR=0.5 (visible only)\\\", vis_idx)]:\\n\",\n",
    "    \"        dists_k = []\\n\",\n",
    "    \"        for si in vis_idx:\\n\",\n",
    "    \"            d = DIST[si, neighbour_set]\\n\",\n",
    "    \"            d_sorted = np.sort(d[np.isfinite(d)])\\n\",\n",
    "    \"            if len(d_sorted) >= k:\\n\",\n",
    "    \"                dists_k.append(d_sorted[k - 1])\\n\",\n",
    "    \"            else:\\n\",\n",
    "    \"                dists_k.append(np.nan)\\n\",\n",
    "    \"        dists_k = np.array(dists_k)\\n\",\n",
    "    \"        rows.append({\\n\",\n",
    "    \"            \\\"k-th NN\\\": k,\\n\",\n",
    "    \"            \\\"Eval setup\\\": label,\\n\",\n",
    "    \"            \\\"N stations\\\": int(vis.sum()),\\n\",\n",
    "    \"            \\\"Mean [km]\\\": np.nanmean(dists_k),\\n\",\n",
    "    \"            \\\"Median [km]\\\": np.nanmedian(dists_k),\\n\",\n",
    "    \"            \\\"Std [km]\\\": np.nanstd(dists_k),\\n\",\n",
    "    \"            \\\"Min [km]\\\": np.nanmin(dists_k),\\n\",\n",
    "    \"            \\\"Max [km]\\\": np.nanmax(dists_k),\\n\",\n",
    "    \"            \\\"P25 [km]\\\": np.nanpercentile(dists_k, 25),\\n\",\n",
    "    \"            \\\"P75 [km]\\\": np.nanpercentile(dists_k, 75),\\n\",\n",
    "    \"        })\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_nn = pd.DataFrame(rows)\\n\",\n",
    "    \"print(f\\\"NN distance distribution for {int(vis.sum())} visible stations\\\\n\\\")\\n\",\n",
    "    \"display(df_nn.style.format({\\n\",\n",
    "    \"    \\\"Mean [km]\\\": \\\"{:.1f}\\\", \\\"Median [km]\\\": \\\"{:.1f}\\\", \\\"Std [km]\\\": \\\"{:.1f}\\\",\\n\",\n",
    "    \"    \\\"Min [km]\\\": \\\"{:.1f}\\\", \\\"Max [km]\\\": \\\"{:.1f}\\\",\\n\",\n",
    "    \"    \\\"P25 [km]\\\": \\\"{:.1f}\\\", \\\"P75 [km]\\\": \\\"{:.1f}\\\",\\n\",\n",
    "    \"}).set_caption(\\\"Distance to k-th nearest neighbour — \\\"\\n\",\n",
    "    \"               \\\"MR=0.0 uses full network, MR=0.5 uses visible subset only\\\"))\\n\",\n",
    "    \"C.save_table(df_nn, \\\"43_nn_dist_visible_stations\\\")\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"nn_dist_barplot\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# ── Bar plot: NN distance distribution by distance cluster ────────────────────\\n\",\n",
    "    \"# For each k-th NN (1, 2, 3), count visible stations falling into distance\\n\",\n",
    "    \"# bins under MR=0.0 vs MR=0.5.\\n\",\n",
    "    \"DIST_BINS = [0, 5, 10, 15, 20, 30, 50, 100, 200]\\n\",\n",
    "    \"BIN_LABELS = [f\\\"{lo}–{hi} km\\\" for lo, hi in zip(DIST_BINS[:-1], DIST_BINS[1:])]\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(1, 3, figsize=(18, 5), sharey=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"for ki, k in enumerate([1, 2, 3]):\\n\",\n",
    "    \"    ax = axes[ki]\\n\",\n",
    "    \"    x = np.arange(len(BIN_LABELS))\\n\",\n",
