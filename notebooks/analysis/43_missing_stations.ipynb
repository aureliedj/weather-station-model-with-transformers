    "    \"\\n\",\n",
    "    \"    for si, (label, neighbour_set, color) in enumerate([\\n\",\n",
    "    \"            (\\\"MR=0.0 (all)\\\", np.arange(N), COL_VISIBLE),\\n\",\n",
    "    \"            (\\\"MR=0.5 (visible only)\\\", np.where(vis)[0], COL_MASKED)]):\\n\",\n",
    "    \"        dists_k = []\\n\",\n",
    "    \"        for s in vis_idx:\\n\",\n",
    "    \"            d = DIST[s, neighbour_set]\\n\",\n",
    "    \"            d_sorted = np.sort(d[np.isfinite(d)])\\n\",\n",
    "    \"            if len(d_sorted) >= k:\\n\",\n",
    "    \"                dists_k.append(d_sorted[k - 1])\\n\",\n",
