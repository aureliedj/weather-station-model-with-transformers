    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# ── Summary: visible-station MAE — v31 MR=0.0 (dense) vs v27 MR=0.5 at +3 h ─\\n\",\n",
    "    \"# Apple-to-apple: only stations that are VISIBLE under v27 MR=0.5 and have\\n\",\n",
    "    \"# valid counts in BOTH v31 MR=0.0 and v27 MR=0.5.\\n\",\n",
    "    \"a0 = AGG[\\\"v31\\\"]; a5 = AGG5[\\\"v27\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"rows = []\\n\",\n",
    "    \"for vi, v in enumerate(VARS):\\n\",\n",
    "    \"    # v31 MR=0.0 per-station (dense baseline, all stations visible)\\n\",\n",
    "    \"    cnt0 = a0[\\\"mod_all_cnt\\\"][REF_KI, :, vi]\\n\",\n",
    "    \"    sum0 = a0[\\\"mod_all_sum_phys\\\"][REF_KI, :, vi]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # v27 MR=0.5 visible-station subset\\n\",\n",
    "    \"    cnt5 = a5[\\\"mod_vis_cnt\\\"][REF_KI, :, vi]\\n\",\n",
    "    \"    sum5 = a5[\\\"mod_vis_sum_phys\\\"][REF_KI, :, vi]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Intersection: visible in MR=0.5 AND valid data in both evals\\n\",\n",
    "    \"    valid = ~is_masked & (cnt0 > 0) & (cnt5 > 0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    mae0 = sum0[valid] / cnt0[valid]\\n\",\n",
    "    \"    mae5 = sum5[valid] / cnt5[valid]\\n\",\n",
    "    \"    d = mae5 - mae0  # positive = MR=0.5 worse\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Pooled MAE over the SAME station set\\n\",\n",
    "    \"    pooled_0 = sum0[valid].sum() / cnt0[valid].sum()\\n\",\n",
    "    \"    pooled_5 = sum5[valid].sum() / cnt5[valid].sum()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    rows.append({\\n\",\n",
    "    \"        \\\"Variable\\\": v,\\n\",\n",
    "    \"        \\\"Unit\\\": C.UNITS[v],\\n\",\n",
    "    \"        \\\"N stations\\\": int(valid.sum()),\\n\",\n",
    "    \"        \\\"Pooled MAE (v31 MR=0)\\\": pooled_0,\\n\",\n",
    "    \"        \\\"Pooled MAE (v27 MR=0.5)\\\": pooled_5,\\n\",\n",
    "    \"        \\\"ΔMAE (pooled)\\\": pooled_5 - pooled_0,\\n\",\n",
    "    \"        \\\"Δ% (pooled)\\\": 100 * (pooled_5 - pooled_0) / pooled_0,\\n\",\n",
    "    \"        \\\"Mean ΔMAE (per-stn)\\\": np.mean(d),\\n\",\n",
    "    \"        \\\"Median ΔMAE\\\": np.median(d),\\n\",\n",
    "    \"        \\\"Std ΔMAE\\\": np.std(d),\\n\",\n",
    "    \"        \\\"Stations improved\\\": int((d < 0).sum()),\\n\",\n",
    "    \"        \\\"Stations worsened\\\": int((d > 0).sum()),\\n\",\n",
    "    \"    })\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_summary = pd.DataFrame(rows)\\n\",\n",
    "    \"REF_LEAD = LEAD[REF_KI]\\n\",\n",
    "    \"print(f\\\"Visible-station MAE: v31 MR=0.0 vs v27 MR=0.5 at {REF_LEAD}\\\")\\n\",\n",
    "    \"print(f\\\"Compared on the same {rows[0]['N stations']} visible stations\\\\n\\\")\\n\",\n",
    "    \"display(df_summary.style.format({\\n\",\n",
    "    \"    \\\"Pooled MAE (v31 MR=0)\\\": \\\"{:.4f}\\\",\\n\",\n",
    "    \"    \\\"Pooled MAE (v27 MR=0.5)\\\": \\\"{:.4f}\\\",\\n\",\n",
