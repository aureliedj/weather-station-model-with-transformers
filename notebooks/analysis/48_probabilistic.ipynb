   "source": [
    "{\n",
    " \"nbformat\": 4,\n",
    " \"nbformat_minor\": 5,\n",
    " \"metadata\": {\n",
    "  \"kernelspec\": {\n",
    "   \"display_name\": \"Python 3\",\n",
    "   \"language\": \"python\",\n",
    "   \"name\": \"python3\"\n",
    "  },\n",
    "  \"language_info\": {\n",
    "   \"name\": \"python\",\n",
    "   \"version\": \"3.10.0\"\n",
    "  }\n",
    " },\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"t\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 4.8 — Probabilistic Forecasting and Uncertainty\\n\\nv30-nll: Gaussian NLL, predicted uncertainty (σ̂), calibration,\\nand uncertainty maps.\\n\\n**Terminology:**\\n- **σ̂** = predicted Gaussian standard deviation (model output)\\n- **σ_e** = std(ŷ − y), the prediction-error standard deviation\\n  (observed property of the residuals)\\n\\nThese are distinct quantities. σ̂ is what the model *thinks* its\\nuncertainty is; σ_e is how variable its errors actually are.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"boot\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-09-01T21:51:33.504606Z\",\n",
    "     \"start_time\": \"2026-09-01T21:51:16.715091Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"import os, sys, datetime as dt\\n\",\n",
    "    \"import numpy as np, pandas as pd, matplotlib.pyplot as plt\\n\",\n",
    "    \"import matplotlib.colors as mcolors\\n\",\n",
    "    \"for _cand in (os.getcwd(),\\n\",\n",
    "    \"              os.path.join(os.getcwd(), \\\"notebooks\\\", \\\"analysis\\\"),\\n\",\n",
    "    \"              os.path.dirname(os.path.abspath(\\\"__file__\\\"))):\\n\",\n",
    "    \"    if os.path.isfile(os.path.join(_cand, \\\"common.py\\\")):\\n\",\n",
    "    \"        if _cand not in sys.path: sys.path.insert(0, _cand)\\n\",\n",
    "    \"        break\\n\",\n",
    "    \"import importlib, common as C; importlib.reload(C)\\n\",\n",
    "    \"plt.style.use(\\\"default\\\")\\nplt.rcParams.update({\\\"figure.dpi\\\": 110, \\\"font.size\\\": 10,\\n                     \\\"figure.facecolor\\\": \\\"white\\\", \\\"axes.facecolor\\\": \\\"white\\\",\\n                     \\\"savefig.facecolor\\\": \\\"white\\\", \\\"axes.edgecolor\\\": \\\"0.3\\\",\\n                     \\\"axes.labelcolor\\\": \\\"black\\\", \\\"xtick.color\\\": \\\"0.3\\\",\\n                     \\\"ytick.color\\\": \\\"0.3\\\", \\\"text.color\\\": \\\"black\\\"})\\n\",\n",
    "    \"\\n\",\n",
    "    \"RUNS  = C.discovered_runs()\\n\",\n",
    "    \"MR0_RUNS = [r for r in RUNS if \\\"mr0.00\\\" in RUNS[r]]\\n\",\n",
    "    \"ns = C.norm_stats(); VARS = ns[\\\"var_names\\\"]; STD = ns[\\\"std\\\"]\\n\",\n",
    "    \"stn = C.station_table(); KEEP = C.keep_mask(stn, VARS)\\n\",\n",
    "    \"AGG  = {r: C.load_agg(r, \\\"mr0.00\\\") for r in MR0_RUNS}\\n\",\n",
    "    \"GRID = AGG[MR0_RUNS[0]][\\\"grid\\\"]; LEAD = C.lead_labels(GRID); K = len(GRID)\\n\",\n",
    "    \"NV = len(VARS)\\n\",\n",
    "    \"print(\\\"Models at MR=0.00:\\\", MR0_RUNS)\\n\",\n",
    "    \"\\n\",\n",
    "    \"import torch\\n\",\n",
    "    \"# v30-nll is the only model with log_var\\n\",\n",
    "    \"d_nll = C.load_dump(\\\"v30-nll\\\", \\\"mr0.00\\\")\\n\",\n",
    "    \"P_nll = d_nll[\\\"preds\\\"]                    # (M, K, N, 5)\\n\",\n",
    "    \"T_nll = d_nll[\\\"targets\\\"][:, :, :, :NV]\\n\",\n",
    "    \"M_nll = d_nll[\\\"masks\\\"][:, :, :, :NV]\\n\",\n",
    "    \"LV    = d_nll[\\\"log_var\\\"]                   # (M, K, N, 5)\\n\",\n",
    "    \"print(f\\\"v30-nll dump: M={P_nll.shape[0]}, K={P_nll.shape[1]}, N={P_nll.shape[2]}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"p = P_nll.numpy().astype(np.float64)\\n\",\n",
    "    \"t = T_nll.numpy().astype(np.float64)\\n\",\n",
    "    \"m = (M_nll.numpy() > 0.5) & KEEP[None, None]\\n\",\n",
    "    \"lv = LV.numpy().astype(np.float64)\\n\",\n",
    "    \"sigma_hat = np.sqrt(np.exp(lv))  # predicted σ̂\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"p1_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Per-lead Gaussian NLL\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"p1\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-09-01T21:51:44.480421Z\",\n",
    "     \"start_time\": \"2026-09-01T21:51:33.505673Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"eps2 = (p - t) ** 2\\n\",\n",
    "    \"nll = 0.5 * (eps2 * np.exp(-lv) + lv)\\n\",\n",
    "    \"\\n\",\n",
    "    \"nll_per_lead = np.zeros((K, NV))\\n\",\n",
    "    \"cnt_per_lead = np.zeros((K, NV))\\n\",\n",
    "    \"for ki in range(K):\\n\",\n",
    "    \"    for vi in range(NV):\\n\",\n",
    "    \"        mk = m[:, ki, :, vi]\\n\",\n",
    "    \"        nll_per_lead[ki, vi] = nll[:, ki, :, vi][mk].sum()\\n\",\n",
    "    \"        cnt_per_lead[ki, vi] = mk.sum()\\n\",\n",
    "    \"nll_mean = nll_per_lead / np.maximum(cnt_per_lead, 1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(1, NV, figsize=(17, 3.4))\\n\",\n",
    "    \"for vi, (ax, v) in enumerate(zip(axes, VARS)):\\n\",\n",
    "    \"    ax.plot(range(1, K), nll_mean[1:, vi], \\\"o-\\\", ms=4, lw=1.4, color=\\\"#E1A730\\\")\\n\",\n",
    "    \"    ax.set_xticks(range(1, K, 2))\\n\",\n",
    "    \"    ax.set_xticklabels(LEAD[1::2], rotation=45, ha=\\\"right\\\", fontsize=6.5)\\n\",\n",
    "    \"    ax.set_title(f\\\"{v}\\\", fontsize=10); ax.grid(alpha=.3)\\n\",\n",
    "    \"axes[0].set_ylabel(\\\"Mean Gaussian NLL [normalised units]\\\")\\n\",\n",
    "    \"fig.suptitle(\\\"Probabilistic MAE: Gaussian NLL vs lead time (MR=0)\\\", y=1.04)\\n\",\n",
    "    \"plt.tight_layout(); C.save_fig(fig, \\\"48_nll_vs_lead\\\"); plt.show()\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"p2_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Calibration: observed coverage vs predicted intervals\\n\\nFor a well-calibrated Gaussian, the fraction of observations within\\n±kσ̂ should match the theoretical CDF. Points above the diagonal =\\noverconfident (intervals too narrow); below = underconfident.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"p2\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-09-01T21:51:59.975311Z\",\n",
    "     \"start_time\": \"2026-09-01T21:51:45.637601Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"from scipy.stats import norm as sp_norm\\n\",\n",
    "    \"k_vals = np.linspace(0.5, 3.0, 11)\\n\",\n",
    "    \"expected = 2 * sp_norm.cdf(k_vals) - 1   # two-sided coverage\\n\",\n",
    "    \"\\n\",\n",
    "    \"z = np.abs(p - t) / np.maximum(sigma_hat, 1e-8)  # |standardised residual|\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(1, NV, figsize=(17, 3.4))\\n\",\n",
    "    \"for vi, (ax, v) in enumerate(zip(axes, VARS)):\\n\",\n",
    "    \"    observed = []\\n\",\n",
    "    \"    for kk in k_vals:\\n\",\n",
    "    \"        inside = (z[:, :, :, vi] <= kk) & m[:, :, :, vi]\\n\",\n",
    "    \"        observed.append(inside.sum() / max(m[:, :, :, vi].sum(), 1))\\n\",\n",
    "    \"    ax.plot(expected, observed, \\\"o-\\\", ms=4, lw=1.3, color=\\\"#E1A730\\\", label=\\\"Probabilistic MAE\\\")\\n\",\n",
    "    \"    ax.plot([0, 1], [0, 1], \\\"k--\\\", lw=0.8, label=\\\"perfect calibration\\\")\\n\",\n",
    "    \"    ax.set_xlabel(\\\"Expected coverage\\\"); ax.set_title(v, fontsize=10)\\n\",\n",
    "    \"    ax.grid(alpha=.3); ax.set_xlim(0, 1); ax.set_ylim(0, 1)\\n\",\n",
    "    \"axes[0].set_ylabel(\\\"Observed coverage\\\")\\n\",\n",
    "    \"axes[-1].legend(fontsize=8)\\n\",\n",
    "    \"fig.suptitle(\\\"Calibration of the Probabilistic MAE (MR=0), all lead times and stations: observed vs expected fraction of residuals inside ±kσ, k = 0.5…3\\\", y=1.04)\\n\",\n",
    "    \"plt.tight_layout(); C.save_fig(fig, \\\"48_calibration\\\"); plt.show()\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"p3_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Predicted uncertainty (σ̂) vs actual MAE — sharpness check\\n\\nBin observations by predicted-σ̂ quintiles. A sharp model should show\\nactual MAE tracking predicted σ̂ monotonically.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"p3\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-09-01T21:52:03.845611Z\",\n",
    "     \"start_time\": \"2026-09-01T21:52:00.497656Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"REF_KI = 6\\n\",\n",
    "    \"fig, axes = plt.subplots(1, NV, figsize=(17, 3.5))\\n\",\n",
    "    \"for vi, (ax, v) in enumerate(zip(axes, VARS)):\\n\",\n",
    "    \"    mk = m[:, REF_KI, :, vi]\\n\",\n",
    "    \"    actual_mae = np.abs(p[:, REF_KI, :, vi] - t[:, REF_KI, :, vi])\\n\",\n",
    "    \"    pred_sig = sigma_hat[:, REF_KI, :, vi]\\n\",\n",
    "    \"    valid = mk.ravel()\\n\",\n",
    "    \"    ae = actual_mae.ravel()[valid]\\n\",\n",
    "    \"    ps = pred_sig.ravel()[valid]\\n\",\n",
    "    \"    q = np.percentile(ps, [20, 40, 60, 80])\\n\",\n",
    "    \"    bins_s = np.digitize(ps, q)\\n\",\n",
    "    \"    means_ae = [ae[bins_s == b].mean() for b in range(5)]\\n\",\n",
    "    \"    means_ps = [ps[bins_s == b].mean() for b in range(5)]\\n\",\n",
    "    \"    ax.bar(range(5), means_ae, color=\\\"#1F5F6B\\\", alpha=0.7, label=\\\"actual MAE\\\")\\n\",\n",
    "    \"    ax.plot(range(5), means_ps, \\\"D-\\\", color=\\\"#E1A730\\\", ms=6, lw=1.5,\\n\",\n",
    "    \"            label=\\\"predicted σ̂\\\")\\n\",\n",
    "    \"    ax.set_xticks(range(5))\\n\",\n",
    "    \"    ax.set_xticklabels([\\\"Q1\\\\n(low σ̂)\\\", \\\"Q2\\\", \\\"Q3\\\", \\\"Q4\\\", \\\"Q5\\\\n(high σ̂)\\\"], fontsize=7)\\n\",\n",
    "    \"    ax.set_title(v, fontsize=10); ax.grid(alpha=.3)\\n\",\n",
    "    \"axes[0].set_ylabel(f\\\"value at {LEAD[REF_KI]}\\\")\\n\",\n",
    "    \"axes[-1].legend(fontsize=7)\\n\",\n",
    "    \"fig.suptitle(f\\\"Sharpness: actual MAE vs predicted σ̂ quintiles at {LEAD[REF_KI]}\\\", y=1.04)\\n\",\n",
    "    \"plt.tight_layout(); C.save_fig(fig, \\\"48_sharpness\\\"); plt.show()\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"p4_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Per-station predicted uncertainty (σ̂) maps\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"p4\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-09-01T21:52:11.870876Z\",\n",
    "     \"start_time\": \"2026-09-01T21:52:05.171553Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# Mean predicted σ̂ per station per lead\\n\",\n",
    "    \"sigma_station = np.zeros((K, P_nll.shape[2], NV))\\n\",\n",
    "    \"for ki in range(K):\\n\",\n",
    "    \"    for vi in range(NV):\\n\",\n",
    "    \"        mk = m[:, ki, :, vi]\\n\",\n",
    "    \"        s = (sigma_hat[:, ki, :, vi] * mk).sum(0)\\n\",\n",
    "    \"        c = mk.sum(0)\\n\",\n",
    "    \"        sigma_station[ki, :, vi] = np.where(c > 0, s / np.maximum(c, 1), np.nan)\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(NV, 3, figsize=(16, 3.5 * NV))\\n\",\n",
    "    \"for vi, v in enumerate(VARS):\\n\",\n",
    "    \"    for ci, (ki, klbl) in enumerate([(1, \\\"+30 min\\\"), (4, \\\"+2 h\\\"), (12, \\\"+6 h\\\")]):\\n\",\n",
    "    \"        ax = axes[vi, ci]\\n\",\n",
    "    \"        vals = sigma_station[ki, :, vi]\\n\",\n",
    "    \"        valid = ~np.isnan(vals)\\n\",\n",
    "    \"        sc = ax.scatter(stn.longitude[valid], stn.latitude[valid],\\n\",\n",
    "    \"                        c=vals[valid], s=30, cmap=\\\"inferno\\\",\\n\",\n",
    "    \"                        edgecolors=\\\"k\\\", linewidths=0.3)\\n\",\n",
    "    \"        fig.colorbar(sc, ax=ax, fraction=0.04, pad=0.02)\\n\",\n",
    "    \"        ax.set_aspect(\\\"equal\\\"); ax.tick_params(labelsize=5)\\n\",\n",
    "    \"        ax.set_xlim(5.8, 10.6); ax.set_ylim(45.8, 47.9)\\n\",\n",
    "    \"        if vi == 0: ax.set_title(klbl, fontsize=11, fontweight=\\\"bold\\\")\\n\",\n",
    "    \"        if ci == 0: ax.set_ylabel(f\\\"{v} [{C.UNITS[v]}]\\\", fontsize=9)\\n\",\n",
    "    \"fig.suptitle(\\\"Probabilistic MAE: mean predicted σ̂ per station (normalised units)\\\", y=1.02)\\n\",\n",
    "    \"plt.tight_layout(); C.save_fig(fig, \\\"48_uncertainty_maps\\\"); plt.show()\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"p5_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Per-station σ̂ vs actual MAE\\n\\nThe most important diagnostic: *does the model correctly identify\\nwhich stations are hard to forecast?*\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"p5\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-09-01T21:52:13.605512Z\",\n",
    "     \"start_time\": \"2026-09-01T21:52:12.649382Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"from scipy.stats import pearsonr\\n\",\n",
    "    \"REF_KI = 6\\n\",\n",
    "    \"fig, axes = plt.subplots(1, NV, figsize=(17, 3.5))\\n\",\n",
    "    \"for vi, (ax, v) in enumerate(zip(axes, VARS)):\\n\",\n",
    "    \"    # per-station mean σ̂ and MAE at REF_KI\\n\",\n",
    "    \"    mk = m[:, REF_KI, :, vi]\\n\",\n",
    "    \"    ae = np.abs(p[:, REF_KI, :, vi] - t[:, REF_KI, :, vi])\\n\",\n",
    "    \"    mae_stn = np.where(mk.sum(0) > 0, (ae * mk).sum(0) / np.maximum(mk.sum(0), 1), np.nan)\\n\",\n",
    "    \"    sig_stn = sigma_station[REF_KI, :, vi]\\n\",\n",
    "    \"    valid = ~np.isnan(mae_stn) & ~np.isnan(sig_stn)\\n\",\n",
    "    \"    ax.scatter(sig_stn[valid], mae_stn[valid], s=15, alpha=0.6, color=\\\"#E1A730\\\")\\n\",\n",
    "    \"    r, pv = pearsonr(sig_stn[valid], mae_stn[valid])\\n\",\n",
    "    \"    ax.set_title(f\\\"{v}  (r={r:.2f}, p={pv:.1e})\\\", fontsize=9)\\n\",\n",
    "    \"    ax.set_xlabel(\\\"mean predicted σ̂\\\", fontsize=8)\\n\",\n",
    "    \"    ax.grid(alpha=.3)\\n\",\n",
    "    \"    # reference line\\n\",\n",
    "    \"    lims = [min(ax.get_xlim()[0], ax.get_ylim()[0]),\\n\",\n",
    "    \"            max(ax.get_xlim()[1], ax.get_ylim()[1])]\\n\",\n",
    "    \"    ax.plot(lims, lims, \\\"k--\\\", lw=0.8, alpha=0.5)\\n\",\n",
    "    \"axes[0].set_ylabel(f\\\"actual MAE at {LEAD[REF_KI]}\\\")\\n\",\n",
    "    \"fig.suptitle(f\\\"Per-station: predicted σ̂ vs actual MAE at {LEAD[REF_KI]} (MR=0)\\\", y=1.04)\\n\",\n",
    "    \"plt.tight_layout(); C.save_fig(fig, \\\"48_sigma_vs_mae\\\"); plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"del d_nll, P_nll, T_nll, M_nll, LV  # free memory\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"interp\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Interpretation\\n\\n**NLL** should increase with lead time as prediction becomes harder.\\n\\n**Calibration:** points above the diagonal mean the model is\\noverconfident (predicted intervals too narrow); below = underconfident.\\n\\n**Sharpness:** if actual MAE tracks predicted σ̂ across quintiles,\\nthe model correctly adjusts its confidence to match difficulty.\\n\\n**σ̂ vs MAE scatter:** a high Pearson r means the model identifies\\nwhich stations are intrinsically harder to forecast. This is the\\nmost operationally useful property of the probabilistic head.\\n\\nCompare NLL-trained v30 vs Huber-trained v27 on point-forecast MAE\\n(notebook 4.1) to assess whether the NLL objective helps or hurts\\npoint accuracy.\"\n",
    "   ]\n",
    "  }\n",
    " ]\n",
    "}\n"
   ],
   "id": "588d52503486961e"
  }
 ],
