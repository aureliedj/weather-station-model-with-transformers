    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 4.7 — Topographic Controls on Prediction Performance\\n\\nElevation, relief, TPI and the 4-class terrain classification vs MAE.\\nFocus on **v27 at MR=0.5, masked stations only** at Δ ≈ 3 h.\\n\\nThis is the cleanest test of: *what makes a station difficult to\\nreconstruct when it is missing?*\\n\\n**Caveat:** because the v27 mask is fixed, the masked stations are a\\nparticular subset of the network. Correlations are conditional on that\\nsubset (N_masked stations).\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"boot\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-09-02T10:14:25.689856Z\",\n",
    "     \"start_time\": \"2026-09-02T10:14:23.752600Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"import os, sys, datetime as dt\\n\",\n",
    "    \"import numpy as np, pandas as pd, matplotlib.pyplot as plt\\n\",\n",
    "    \"import matplotlib.colors as mcolors\\n\",\n",
    "    \"for _cand in (os.getcwd(),\\n\",\n",
    "    \"              os.path.join(os.getcwd(), \\\"notebooks\\\", \\\"analysis\\\"),\\n\",\n",
    "    \"              os.path.dirname(os.path.abspath(\\\"__file__\\\"))):\\n\",\n",
    "    \"    if os.path.isfile(os.path.join(_cand, \\\"common.py\\\")):\\n\",\n",
    "    \"        if _cand not in sys.path: sys.path.insert(0, _cand)\\n\",\n",
    "    \"        break\\n\",\n",
    "    \"import importlib, common as C; importlib.reload(C)\\n\",\n",
    "    \"plt.style.use(\\\"default\\\")\\n\",\n",
    "    \"plt.rcParams.update({\\\"figure.dpi\\\": 110, \\\"font.size\\\": 10,\\n\",\n",
    "    \"                     \\\"figure.facecolor\\\": \\\"white\\\", \\\"axes.facecolor\\\": \\\"white\\\",\\n\",\n",
    "    \"                     \\\"savefig.facecolor\\\": \\\"white\\\", \\\"axes.edgecolor\\\": \\\"0.3\\\",\\n\",\n",
    "    \"                     \\\"axes.labelcolor\\\": \\\"black\\\", \\\"xtick.color\\\": \\\"0.3\\\",\\n\",\n",
    "    \"                     \\\"ytick.color\\\": \\\"0.3\\\", \\\"text.color\\\": \\\"black\\\"})\\n\",\n",
    "    \"\\n\",\n",
    "    \"RUNS  = C.discovered_runs()\\n\",\n",
    "    \"MR0_RUNS = [r for r in RUNS if \\\"mr0.00\\\" in RUNS[r]]\\n\",\n",
    "    \"ns = C.norm_stats(); VARS = ns[\\\"var_names\\\"]; STD = ns[\\\"std\\\"]\\n\",\n",
    "    \"stn = C.station_table(); KEEP = C.keep_mask(stn, VARS)\\n\",\n",
    "    \"AGG  = {r: C.load_agg(r, \\\"mr0.00\\\") for r in MR0_RUNS}\\n\",\n",
    "    \"GRID = AGG[MR0_RUNS[0]][\\\"grid\\\"]; LEAD = C.lead_labels(GRID); K = len(GRID)\\n\",\n",
    "    \"NV = len(VARS)\\n\",\n",
    "    \"print(\\\"Models at MR=0.00:\\\", MR0_RUNS)\\n\",\n",
    "    \"\\n\",\n",
    "    \"MR5_RUNS = [r for r in RUNS if \\\"mr0.50\\\" in RUNS[r]]\\n\",\n",
    "    \"AGG5 = {r: C.load_agg(r, \\\"mr0.50\\\") for r in MR5_RUNS}\\n\",\n",
    "    \"TC_IDX = C.terrain_class_indices(stn)\\n\",\n",
    "    \"REF_KI = 6  # ≈ 3 h\\n\",\n",
    "    \"\\n\",\n",
    "    \"# NOTE (2026-09-01): the MR=0.5 evaluation mask is NOT fixed across windows.\\n\",\n",
    "    \"# predictions.pt has 11,684 distinct masks (77 stations each); every station is\\n\",\n",
    "    \"# masked in ~48-51% of windows. mod_msk_* / mod_vis_* therefore exist for ALL\\n\",\n",
    "    \"# 155 stations, and each station has both a masked-window and a visible-window\\n\",\n",
    "    \"# MAE. Plot both for every station instead of splitting stations by MI[0].\\n\",\n",
    "    \"# is_masked below is the FIRST window's mask only; kept for the map cell (p4).\\n\",\n",
    "    \"import torch\\n\",\n",
    "    \"d5 = C.load_dump(\\\"v27\\\", \\\"mr0.50\\\")\\n\",\n",
    "    \"MI = d5[\\\"masked_idx\\\"]\\n\",\n",
    "    \"masked_set = set(MI[0].tolist())\\n\",\n",
    "    \"is_masked = np.array([i in masked_set for i in range(len(stn))])\\n\",\n",
    "    \"N_masked = is_masked.sum()\\n\",\n",
    "    \"print(f\\\"Masked stations: {N_masked} / {len(stn)}\\\")\\n\",\n",
    "    \"del d5\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"markers\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-09-02T10:14:25.699313Z\",\n",
    "     \"start_time\": \"2026-09-02T10:14:25.694947Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# ── Marker convention across all MR=0.5 maps ──\\n\",\n",
    "    \"# masked stations  = triangle marker\\n\",\n",
    "    \"# visible stations = 'o' marker\\n\",\n",
    "    \"MRK_MASKED, MRK_VISIBLE = \\\"^\\\", \\\"o\\\"\\n\",\n",
    "    \"COL_MASKED, COL_VISIBLE = \\\"#C4502A\\\", \\\"#1F5F6B\\\"\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"dem\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-09-02T10:14:36.286689Z\",\n",
    "     \"start_time\": \"2026-09-02T10:14:25.699791Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"import geopandas as gpd\\n\",\n",
    "    \"import rioxarray  # noqa\\n\",\n",
    "    \"\\n\",\n",
    "    \"PROJ = os.path.abspath(os.path.join(os.getcwd(), \\\"..\\\", \\\"..\\\")) \\\\\\n\",\n",
    "    \"       if os.path.isfile(\\\"common.py\\\") else os.getcwd()\\n\",\n",
    "    \"if os.path.join(PROJ, \\\"src\\\") not in sys.path:\\n\",\n",
    "    \"    sys.path.insert(0, os.path.join(PROJ, \\\"src\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"PATH_SWISSSHAPE = os.path.expanduser(\\n\",\n",
    "    \"    os.environ.get(\\\"SWISSSHAPE\\\",\\n\",\n",
    "    \"        os.path.join(PROJ, \\\"swissboundaries3d_2056.shp.zip\\\")))\\n\",\n",
    "    \"_CAND = [os.environ.get(\\\"DATA_ROOT\\\", \\\"\\\"),\\n\",\n",
    "    \"         os.path.expanduser(\\\"~/PeakWeatherDataset\\\"),\\n\",\n",
    "    \"         os.path.join(PROJ, \\\"PeakWeatherDataset\\\")]\\n\",\n",
    "    \"DATA_ROOT = next((p for p in _CAND if os.path.isdir(str(p))), _CAND[-1])\\n\",\n",
    "    \"\\n\",\n",
    "    \"from peakweather.dataset import PeakWeatherDataset\\n\",\n",
    "    \"ds_topo = PeakWeatherDataset(\\n\",\n",
    "    \"    root=DATA_ROOT,\\n\",\n",
    "    \"    parameters=[\\\"temperature\\\", \\\"pressure\\\", \\\"humidity\\\",\\n\",\n",
    "    \"                 \\\"wind_speed\\\", \\\"wind_direction\\\", \\\"precipitation\\\"],\\n\",\n",
    "    \"    compute_uv=True, station_type=\\\"meteo_station\\\",\\n\",\n",
    "    \"    imputation_method=None, freq=\\\"d\\\", extended_topo_vars=\\\"DEM\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _load_dem_and_border(ds_topo, path_swissshape, coarsen=10):\\n\",\n",
    "    \"    switzerland = gpd.read_file(\\n\",\n",
    "    \"        path_swissshape,\\n\",\n",
    "    \"        layer='swissBOUNDARIES3D_1_5_TLM_LANDESGEBIET').to_crs('EPSG:2056')\\n\",\n",
    "    \"    minx, miny, maxx, maxy = switzerland.total_bounds\\n\",\n",
    "    \"    topo = ds_topo.load_topography()\\n\",\n",
    "    \"    dem  = topo['topo_DEM'].dem\\n\",\n",
    "    \"    dem_ch = dem.rio.clip(switzerland.geometry, switzerland.crs, drop=False)\\n\",\n",
    "    \"    dem_bg = dem.coarsen(x=coarsen, y=coarsen, boundary='trim').mean()\\n\",\n",
    "    \"    dem_fg = dem_ch.coarsen(x=coarsen, y=coarsen, boundary='trim').mean()\\n\",\n",
    "    \"    dem_bg = dem_bg.sel(x=slice(minx, maxx), y=slice(miny, maxy))\\n\",\n",
    "    \"    dem_fg = dem_fg.sel(x=slice(minx, maxx), y=slice(miny, maxy))\\n\",\n",
    "    \"    return dem_bg, dem_fg, switzerland\\n\",\n",
    "    \"\\n\",\n",
    "    \"def draw_dem(ax, dem_bg, dem_fg, switzerland):\\n\",\n",
    "    \"    norm = mcolors.Normalize(vmin=0, vmax=4500)\\n\",\n",
    "    \"    dem_bg.plot(ax=ax, cmap='terrain', norm=norm, alpha=0.35,\\n\",\n",
    "    \"                robust=True, add_labels=False, add_colorbar=False)\\n\",\n",
    "    \"    dem_fg.plot(ax=ax, cmap='terrain', norm=norm,\\n\",\n",
    "    \"                robust=True, add_labels=False, add_colorbar=False)\\n\",\n",
    "    \"    switzerland.boundary.plot(ax=ax, color='white', linewidth=1.0)\\n\",\n",
    "    \"    ax.axis('off')\\n\",\n",
    "    \"\\n\",\n",
    "    \"print('Loading DEM + border ...')\\n\",\n",
    "    \"dem_bg, dem_fg, switzerland = _load_dem_and_border(ds_topo, PATH_SWISSSHAPE)\\n\",\n",
    "    \"print('Done.')\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"c7a2afb1e7604c92\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Exclusion overlay\\n\",\n",
    "    \"\\n\",\n",
    "    \"Every per-station scatter map below also marks stations excluded for that\\n\",\n",
    "    \"variable (`common.excluded_station_variable_reasons()`) with an X:\\n\",\n",
    "    \"**black** = missing in both train and test, **white** = missing in train\\n\",\n",
    "    \"only, **grey** = missing in test only, **orange** = present in both splits\\n\",\n",
    "    \"but excluded for a data-quality reason (BIZ/pressure, sensor drift).\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"8b33f50423d544d1\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-09-02T10:14:36.330758Z\",\n",
    "     \"start_time\": \"2026-09-02T10:14:36.325340Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"REASON_STYLE = {\\n\",\n",
    "    \"    \\\"missing_train\\\": dict(color=\\\"white\\\",   label=\\\"missing in train only\\\"),\\n\",\n",
    "    \"    \\\"missing_test\\\":  dict(color=\\\"0.6\\\",     label=\\\"missing in test only\\\"),\\n\",\n",
    "    \"    \\\"missing_both\\\":  dict(color=\\\"black\\\",   label=\\\"missing in train & test\\\"),\\n\",\n",
    "    \"    \\\"drift\\\":         dict(color=\\\"#E8A838\\\", label=\\\"excluded \\\\u2014 sensor drift\\\"),\\n\",\n",
    "    \"}\\n\",\n",
    "    \"EXCL_REASONS = C.excluded_station_variable_reasons()\\n\",\n",
    "    \"\\n\",\n",
    "    \"def overlay_exclusion_markers(ax, variable, s=70, legend=False):\\n\",\n",
    "    \"    return  # X markers removed per user request\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"8ba82c715a1a4151\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Station map by terrain class on the DEM (report Figure: data_station_map_terrain)\\n\",\n",
    "    \"\\n\",\n",
    "    \"All 155 stations as equal-size circles coloured by the four terrain classes of\\n\",\n",
    "    \"`common.station_table()`, over the DEM + Swiss border. Right panel: elevation\\n\",\n",
    "    \"distribution stacked by class with the 900 m valley-floor / elevated-enclosed split.\\n\",\n",
    "    \"Copy `47_station_map_terrain_dem.png` to the report as `figures/data_station_map_terrain.png`.\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"p1_title\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## MAE vs elevation — scatter\\n\",\n",
    "    \"\\n\",\n",
    "    \"Each point is one masked station. Pearson r reported.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-09-02T10:18:22.799664Z\",\n",
    "     \"start_time\": \"2026-09-02T10:18:21.497725Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# ── Station map by terrain class on the DEM + elevation histogram ────────────\\n\",\n",
    "    \"TC_COLORS_MAP = {\\\"valley floor\\\": \\\"#2B7A78\\\", \\\"elevated enclosed\\\": \\\"#D4A373\\\",\\n\",\n",
    "    \"                 \\\"exposed ridge/summit\\\": \\\"#BC4749\\\", \\\"open / slope\\\": \\\"#5B8E7D\\\"}\\n\",\n",
    "    \"h_all = stn.height.values.astype(float)\\n\",\n",
    "    \"tc_all = stn.terrain_class.values\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, (ax_map, ax_hist) = plt.subplots(\\n\",\n",
    "    \"    1, 2, figsize=(14, 5.2), gridspec_kw={\\\"width_ratios\\\": [2.4, 1]})\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Left: DEM background + one equal-size circle per station\\n\",\n",
    "    \"draw_dem(ax_map, dem_bg, dem_fg, switzerland)\\n\",\n",
    "    \"for tc in C.TCLASSES:\\n\",\n",
    "    \"    idx = TC_IDX[tc]\\n\",\n",
    "    \"    ax_map.scatter(stn.easting.values[idx], stn.northing.values[idx],\\n\",\n",
    "    \"                   s=42, c=TC_COLORS_MAP[tc], marker=\\\"o\\\",\\n\",\n",
    "    \"                   edgecolors=\\\"k\\\", linewidths=0.5, zorder=5,\\n\",\n",
    "    \"                   label=f\\\"{tc} (n={len(idx)})\\\")\\n\",\n",
    "    \"ax_map.legend(fontsize=8, loc=\\\"lower right\\\", framealpha=0.9, title=\\\"terrain class\\\",\\n\",\n",
    "    \"              title_fontsize=8)\\n\",\n",
    "    \"ax_map.set_title(f\\\"{len(stn)} stations by terrain class\\\", fontsize=11)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Right: elevation histogram stacked by class\\n\",\n",
    "    \"bins = np.arange(200, 3700, 200)\\n\",\n",
    "    \"bottom = np.zeros(len(bins) - 1)\\n\",\n",
    "    \"for tc in C.TCLASSES:\\n\",\n",
    "    \"    cnt, _ = np.histogram(h_all[TC_IDX[tc]], bins=bins)\\n\",\n",
    "    \"    ax_hist.bar(bins[:-1], cnt, width=200, bottom=bottom, align=\\\"edge\\\",\\n\",\n",
    "    \"                color=TC_COLORS_MAP[tc], edgecolor=\\\"k\\\", linewidth=0.3)\\n\",\n",
    "    \"    bottom += cnt\\n\",\n",
    "    \"ax_hist.axvline(900, color=\\\"k\\\", ls=\\\"--\\\", lw=0.9)\\n\",\n",
    "    \"ax_hist.text(930, ax_hist.get_ylim()[1] * 0.95, \\\"900 m\\\", fontsize=8, va=\\\"top\\\")\\n\",\n",
    "    \"ax_hist.set_xlabel(\\\"Station elevation [m]\\\"); ax_hist.set_ylabel(\\\"# stations\\\")\\n\",\n",
    "    \"ax_hist.set_title(\\\"Elevation distribution\\\", fontsize=11); ax_hist.grid(alpha=0.25, axis=\\\"y\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"C.save_fig(fig, \\\"47_station_map_terrain_dem\\\")\\n\",\n",
    "    \"plt.show(); plt.close(fig)\\n\"\n",
    "   ],\n",
