    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"from scipy.stats import pearsonr\\n\",\n",
    "    \"topo_cols = [\\\"height\\\", \\\"slope\\\", \\\"relief_2km\\\", \\\"relief_10km\\\",\\n\",\n",
    "    \"             \\\"tpi_n2\\\", \\\"tpi_n10\\\", \\\"nn_dist_km\\\", \\\"n_within_50km\\\"]\\n\",\n",
    "    \"a = AGG5[\\\"v27\\\"]\\n\",\n",
    "    \"rows = []\\n\",\n",
    "    \"for vi, v in enumerate(VARS):\\n\",\n",
    "    \"    cnt = a[\\\"mod_msk_cnt\\\"][REF_KI, :, vi]\\n\",\n",
    "    \"    s   = a[\\\"mod_msk_sum_phys\\\"][REF_KI, :, vi]\\n\",\n",
    "    \"    mae = np.where(cnt > 0, s / np.maximum(cnt, 1), np.nan)\\n\",\n",
    "    \"    valid = ~np.isnan(mae)  # all stations, masked-window MAE\\n\",\n",
    "    \"    for tc in topo_cols:\\n\",\n",
    "    \"        r, p = pearsonr(stn[tc].values[valid], mae[valid])\\n\",\n",
    "    \"        rows.append({\\\"variable\\\": v, \\\"descriptor\\\": tc, \\\"r\\\": r, \\\"p\\\": p})\\n\",\n",
    "    \"corr_df = pd.DataFrame(rows)\\n\",\n",
    "    \"piv = corr_df.pivot(index=\\\"descriptor\\\", columns=\\\"variable\\\", values=\\\"r\\\")\\n\",\n",
    "    \"fig, ax = plt.subplots(figsize=(8, 5))\\n\",\n",
    "    \"im = ax.imshow(piv.values, cmap=\\\"RdBu_r\\\", vmin=-0.5, vmax=0.5, aspect=\\\"auto\\\")\\n\",\n",
    "    \"ax.set_xticks(range(len(piv.columns)))\\n\",\n",
    "    \"ax.set_xticklabels(piv.columns, fontsize=9, rotation=30, ha=\\\"right\\\")\\n\",\n",
    "    \"ax.set_yticks(range(len(piv.index)))\\n\",\n",
    "    \"ax.set_yticklabels(piv.index, fontsize=9)\\n\",\n",
    "    \"for i in range(len(piv.index)):\\n\",\n",
    "    \"    for j in range(len(piv.columns)):\\n\",\n",
