    "   \"source\": [\n",
    "    \"# ── Station map by terrain class on the DEM + elevation histogram ────────────\\n\",\n",
    "    \"TC_COLORS_MAP = {\\\"valley floor\\\": \\\"#2B7A78\\\", \\\"elevated enclosed\\\": \\\"#D4A373\\\",\\n\",\n",
    "    \"                 \\\"exposed ridge/summit\\\": \\\"#BC4749\\\", \\\"open / slope\\\": \\\"#5B8E7D\\\"}\\n\",\n",
    "    \"h_all = stn.height.values.astype(float)\\n\",\n",
    "    \"tc_all = stn.terrain_class.values\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, ax_map = plt.subplots(figsize=(14, 5.2))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Left: DEM background + one equal-size circle per station\\n\",\n",
    "    \"draw_dem(ax_map, dem_bg, dem_fg, switzerland)\\n\",\n",
    "    \"for tc in C.TCLASSES:\\n\",\n",
    "    \"    idx = TC_IDX[tc]\\n\",\n",
    "    \"    ax_map.scatter(stn.easting.values[idx], stn.northing.values[idx],\\n\",\n",
    "    \"                   s=42, c=TC_COLORS_MAP[tc], marker=\\\"o\\\",\\n\",\n",
    "    \"                   edgecolors=\\\"k\\\", linewidths=0.5, zorder=5,\\n\",\n",
    "    \"                   label=f\\\"{tc} (n={len(idx)})\\\")\\n\",\n",
    "    \"ax_map.legend(fontsize=8, loc=\\\"lower right\\\", framealpha=0.9, title=\\\"terrain class\\\",\\n\",\n",
    "    \"              title_fontsize=8)\\n\",\n",
    "    \"ax_map.set_title(f\\\"{len(stn)} stations by terrain class\\\", fontsize=11)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"C.save_fig(fig, \\\"47_station_map_terrain_dem_v2\\\")\\n\",\n",
    "    \"plt.show(); plt.close(fig)\\n\"\n",
    "   ],\n",
