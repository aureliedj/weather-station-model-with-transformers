    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"p1\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-09-02T10:14:38.680129Z\",\n",
    "     \"start_time\": \"2026-09-02T10:14:37.764741Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"from scipy.stats import pearsonr\\n\",\n",
    "    \"fig, axes = plt.subplots(1, NV, figsize=(17, 3.5))\\n\",\n",
    "    \"a = AGG5[\\\"v27\\\"]\\n\",\n",
    "    \"h = stn.height.values\\n\",\n",
    "    \"for vi, (ax, v) in enumerate(zip(axes, VARS)):\\n\",\n",
    "    \"    # Masked stations\\n\",\n",
    "    \"    cnt_m = a[\\\"mod_msk_cnt\\\"][REF_KI, :, vi]\\n\",\n",
    "    \"    s_m   = a[\\\"mod_msk_sum_phys\\\"][REF_KI, :, vi]\\n\",\n",
    "    \"    mae_m = np.where(cnt_m > 0, s_m / np.maximum(cnt_m, 1), np.nan)\\n\",\n",
    "    \"    valid_m = ~np.isnan(mae_m)\\n\",\n",
    "    \"    ax.scatter(h[valid_m], mae_m[valid_m], s=20, alpha=0.6,\\n\",\n",
    "    \"               color=COL_MASKED, marker=MRK_MASKED, label=\\\"masked windows\\\")\\n\",\n",
    "    \"    r_m, p_m = pearsonr(h[valid_m], mae_m[valid_m])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Visible stations\\n\",\n",
    "    \"    cnt_v = a[\\\"mod_vis_cnt\\\"][REF_KI, :, vi]\\n\",\n",
    "    \"    s_v   = a[\\\"mod_vis_sum_phys\\\"][REF_KI, :, vi]\\n\",\n",
    "    \"    mae_v = np.where(cnt_v > 0, s_v / np.maximum(cnt_v, 1), np.nan)\\n\",\n",
    "    \"    valid_v = ~np.isnan(mae_v)\\n\",\n",
